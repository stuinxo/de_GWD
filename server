if [[ -f "./resource/doh/doh_s_$architecture" ]]; then
    cp -f ./resource/doh/doh_s_$architecture /opt/de_GWD/doh-server && chmod +x /opt/de_GWD/doh-server
elif [[ -x "/opt/de_GWD/doh-server" && -n "$sha256sum_don_server" && $(checkSum /opt/de_GWD/doh-server "$sha256sum_don_server") == "true" ]]; then
    :
elif [[ -n "$sha256sum_don_server" ]] && downloadVerifiedResource /opt/de_GWD/doh-server "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/resource/doh/doh_s_$architecture" "$sha256sum_don_server" 1000 elf; then
    chmod +x /opt/de_GWD/doh-server
else
    echo -e "${RED}doh-server Download or Checksum Failed${cRES}" && exit 1
fi

if [[ -f "./resource/nginx/nginx_$architecture" ]]; then
    cp -f ./resource/nginx/nginx_$architecture /usr/sbin/nginx && chmod +x /usr/sbin/nginx
elif [[ -x "/usr/sbin/nginx" && -n "$sha256sum_nginx" && $(checkSum /usr/sbin/nginx "$sha256sum_nginx") == "true" ]]; then
    :
elif [[ -n "$sha256sum_nginx" ]] && downloadVerifiedResource /usr/sbin/nginx "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/resource/nginx/nginx_$architecture" "$sha256sum_nginx" 10000 elf; then
    chmod +x /usr/sbin/nginx
else
    echo -e "${RED}NGINX Core Download or Checksum Failed${cRES}" && exit 1
fi

if [[ -f "./de_GWD_$architecture.zip" ]]; then
    cp -f ./de_GWD_$architecture.zip /opt/de_GWD/.repo/de_GWD.zip
elif [[ -f "./resource/de_GWD_$architecture.zip" ]]; then
    cp -f ./resource/de_GWD_$architecture.zip /opt/de_GWD/.repo/de_GWD.zip
elif [[ -f "/opt/de_GWD/.repo/de_GWD.zip" && -n "$sha256sum_de_GWD" && $(checkSum /opt/de_GWD/.repo/de_GWD.zip "$sha256sum_de_GWD") == "true" ]]; then
    :
elif [[ -n "$sha256sum_de_GWD" ]] && downloadVerifiedResource /opt/de_GWD/.repo/de_GWD.zip "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/de_GWD_${architecture}.zip" "$sha256sum_de_GWD" 10000 zip; then
    :
else
    echo -e "${RED}de_GWD Download or Checksum Failed${cRES}" && exit 1
fi

if [[ -f "./resource/nginx/nginxConf.zip" ]]; then
    cp -f ./resource/nginx/nginxConf.zip /opt/de_GWD/.repo/nginxConf.zip
elif [[ -f "/opt/de_GWD/.repo/nginxConf.zip" && -n "$sha256sum_nginxConf" && $(checkSum /opt/de_GWD/.repo/nginxConf.zip "$sha256sum_nginxConf") == "true" ]]; then
    :
elif [[ -n "$sha256sum_nginxConf" ]] && downloadVerifiedResource /opt/de_GWD/.repo/nginxConf.zip "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/resource/nginx/nginxConf.zip" "$sha256sum_nginxConf" 5 zip; then
    :
else
    echo -e "${RED}nginxConf Download or Checksum Failed${cRES}" && exit 1
fi

if [[ -f "./resource/server/sample.zip" ]]; then
    cp -f ./resource/server/sample.zip /opt/de_GWD/.repo/sample.zip
elif [[ -f "/opt/de_GWD/.repo/sample.zip" && -n "$sha256sum_sample" && $(checkSum /opt/de_GWD/.repo/sample.zip "$sha256sum_sample") == "true" ]]; then
    :
elif [[ -n "$sha256sum_sample" ]] && downloadVerifiedResource /opt/de_GWD/.repo/sample.zip "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/resource/server/sample.zip" "$sha256sum_sample" 100 zip; then
    :
else
    echo -e "${RED}sample Download or Checksum Failed${cRES}" && exit 1
fi

localVer=$(awk 'NR==1' /opt/de_GWD/version.php 2>/dev/null)
if [[ -f "./version.php" ]]; then
  cp -f ./version.php /opt/de_GWD/version.php
else
  remoteVer=$(curl -fsSLo- "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/version.php" 2>/dev/null | head -n 1)
  if [[ -n "$remoteVer" ]] && [[ $localVer != $remoteVer ]]; then
    tmpVer=$(mktemp /tmp/de_GWD-ver.XXXXXX)
    if [[ -n "$tmpVer" ]] && curl -fsSL --connect-timeout 5 -m 15 -o "$tmpVer" "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/version.php" 2>/dev/null && [[ -s "$tmpVer" ]]; then
      mv -f "$tmpVer" /opt/de_GWD/version.php
    else
      rm -f "$tmpVer"
      echo -e "${WHITE}Version File${RED} Download Failed${cRES}" && exit 1
    fi
  fi
fi

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Repository${cRES}"
}



