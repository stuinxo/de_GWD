#!/bin/bash
if [[ $EUID -ne 0 ]]; then
  if [[ -f "$0" ]]; then
    if command -v sudo >/dev/null 2>&1; then
      exec sudo bash "$0" "$@"
    else
      echo -e "\033[1;31mPlease run as root!\033[0m" >&2
      exit 1
    fi
  else
    echo -e "\033[1;31mPlease run as root or with sudo!\033[0m" >&2
    exit 1
  fi
fi
clear 2>/dev/null || true
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
