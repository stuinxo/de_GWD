socks5Trim(){
  local s="${1:-}"
  s="${s#"${s%%[![:space:]]*}"}"
  s="${s%"${s##*[![:space:]]}"}"
  printf '%s' "$s"
}



socks5WriteFile(){
  local src="$1"
  local dest="$2"
  local mode="$3"
  mkdir -p "$(dirname "$dest")"
  if [[ -L "$dest" ]]; then
    cat "$src" > "$dest" || return 1
    rm -f "$src"
  else
    mv -f "$src" "$dest" || return 1
  fi
  if [[ $mode == "640-www" ]]; then
    if chgrp www-data "$dest" 2>/dev/null; then
      chmod 640 "$dest" || return 1
    else
      chmod 644 "$dest" || return 1
    fi
  else
    chmod "$mode" "$dest" || return 1
  fi
}



socks5UrlDecode(){
  local LC_ALL=C s="${1:-}" out="" i=0 len ch hex
  len=${#s}
  while (( i < len )); do
    if [[ ${s:i:1} == "%" && $((i + 2)) -lt $len && ${s:i+1:2} =~ ^[0-9A-Fa-f]{2}$ ]]; then
      hex="${s:i+1:2}"
      [[ $hex == "00" ]] && return 1
      printf -v ch "\\x${hex}"
      out+="$ch"
      i=$((i + 3))
    else
      out+="${s:i:1}"
      i=$((i + 1))
    fi
  done
  printf '%s' "$out"
}



socks5OutboundIsValidIpv4(){
  local ip="${1:-}" o1 o2 o3 o4
  [[ $ip =~ ^[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}\.[0-9]{1,3}$ ]] || return 1
  IFS='.' read -r o1 o2 o3 o4 <<< "$ip"
  (( 10#$o1 <= 255 && 10#$o2 <= 255 && 10#$o3 <= 255 && 10#$o4 <= 255 ))
}



socks5OutboundIsValidIpv6(){
  local ip="${1:-}" rest seg colonCount=0 maxSeg=8 hasDouble=0
  [[ -n $ip && $ip == *:* ]] || return 1
  [[ $ip != *:::* ]] || return 1
  [[ $ip =~ ^[0-9A-Fa-f:.]+$ ]] || return 1
  if [[ $ip =~ ^:[^:] || $ip =~ [^:]:$ ]]; then
    return 1
  fi
  [[ $ip == *"::"* ]] && hasDouble=1
  rest="${ip#*::}"
  if (( hasDouble == 1 )) && [[ $rest == *"::"* ]]; then
    return 1
  fi
  if [[ $ip == *.* ]]; then
    local last="${ip##*:}"
    socks5OutboundIsValidIpv4 "$last" || return 1
    ip="${ip%:*}"
    maxSeg=6
  fi
  local IFS=':'
  local parts=()
  read -r -a parts <<< "${ip} "
  local lastIdx=$(( ${#parts[@]} - 1 ))
  parts[$lastIdx]="${parts[$lastIdx]% }"
  for seg in "${parts[@]}"; do
    if [[ -n $seg ]]; then
      [[ $seg =~ ^[0-9A-Fa-f]{1,4}$ ]] || return 1
      colonCount=$((colonCount + 1))
    fi
  done
  if (( hasDouble == 1 )); then
    (( colonCount < maxSeg )) || return 1
  else
    (( colonCount == maxSeg )) || return 1
  fi
  return 0
}



socks5OutboundIsValidAddress(){
  local addr="${1:-}"
  [[ -n $addr && $addr != *[[:space:]]* ]] || return 1
  if [[ $addr =~ ^[0-9]+(\.[0-9]+)*$ ]]; then
    socks5OutboundIsValidIpv4 "$addr"
    return $?
  elif [[ $addr == *:* ]]; then
    socks5OutboundIsValidIpv6 "$addr"
    return $?
  else
    [[ $addr =~ ^[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?(\.[A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?)*$ ]]
    return $?
  fi
}



socks5OutboundIsValidIpRule(){
  local rule="${1:-}" addr prefix
  [[ -n $rule && $rule != *[[:space:]]* ]] || return 1
  if [[ $rule =~ ^geoip:!?[A-Za-z0-9_-]+$ ]]; then
    return 0
  elif [[ $rule =~ ^ext:[A-Za-z0-9._-]+:[A-Za-z0-9!_-]+$ ]]; then
    return 0
  elif [[ $rule == *"/"* ]]; then
    addr="${rule%/*}"
    prefix="${rule#*/}"
    [[ $prefix =~ ^(0|[1-9][0-9]{0,2})$ ]] || return 1
    if socks5OutboundIsValidIpv4 "$addr"; then
      (( 10#$prefix <= 32 ))
      return $?
    elif socks5OutboundIsValidIpv6 "$addr"; then
      (( 10#$prefix <= 128 ))
      return $?
    fi
    return 1
  else
    socks5OutboundIsValidIpv4 "$rule" && return 0
    socks5OutboundIsValidIpv6 "$rule" && return 0
    return 1
  fi
}



socks5OutboundParseEndpoint(){
  local raw kind="" address="" port="" username="" password="" hasAuth=false
  raw=$(socks5Trim "${1:-}")
  [[ -n $raw ]] || return 1

  if [[ $raw == *"://"* ]]; then
    local scheme lowerScheme rest userinfo="" hostport="" tail="" decodedInfo="" b64Decoded=""
    scheme="${raw%%://*}"
    lowerScheme=$(printf '%s' "$scheme" | tr 'A-Z' 'a-z')
    [[ $lowerScheme == "socks5" || $lowerScheme == "socks5h" || $lowerScheme == "socks" ]] || return 1
    rest="${raw#*://}"
    rest="${rest%%#*}"
    rest="${rest%%\?*}"
    rest="${rest%%/*}"
    [[ -n $rest ]] || return 1

    if [[ $rest == *"@"* ]]; then
      userinfo="${rest%@*}"
      hostport="${rest##*@}"
    else
      hostport="$rest"
    fi

    if [[ -n $userinfo ]]; then
      if [[ $userinfo == *:* ]]; then
        [[ ${userinfo%%:*} =~ %0[0-9A-Fa-f]|%1[0-9A-Fa-f]|%7[Ff] ]] && return 1
        [[ ${userinfo#*:} =~ %0[0-9A-Fa-f]|%1[0-9A-Fa-f]|%7[Ff] ]] && return 1
        username=$(socks5UrlDecode "${userinfo%%:*}") || return 1
        password=$(socks5UrlDecode "${userinfo#*:}") || return 1
        hasAuth=true
      else
        [[ $userinfo =~ %0[0-9A-Fa-f]|%1[0-9A-Fa-f]|%7[Ff] ]] && return 1
        decodedInfo=$(socks5UrlDecode "$userinfo") || return 1
        if [[ $decodedInfo == *:* ]]; then
          username="${decodedInfo%%:*}"
          password="${decodedInfo#*:}"
          hasAuth=true
        else
          b64Decoded=$(jq -rn --arg u "$decodedInfo" 'try ($u | gsub("-"; "+") | gsub("_"; "/") | . + ("===="[0:(4 - (length % 4)) % 4]) | @base64d) catch empty' 2>/dev/null || true)
          if [[ -n $b64Decoded && $b64Decoded == *:* ]]; then
            username="${b64Decoded%%:*}"
            password="${b64Decoded#*:}"
            hasAuth=true
          else
            return 1
          fi
        fi
      fi
      [[ -n $username && -n $password ]] || return 1
    fi

    if [[ $hostport =~ ^\[([^\]]+)\](.*)$ ]]; then
      address="${BASH_REMATCH[1]}"
      tail="${BASH_REMATCH[2]}"
      if [[ -z $tail ]]; then
        port=""
      elif [[ $tail =~ ^:([0-9]+)$ ]]; then
        port="${BASH_REMATCH[1]}"
      else
        return 1
      fi
    elif [[ $hostport == *:*:* ]]; then
      return 1
    elif [[ $hostport =~ ^([^:]+):([0-9]+)$ ]]; then
      address="${BASH_REMATCH[1]}"
      port="${BASH_REMATCH[2]}"
    elif [[ $hostport != *:* ]]; then
      address="$hostport"
      port=""
    else
      return 1
    fi

    address=$(socks5UrlDecode "$address") || return 1
    kind="uri"
  else
    local tail=""
    if [[ $raw =~ ^\[([^\]]+)\](.*)$ ]]; then
      address="${BASH_REMATCH[1]}"
      tail="${BASH_REMATCH[2]}"
      if [[ -z $tail ]]; then
        kind="host"
        port=""
      elif [[ $tail =~ ^:([0-9]+)$ ]]; then
        kind="hostport"
        port="${BASH_REMATCH[1]}"
      elif [[ $tail =~ ^:([0-9]+):([^:]+):(.*)$ ]]; then
        kind="tuple4"
        port="${BASH_REMATCH[1]}"
        username="${BASH_REMATCH[2]}"
        password="${BASH_REMATCH[3]}"
        hasAuth=true
      else
        return 1
      fi
    elif [[ $raw == *:*:* ]] && [[ $raw =~ ^[0-9A-Fa-f:]+$ || $raw =~ ^[0-9A-Fa-f:]+:[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]]; then
      kind="host"
      address="$raw"
      port=""
    elif [[ $raw =~ ^([^:]+):([0-9]+):([^:]+):(.*)$ ]]; then
      kind="tuple4"
      address="${BASH_REMATCH[1]}"
      port="${BASH_REMATCH[2]}"
      username="${BASH_REMATCH[3]}"
      password="${BASH_REMATCH[4]}"
      hasAuth=true
    elif [[ $raw =~ ^([^:]+):([0-9]+)$ ]]; then
      kind="hostport"
      address="${BASH_REMATCH[1]}"
      port="${BASH_REMATCH[2]}"
    elif [[ $raw != *:* ]]; then
      kind="host"
      address="$raw"
      port=""
    else
      return 1
    fi
  fi

  socks5OutboundIsValidAddress "$address" || return 1
  if [[ -n $port ]]; then
    [[ $port =~ ^[1-9][0-9]{0,4}$ ]] && (( 10#$port <= 65535 )) || return 1
  fi
  if [[ $hasAuth == true ]]; then
    [[ -n $username && -n $password ]] || return 1
  fi

  jq -cn \
    --arg kind "$kind" \
    --arg address "$address" \
    --arg port "$port" \
    --arg username "$username" \
    --arg password "$password" \
    --argjson hasAuth "$hasAuth" \
    '{kind:$kind,address:$address,port:$port,username:$username,password:$password,hasAuth:$hasAuth}'
}



socks5OutboundExpandRules(){
  local kind="$1"
  local input="${2:-}"
  local rawTokens=()
  local token lowerToken expanded=()
  local IFS=','
  read -r -a rawTokens <<< "$input"
  for token in "${rawTokens[@]}"; do
    token=$(socks5Trim "$token")
    [[ -n $token ]] || continue
    if [[ ${token:0:1} == "@" ]]; then
      lowerToken=$(printf '%s' "$token" | tr 'A-Z' 'a-z')
      if [[ $kind == "domain" ]]; then
        case "$lowerToken" in
          @ai)
            expanded+=( "geosite:openai" "geosite:anthropic" "domain:claude.ai" "domain:chatgpt.com" "domain:gemini.google.com" "domain:perplexity.ai" "domain:x.ai" "domain:grok.com" )
            ;;
          @stream)
            expanded+=( "geosite:netflix" "geosite:disney" "geosite:youtube" "geosite:spotify" "geosite:tiktok" "geosite:hulu" )
            ;;
          @tg)
            expanded+=( "geosite:telegram" )
            ;;
          *)
            echo -e "${WHITE}SOCKS5 outbound${RED} unknown domain preset: $token (supported: @ai, @stream, @tg)${cRES}" >&2
            return 1
            ;;
        esac
      else
        case "$lowerToken" in
          @tg)
            expanded+=( "geoip:telegram" )
            ;;
          *)
            echo -e "${WHITE}SOCKS5 outbound${RED} unknown IP preset: $token (supported: @tg)${cRES}" >&2
            return 1
            ;;
        esac
      fi
    else
      expanded+=( "$token" )
    fi
  done

  if (( ${#expanded[@]} == 0 )); then
    printf '%s\n' '[]'
    return 0
  fi

  printf '%s\n' "${expanded[@]}" | jq -R 'select(length > 0)' | jq -s 'reduce .[] as $item ([]; if index($item) == null then . + [$item] else . end)'
}



socks5OutboundSettingsOrDefault(){
if [[ -s $socks5OutboundSettings ]]; then
