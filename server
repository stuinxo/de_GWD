RproxySensureSettings(){
local settings=/opt/de_GWD/RproxyS/settings.json
if [[ -f $settings ]]; then
  jq -e '(.port | type == "number") and (.uuid | type == "string") and (.clients | type == "array") and (.mapping | type == "array")' "$settings" >/dev/null 2>&1 || {
    echo -e "${RED}Invalid RproxyS settings${cRES}"
    return 1
  }
  return 0
fi

local RproxyStunnelPort RproxyStunnelUUID RproxySClients
echo -e "${GREEN}============================ ${cRES}"
echo -e "${GREEN}RproxyS base settings${cRES}"
echo -e "${GREEN}============================ ${cRES}"
read -r -p "RproxyS listen port [20000]: " RproxyStunnelPort
RproxyStunnelPort=${RproxyStunnelPort:-20000}
[[ $RproxyStunnelPort =~ ^[1-9][0-9]{0,4}$ ]] && (( RproxyStunnelPort <= 65535 )) || { echo -e "${RED}Invalid port${cRES}"; return 1; }
read -r -p "RproxyS UUID [auto]: " RproxyStunnelUUID
RproxyStunnelUUID=${RproxyStunnelUUID:-$(cat /proc/sys/kernel/random/uuid 2>/dev/null || /opt/de_GWD/vtrui/vtrui uuid 2>/dev/null)}
[[ $RproxyStunnelUUID =~ ^[0-9a-fA-F-]{36}$ ]] || { echo -e "${RED}Invalid UUID${cRES}"; return 1; }
read -r -p "Extra client UUIDs, comma separated [none]: " RproxySClients

local temp=/tmp/RproxyS.settings.$$
jq -n --argjson port "$RproxyStunnelPort" --arg uuid "$RproxyStunnelUUID" \
  '{port:$port,uuid:$uuid,clients:[],mapping:[]}' >"$temp" || { rm -f "$temp"; return 1; }
local clientUUID
IFS=',' read -r -a clientUUIDs <<< "$RproxySClients"
for clientUUID in "${clientUUIDs[@]}"; do
  clientUUID=${clientUUID//[[:space:]]/}
  [[ -z $clientUUID ]] && continue
  [[ $clientUUID =~ ^[0-9a-fA-F-]{36}$ ]] || { rm -f "$temp"; echo -e "${RED}Invalid client UUID${cRES}"; return 1; }
  jq --arg id "$clientUUID" '.clients += [$id]' "$temp" | sponge "$temp"
done
mkdir -p /opt/de_GWD/RproxyS
mv -f "$temp" "$settings"
chmod 600 "$settings"
}


RproxySaddPort(){
local settings=/opt/de_GWD/RproxyS/settings.json
RproxySensureSettings || return 1
local listenPort=$(jq -r '.port' "$settings")
local mappingPort mappingProtocol
echo -e "${GREEN}1. Port${cRES}"
read -r -p "Mapping port: " mappingPort
mappingPort=${mappingPort//[[:space:]]/}
[[ $mappingPort =~ ^[1-9][0-9]{0,4}$ ]] && (( mappingPort <= 65535 )) || { echo -e "${RED}Invalid mapping port${cRES}"; return 1; }
[[ $mappingPort != "$listenPort" ]] || { echo -e "${RED}Mapping port conflicts with RproxyS listen port${cRES}"; return 1; }
if jq -e --argjson port "$mappingPort" 'any(.mapping[]?; .port == $port)' "$settings" >/dev/null 2>&1; then
  echo -e "${YELLOW}Mapping port already exists${cRES}"
  return 1
fi
echo -e "${GREEN}2. Protocol (default tcp+udp)${cRES}"
read -r -p "Mapping protocol (tcp/udp/tcp+udp) [tcp+udp]: " mappingProtocol
mappingProtocol=${mappingProtocol:-tcp+udp}
mappingProtocol=${mappingProtocol//+/,}
[[ $mappingProtocol = "tcp" || $mappingProtocol = "udp" || $mappingProtocol = "tcp,udp" ]] || { echo -e "${RED}Invalid mapping protocol${cRES}"; return 1; }

local temp=/tmp/RproxyS.settings.$$.add
jq --argjson port "$mappingPort" --arg protocol "$mappingProtocol" \
  '.mapping += [{port:$port,protocol:$protocol}]' "$settings" >"$temp" || { rm -f "$temp"; return 1; }
mv -f "$temp" "$settings"
chmod 600 "$settings"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Mapping ${GREEN}Added${cRES}; use 1 to apply"
}


RproxySdeletePort(){
local settings=/opt/de_GWD/RproxyS/settings.json
[[ -f $settings ]] || { echo -e "${YELLOW}RproxyS is not configured${cRES}"; return 1; }
local len=$(jq -r '.mapping | length' "$settings" 2>/dev/null)
(( len > 0 )) || { echo -e "${YELLOW}No mapping ports${cRES}"; return 0; }
echo -e "${GREEN}Current mapping ports${cRES}"
jq -r '.mapping[] | "\(.port)/\(.protocol)"' "$settings"
local mappingPort
read -r -p "Delete mapping port: " mappingPort
mappingPort=${mappingPort//[[:space:]]/}
[[ $mappingPort =~ ^[1-9][0-9]{0,4}$ ]] || { echo -e "${RED}Invalid mapping port${cRES}"; return 1; }
if ! jq -e --argjson port "$mappingPort" 'any(.mapping[]?; .port == $port)' "$settings" >/dev/null 2>&1; then
  echo -e "${YELLOW}Mapping port does not exist${cRES}"
  return 1
fi
local temp=/tmp/RproxyS.settings.$$.delete
jq --argjson port "$mappingPort" '.mapping |= map(select(.port != $port))' "$settings" >"$temp" || { rm -f "$temp"; return 1; }
mv -f "$temp" "$settings"
chmod 600 "$settings"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Mapping ${GREEN}Deleted${cRES}; use 1 to apply"
}


