parseDomainAndPort() {
    local in_tag="$1"
    local rec_port="$2"
    local cur_port="$3"
    local allow_443="$4"

    local default_domain=$(awk '/server_name/ {print$2;exit}' /etc/nginx/conf.d/default.conf 2>/dev/null | sed 's/.$//')
    [[ -z "$default_domain" ]] && default_domain=$(curl -4 -s --connect-timeout 3 ip.sb 2>/dev/null || hostname -I | awk '{print $1}')

    local saved_domain=""
    if [[ -f /opt/de_GWD/extra_domains.json ]]; then
        saved_domain=$(jq -r --arg tag "$in_tag" '.[$tag]' /opt/de_GWD/extra_domains.json 2>/dev/null | grep -v '^null$')
    fi
    local use_domain="${saved_domain:-$default_domain}"

    target_domain=""
    target_port=""

    while true; do
        echo
        if [[ "$allow_443" == "true" ]]; then
            echo -e "${CYAN}Tip: You can enter [Domain:Port] (e.g. sub.domain.com:443 or sub.domain.com:$rec_port) or just [Port].${cRES}"
            read -r -p "Enter Domain:Port [Default: ${use_domain}:${rec_port}] (Port 443 supported with subdomains): " user_input
        else
            echo -e "${CYAN}Tip: You can enter [Domain:Port] (e.g. sub.domain.com:$rec_port) or just [Port].${cRES}"
            read -r -p "Enter Domain:Port [Default: ${use_domain}:${rec_port}] (443 reserved): " user_input
        fi
        user_input=$(echo "$user_input" | tr -d ' ')

        local parsed_d=""
        local parsed_p=""

        if [[ -z "$user_input" ]]; then
            parsed_d="$use_domain"
            parsed_p="$rec_port"
        elif [[ "$user_input" == *":"* ]]; then
            parsed_d="${user_input%%:*}"
            parsed_p="${user_input##*:}"
        else
            parsed_d="$use_domain"
            parsed_p="$user_input"
        fi

        local chk=$(checkPortAvailable "$parsed_p" "$cur_port" "$allow_443")
        if [[ "$chk" == "reserved_443" ]]; then
            echo -e "${RED}Port 443 is reserved for reverse proxy/web services! Please choose another port.${cRES}"
        elif [[ "$chk" == "invalid" ]]; then
            echo -e "${RED}Invalid port number: '$parsed_p'. Must be between 1 and 65535.${cRES}"
        elif [[ "$chk" == "in_use" ]]; then
            echo -e "${RED}Port $parsed_p is already in use by another process. Please choose another port.${cRES}"
        elif [[ -z "$parsed_d" ]]; then
            echo -e "${RED}Domain cannot be empty.${cRES}"
        else
            target_domain="$parsed_d"
            target_port="$parsed_p"
            break
        fi
    done

    mkdir -p /opt/de_GWD
    [[ ! -f /opt/de_GWD/extra_domains.json ]] && echo '{}' > /opt/de_GWD/extra_domains.json
    jq --arg tag "$in_tag" --arg dom "$target_domain" '.[$tag] = $dom' /opt/de_GWD/extra_domains.json | sponge /opt/de_GWD/extra_domains.json
    chmod 666 /opt/de_GWD/extra_domains.json 2>/dev/null || true
}

removeXrayInbound() {
    local tag="$1"
    cp -f /opt/de_GWD/vtrui/config.json /opt/de_GWD/vtrui/config.json.bak 2>/dev/null || true
    jq --arg tag "$tag" 'del(.inbounds[] | select(.tag == $tag))' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json
    if [[ "$tag" == "inbound-vless-reality" ]]; then
        rm -f /opt/de_GWD/vtrui/reality.info
    fi
    if [[ -f /opt/de_GWD/extra_domains.json ]]; then
        jq --arg tag "$tag" 'del(.[$tag])' /opt/de_GWD/extra_domains.json | sponge /opt/de_GWD/extra_domains.json 2>/dev/null || true
    fi
    if [[ -f /opt/de_GWD/extra_ports.json ]]; then
        jq --arg tag "$tag" 'del(.[$tag])' /opt/de_GWD/extra_ports.json | sponge /opt/de_GWD/extra_ports.json 2>/dev/null || true
    fi
    removeNginxWebProxy "$tag"
    if /opt/de_GWD/vtrui/vtrui run -test -c /opt/de_GWD/vtrui/config.json >/dev/null 2>&1; then
        systemctl restart vtrui
        rm -f /opt/de_GWD/vtrui/config.json.bak
        return 0
    else
        mv -f /opt/de_GWD/vtrui/config.json.bak /opt/de_GWD/vtrui/config.json 2>/dev/null || true
        systemctl restart vtrui
        return 1
    fi
}

applyXrayInbound() {
    local newInboundJson="$1"
    local tag="$2"
    cp -f /opt/de_GWD/vtrui/config.json /opt/de_GWD/vtrui/config.json.bak 2>/dev/null || true
    jq --arg tag "$tag" 'del(.inbounds[] | select(.tag == $tag))' /opt/de_GWD/vtrui/config.json |\
    jq --argjson n "$newInboundJson" '.inbounds += [$n]' | sponge /opt/de_GWD/vtrui/config.json

    if /opt/de_GWD/vtrui/vtrui run -test -c /opt/de_GWD/vtrui/config.json >/tmp/vtrui_test.log 2>&1; then
