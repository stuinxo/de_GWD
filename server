  local menuChoice
  read -r menuChoice
  echo
  case "$menuChoice" in
    1) RproxySaction ;;
    2) RproxySaddPort ;;
    3) RproxySdeletePort ;;
    4) RproxySsetBase ;;
    9) RproxySstatus ;;
