RproxySsave(){
local settings=/opt/de_GWD/RproxyS/settings.json
local RproxyStunnelPort=$(jq -r '.port // empty' "$settings" 2>/dev/null)
local RproxyStunnelUUID=$(jq -r '.uuid // empty' "$settings" 2>/dev/null)
local RproxySinUUID=$(jq -r '.clients[]? // empty' "$settings" 2>/dev/null)
local RproxySmappingList=$(jq -c '.mapping // []' "$settings" 2>/dev/null)

[[ ! -x /opt/de_GWD/vtrui/vtrui ]] && return 1
[[ $RproxyStunnelPort =~ ^[1-9][0-9]{0,4}$ ]] && (( RproxyStunnelPort <= 65535 )) || return 1
[[ $RproxyStunnelUUID =~ ^[0-9a-fA-F-]{36}$ ]] || return 1

for uuid in $RproxySinUUID; do
  [[ $uuid =~ ^[0-9a-fA-F-]{36}$ ]] || return 1
done
local len=$(echo "$RproxySmappingList" | jq length)
for (( i=0; i<len; i++ )); do
  local port=$(echo "$RproxySmappingList" | jq -r --argjson i "$i" '.[$i].port')
  local protocol=$(echo "$RproxySmappingList" | jq -r --argjson i "$i" '.[$i].protocol')
  [[ $port =~ ^[1-9][0-9]{0,4}$ ]] && (( port <= 65535 )) || return 1
  [[ $protocol = "tcp" || $protocol = "udp" || $protocol = "tcp,udp" ]] || return 1
done

mkdir -p /opt/de_GWD/RproxyS
rm -f /opt/de_GWD/RproxyS/RproxyS /opt/de_GWD/RproxyS/config.json
cp -f /opt/de_GWD/vtrui/vtrui /opt/de_GWD/RproxyS/RproxyS
chmod +x /opt/de_GWD/RproxyS/RproxyS

cat << EOF >/opt/de_GWD/RproxyS/config.json
{
  "log": {"access":"none","error":"none","loglevel":"none"},
  "dns": {"queryStrategy":"UseIP","disableCache":true,"servers":["tcp+local://127.0.0.1:53"]},
  "inbounds": [{
    "tag":"reverseTunnel",
    "listen":"0.0.0.0",
    "port":$RproxyStunnelPort,
    "protocol":"vless",
    "settings":{
      "decryption":"none",
      "clients":[
        {
          "id":"$RproxyStunnelUUID",
          "reverse":{"tag":"portal"}
        }
      ]
    },
    "streamSettings":{
      "network":"tcp",
      "security":"tls",
      "tlsSettings":{
        "certificates":[
          {
            "certificateFile":"/var/www/ssl/de_GWD.cer",
            "keyFile":"/var/www/ssl/de_GWD.key"
          }
        ]
      }
    }
  }],
  "outbounds": [
    {
      "tag": "direct",
      "protocol": "freedom"
    }
  ],
  "routing": {"rules":[]}
}
EOF

for uuid in $RproxySinUUID; do
  jq --arg id "$uuid" '.inbounds[0].settings.clients += [{"id":$id,"reverse":{"tag":"portal"}}]' /opt/de_GWD/RproxyS/config.json | sponge /opt/de_GWD/RproxyS/config.json
done

for (( i=0; i<len; i++ )); do
  local port=$(echo "$RproxySmappingList" | jq -r --argjson i "$i" '.[$i].port')
  local protocol=$(echo "$RproxySmappingList" | jq -r --argjson i "$i" '.[$i].protocol')
  jq --argjson port "$port" --arg protocol "$protocol" --arg tag "mapping$i" \
    '.routing.rules += [{"type":"field","inboundTag":[$tag],"outboundTag":"portal"}] | .inbounds += [{"tag":$tag,"listen":"0.0.0.0","port":$port,"protocol":"dokodemo-door","settings":{"address":"127.0.0.1","port":$port,"network":$protocol}}]' \
    /opt/de_GWD/RproxyS/config.json | sponge /opt/de_GWD/RproxyS/config.json
done

/opt/de_GWD/RproxyS/RproxyS run -test -c /opt/de_GWD/RproxyS/config.json >/dev/null 2>&1 || return 1
chmod 600 /opt/de_GWD/RproxyS/config.json
rm -rf /lib/systemd/system/RproxyS.service /etc/systemd/system/RproxyS.service
cat << "EOF" >/etc/systemd/system/RproxyS.service
[Unit]
Description=Rproxy Service
After=network.target nss-lookup.target

[Service]
User=root
Type=simple
ExecStart=/opt/de_GWD/RproxyS/RproxyS run -c /opt/de_GWD/RproxyS/config.json
Restart=always
RestartSec=2
TimeoutStopSec=5

LimitNOFILE=10000000
LimitNPROC=10000000
LimitCORE=10000000

AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload >/dev/null
systemctl enable RproxyS >/dev/null 2>&1
systemctl restart RproxyS

if systemctl is-active --quiet nftables; then
  nft add rule inet filter INPUT tcp dport $RproxyStunnelPort accept 2>/dev/null || true
  for (( i=0; i<len; i++ )); do
    local port=$(echo "$RproxySmappingList" | jq -r --argjson i "$i" '.[$i].port')
    local protocol=$(echo "$RproxySmappingList" | jq -r --argjson i "$i" '.[$i].protocol')
    if [[ "$protocol" == "tcp" ]]; then
      nft add rule inet filter INPUT tcp dport $port accept 2>/dev/null || true
    elif [[ "$protocol" == "udp" ]]; then
      nft add rule inet filter INPUT udp dport $port accept 2>/dev/null || true
    else
      nft add rule inet filter INPUT meta l4proto { tcp, udp } th dport $port accept 2>/dev/null || true
    fi
  done
fi

systemctl is-active --quiet RproxyS || return 1
}


