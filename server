    sed -i "/# BEGIN_RULE_${localP}/,/# END_RULE_${localP}/d" /etc/haproxy/haproxy.cfg

    # Append new rule
    cat << EOF >>/etc/haproxy/haproxy.cfg
# BEGIN_RULE_${localP}
frontend ft_${localP}
  bind                  :${localP}
  default_backend       bk_${localP}

backend bk_${localP}
  server endpoint ${upDomainP} check resolvers local init-addr last,libc,none
