    else
        echo -e "${RED}Download Failed${cRES}" && exit 1
    fi
fi

if [[ -f "./resource/nginx/nginx_$architecture" ]]; then
    cp -f ./resource/nginx/nginx_$architecture /usr/sbin/nginx && chmod +x /usr/sbin/nginx
elif [[ -z "$sha256sum_nginx" ]] || [[ $(checkSum /usr/sbin/nginx $sha256sum_nginx) = "false" ]]; then
    rm -rf /tmp/nginx
