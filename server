socks5OutboundToggle(){
local profiles count act index name curState newStateLabel candidate baseProfiles
[[ -s $socks5OutboundSettings ]] || {
  echo -e "${WHITE}SOCKS5 outbound${YELLOW} No profiles configured${cRES}"
  return 0
}
socks5OutboundValidate "$socks5OutboundSettings" || return 1
profiles=$(socks5OutboundProfiles "$socks5OutboundSettings") || return 1
count=$(jq -r 'length' <<< "$profiles")
(( count > 0 )) || {
  echo -e "${WHITE}SOCKS5 outbound${YELLOW} No profiles configured${cRES}"
  return 0
}

while IFS=$'\t' read -r index name curState; do
  if [[ $curState == "true" ]]; then
    echo -e "${GREEN}$((index + 1)). $name${cRES} [${GREEN}enabled${cRES}]"
  else
    echo -e "${GREEN}$((index + 1)). $name${cRES} [${YELLOW}disabled${cRES}]"
  fi
done < <(jq -r 'to_entries[] | [.key, .value.profile.name, (.value.profile.enabled // false)] | @tsv' <<< "$profiles")

read -r -p "Profile number to toggle ([e]nable all, [d]isable all, [0] cancel): " act
act=$(socks5Trim "$act")
[[ -z $act || $act == "0" ]] && return 0

baseProfiles=$(jq -c '[.[].profile]' <<< "$profiles") || return 1
candidate=$(mktemp /tmp/de_GWD-socks5-outbound.XXXXXX) || return 1

case "$act" in
  e|E)
    jq -n --argjson profiles "$baseProfiles" '{profiles: ($profiles | map(.enabled = true))}' > "$candidate" || { rm -f "$candidate"; return 1; }
    newStateLabel="${GREEN}all enabled${cRES}"
    ;;
  d|D)
    jq -n --argjson profiles "$baseProfiles" '{profiles: ($profiles | map(.enabled = false))}' > "$candidate" || { rm -f "$candidate"; return 1; }
    newStateLabel="${RED}all disabled${cRES}"
    ;;
  *)
    [[ $act =~ ^[1-9][0-9]*$ ]] || { rm -f "$candidate"; echo -e "${RED}Invalid selection${cRES}"; return 1; }
    index=$((10#$act - 1))
    (( index >= 0 && index < count )) || { rm -f "$candidate"; echo -e "${RED}Selection out of range${cRES}"; return 1; }
    name=$(jq -r --argjson i "$index" '.[$i].name' <<< "$baseProfiles")
    curState=$(jq -r --argjson i "$index" '.[$i].enabled // false' <<< "$baseProfiles")
    jq -n --argjson profiles "$baseProfiles" --argjson i "$index" '{profiles: ($profiles | .[$i].enabled = ((.[$i].enabled // false) | not))}' > "$candidate" || { rm -f "$candidate"; return 1; }
    if [[ $curState == "true" ]]; then
      newStateLabel="${YELLOW}$name disabled${cRES}"
    else
      newStateLabel="${GREEN}$name enabled${cRES}"
    fi
    ;;
esac

if ! socks5OutboundApply "$candidate"; then
  echo -e "${WHITE}SOCKS5 outbound${RED} update failed; previous configuration kept${cRES}"
  return 1
fi
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}] SOCKS5 outbound ${newStateLabel}"
}



