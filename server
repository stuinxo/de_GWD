#!/bin/bash
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
supportsSystem(){
  local osRelease=$1
  local architecture=$2
  [[ -r $osRelease ]] || return 1
  . "$osRelease"
  [[ ${ID:-} = "debian" && ( ${VERSION_ID:-} = "13" || ${VERSION_ID:-} = "12" ) ]] && [[ $architecture = "amd64" || $architecture = "arm64" ]]
}

if [[ $EUID -ne 0 ]]; then
  if [[ -f "$0" ]]; then
    if command -v sudo >/dev/null 2>&1; then
      exec sudo bash "$0" "$@"
    else
      echo -e "\033[1;31mPlease run as root!\033[0m" >&2
      exit 1
    fi
  else
    echo -e "\033[1;31mPlease run as root or with sudo!\033[0m" >&2
    exit 1
  fi
fi

if ! supportsSystem /etc/os-release "$(dpkg --print-architecture 2>/dev/null)"; then
  echo "Server requires Debian 12/13 (Bookworm/Trixie) on amd64 or arm64. No system changes were made." >&2
  exit 1
fi

clear 2>/dev/null || true
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'

chmod 1777 /tmp
architecture=$(dpkg --print-architecture)
virt=$(systemd-detect-virt 2>/dev/null || true)
[[ -z "$virt" ]] && virt="none"
systemd-detect-virt --container >/dev/null 2>&1 && virt_type="container" || virt_type=""
export DEBIAN_FRONTEND=noninteractive
branch="${BRANCH:-v2}"
socks5OutboundSettings="${SOCKS5_OUTBOUND_SETTINGS:-/opt/de_GWD/socks5-outbound.json}"
vtruiConfig="${VTRUI_CONFIG_PATH:-/opt/de_GWD/vtrui/config.json}"
vtruiDir="${VTRUI_DIR:-/opt/de_GWD/vtrui}"

[[ -f "/etc/nginx/conf.d/default.conf" ]] && sed -i 's/fastopen=128/fastopen=500/g' /etc/nginx/conf.d/default.conf



pkgDEP(){
echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Installing System Packages...${cRES}\r\c"
if command -v debconf-set-selections >/dev/null 2>&1; then
    echo "man-db man-db/auto-update boolean false" | debconf-set-selections 2>/dev/null || true
fi
wait_apt_lock
apt update -qq >/dev/null 2>&1 || true
pkg_status=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 2>/dev/null)
grep -qE '^(ii|rc) +ipset$' <<< "$pkg_status" && apt remove --purge -y ipset
grep -qE '^(ii|rc) +haveged$' <<< "$pkg_status" && apt remove --purge -y haveged
grep -qE '^(ii|rc) +subversion$' <<< "$pkg_status" && apt remove --purge -y subversion
grep -qE '^(ii|rc) +os-prober$' <<< "$pkg_status" && apt remove --purge -y os-prober
grep -qE '^(ii|rc) +systemd-timesyncd$' <<< "$pkg_status" && apt remove --purge -y systemd-timesyncd
grep -qE '^(ii|rc) +rng-tools(-debian)?$' <<< "$pkg_status" && apt remove --purge -y rng-tools-debian rng-tools 2>/dev/null

unset aptPKG
for pkg in sudo wget curl git locales psmisc idn2 dns-root-data netcat-openbsd dnsutils net-tools resolvconf nftables ca-certificates apt-transport-https gnupg2 unzip zstd jq bc moreutils chrony cron socat screen ethtool qrencode sqlite3 unbound libbrotli1 libcrypt1; do
  grep -qE "^ii +${pkg}$" <<< "$pkg_status" || aptPKG+=("$pkg")
done
if apt-cache show libmimalloc3 >/dev/null 2>&1; then
  grep -qE '^ii +libmimalloc3$' <<< "$pkg_status" || aptPKG+=(libmimalloc3)
elif apt-cache show libmimalloc2.0 >/dev/null 2>&1; then
  grep -qE '^ii +libmimalloc2\.0$' <<< "$pkg_status" || aptPKG+=(libmimalloc2.0)
fi
if [[ $architecture == "arm64" ]]; then
  if apt-cache show libgoogle-perftools4t64 >/dev/null 2>&1; then
    grep -qE '^ii +libgoogle-perftools4t64$' <<< "$pkg_status" || aptPKG+=(libgoogle-perftools4t64)
  elif apt-cache show libgoogle-perftools4 >/dev/null 2>&1; then
    grep -qE '^ii +libgoogle-perftools4$' <<< "$pkg_status" || aptPKG+=(libgoogle-perftools4)
  fi
fi
if ! grep -qE '^ii +irqbalance$' <<< "$pkg_status" && [[ $(nproc --all) -gt 1 ]]; then
  aptPKG+=(irqbalance)
fi
if [[ ${#aptPKG[@]} -gt 0 ]]; then
  wait_apt_lock
  if ! apt install -y -q "${aptPKG[@]}"; then
    echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}Failed to install required packages${cRES}" >&2
    exit 1
  fi
fi
for m3 in /usr/lib/*/libmimalloc.so.3 /usr/lib/libmimalloc.so.3; do
    if [[ -f "$m3" ]]; then
        m2="${m3%.3}.2"
        [[ ! -f "$m2" ]] && ln -sf "$m3" "$m2"
    fi
done
ldconfig 2>/dev/null || true
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}System Packages Ready${cRES}"
}



normalizeSha256(){
  local raw="${1:-}"
  raw=$(printf '%s\n' "$raw" | awk 'NR==1 {gsub(/\r/, ""); print tolower($1); exit}')
  if [[ "$raw" =~ ^[0-9a-f]{64}$ ]]; then
    printf '%s\n' "$raw"
    return 0
  fi
  return 1
}

checkSum(){
  local file="${1:-}"
  local expected
  expected=$(normalizeSha256 "${2:-}") || {
    echo "false"
    return 0
  }
  if [[ ! -f "$file" ]]; then
    echo "false"
    return 0
  fi
  local actual
  if command -v sha256sum >/dev/null 2>&1; then
    actual=$(sha256sum "$file" 2>/dev/null | awk '{print tolower($1); exit}')
  else
    actual=$(shasum -a 256 "$file" 2>/dev/null | awk '{print tolower($1); exit}')
  fi
  if [[ -n "$actual" && "$actual" == "$expected" ]]; then
    echo "true"
  else
    echo "false"
  fi
}

gh_text(){
  local url="$1"
  local jsd_url=""
  if [[ "$url" =~ ^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/(.*)$ ]]; then
    jsd_url="https://fastly.jsdelivr.net/gh/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}@${BASH_REMATCH[3]}/${BASH_REMATCH[4]}"
  fi
  local urls=("$url")
  [[ -n "$jsd_url" ]] && urls+=("$jsd_url")

  for u in "${urls[@]}"; do
    local content
    content=$(curl -4 -fsSL -H "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64)" --connect-timeout 5 --max-time 10 "$u" 2>/dev/null | awk 'NR==1 {gsub(/\r/, ""); print $1; exit}')
    if [[ -n "$content" ]]; then
      echo "$content"
      return 0
    fi
  done
  return 1
}

gh_download(){
  local target="$1"
  local url="$2"
  local min_kb="${3:-10}"
  local jsd_url=""
  if [[ "$url" =~ ^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/(.*)$ ]]; then
    jsd_url="https://fastly.jsdelivr.net/gh/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}@${BASH_REMATCH[3]}/${BASH_REMATCH[4]}"
  fi
  local urls=()
  urls+=("$url")
  if [[ "$target" != *"de_GWD"* && -n "$jsd_url" ]]; then
    urls+=("$jsd_url")
  fi
  urls+=("https://ghproxy.net/${url}" "https://mirror.ghproxy.com/${url}")

  for u in "${urls[@]}"; do
    rm -f "$target"
    wget -4 --header="User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64)" \
      --dns-timeout=5 --connect-timeout=5 --timeout=20 --tries=2 -qO "$target" "$u" 2>/dev/null
    if [[ ! -s "$target" ]] || [[ $(du -sk "$target" 2>/dev/null | awk '{print $1}') -lt "$min_kb" ]]; then
      curl -4 -fsSL -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" --connect-timeout 5 -m 30 -o "$target" "$u" 2>/dev/null
    fi
    if [[ -s "$target" ]]; then
      local sz=$(du -sk "$target" 2>/dev/null | awk '{print $1}')
      if [[ -n "$sz" && "$sz" -ge "$min_kb" ]]; then
        return 0
      fi
    fi
  done
  return 1
}

fetchChecksum(){
  local url="${1:-}"
  local raw
  raw=$(gh_text "$url" 2>/dev/null) || return 1
  normalizeSha256 "$raw"
}

isElfBinary(){
  local file="${1:-}"
  [[ -s "$file" ]] || return 1
  local magic
  magic=$(head -c 4 "$file" 2>/dev/null | od -An -tx1 | tr -d ' \n')
  [[ "$magic" == "7f454c46" ]]
}

downloadVerifiedResource(){
  local dest="$1"
  local url="$2"
  local expected_raw="$3"
  local min_kb="${4:-1}"
  local mode="${5:-raw}"

  local expected
  expected=$(normalizeSha256 "$expected_raw") || return 1

  local tmpDl
  tmpDl=$(mktemp /tmp/de_GWD-dl.XXXXXX) || return 1
  if ! gh_download "$tmpDl" "$url" "$min_kb"; then
    rm -f "$tmpDl"
    return 1
  fi
  if [[ $(checkSum "$tmpDl" "$expected") != "true" ]]; then
    rm -f "$tmpDl"
    return 1
  fi
  if [[ "$mode" == "zip" ]] && ! unzip -tq "$tmpDl" >/dev/null 2>&1; then
    rm -f "$tmpDl"
    return 1
  fi
  if [[ "$mode" == "elf" ]] && ! isElfBinary "$tmpDl"; then
    rm -f "$tmpDl"
    return 1
  fi
  mkdir -p "$(dirname "$dest")"
  mv -f "$tmpDl" "$dest"
}

wait_apt_lock(){
  local waited=0
  while (command -v fuser >/dev/null 2>&1 && fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock /var/cache/apt/archives/lock >/dev/null 2>&1) || pgrep -x 'apt|apt-get|dpkg' >/dev/null 2>&1; do
    if [[ $waited -ge 120 ]]; then
      echo "Timed out waiting for apt/dpkg lock" >&2
      return 1
    fi
    sleep 2
    waited=$((waited + 2))
  done
  dpkg --configure -a
}

detect_primary_nic(){
  local nic=""
  if command -v ip >/dev/null 2>&1; then
    nic=$(ip -4 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
    if [[ -z "$nic" ]]; then
      nic=$(ip -4 route show 2>/dev/null | awk '!/^default/ && !/dev (lo|docker|br-|veth|wg|ifb|tun|tap)/ {for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}')
    fi
  fi
  if [[ -z "$nic" ]] && [[ -d /sys/class/net ]]; then
    local iface
    for iface in /sys/class/net/*; do
      [[ -e "$iface" ]] || continue
      iface=${iface##*/}
      case "$iface" in
        lo|docker*|veth*|br-*|wg*|ifb*|tun*|tap*) continue ;;
      esac
      nic="$iface"
      break
    done
  fi
  [[ -n "$nic" ]] && printf '%s\n' "$nic"
}

repoDL(){
echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Repository${cRES}\r\c"
sha256sum_de_GWD=$(fetchChecksum "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/de_GWD_${architecture}.zip.sha256sum") || sha256sum_de_GWD=""
sha256sum_don_server=$(fetchChecksum "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/resource/doh/doh_s_${architecture}.sha256sum") || sha256sum_don_server=""
sha256sum_nginx=$(fetchChecksum "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/resource/nginx/nginx_${architecture}.sha256sum") || sha256sum_nginx=""
sha256sum_nginxConf=$(fetchChecksum "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/resource/nginx/nginxConf.zip.sha256sum") || sha256sum_nginxConf=""
