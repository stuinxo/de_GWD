checkSum(){
sha256sumL=$(sha256sum $1 2>/dev/null | awk '{print$1}')
if [[ $sha256sumL = $2 ]]; then 
  echo "true"
elif [[ $sha256sumL != $2 ]]; then
  echo "false"
fi
}



gh_text(){
  local url="$1"
  local jsd_url=""
  if [[ "$url" =~ ^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/(.*)$ ]]; then
    jsd_url="https://fastly.jsdelivr.net/gh/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}@${BASH_REMATCH[3]}/${BASH_REMATCH[4]}"
  fi
  local urls=("$url")
  [[ -n "$jsd_url" ]] && urls+=("$jsd_url")
  urls+=("https://ghproxy.net/${url}")

  for u in "${urls[@]}"; do
    local content
    content=$(curl -4 -fsSL -H "User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64)" --connect-timeout 5 --max-time 10 "$u" 2>/dev/null | tr -d '\r\n ')
    if [[ -n "$content" ]]; then
      echo "$content"
      return 0
    fi
  done
  return 1
}

gh_download(){
  local target="$1"
  local url="$2"
  local min_kb="${3:-10}"
  local jsd_url=""
  if [[ "$url" =~ ^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/(.*)$ ]]; then
    jsd_url="https://fastly.jsdelivr.net/gh/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}@${BASH_REMATCH[3]}/${BASH_REMATCH[4]}"
  fi
  local urls=()
  urls+=("$url")
  if [[ "$target" != *"de_GWD"* && -n "$jsd_url" ]]; then
    urls+=("$jsd_url")
  fi
  urls+=("https://ghproxy.net/${url}" "https://mirror.ghproxy.com/${url}")

  for u in "${urls[@]}"; do
    rm -f "$target"
    wget -4 --no-check-certificate --header="User-Agent: Mozilla/5.0 (Windows NT 10.0; Win64; x64)" \
      --dns-timeout=5 --connect-timeout=5 --timeout=20 --tries=2 -qO "$target" "$u" 2>/dev/null
    if [[ ! -s "$target" ]] || [[ $(du -sk "$target" 2>/dev/null | awk '{print $1}') -lt "$min_kb" ]]; then
      curl -4 -fsSL -A "Mozilla/5.0 (Windows NT 10.0; Win64; x64)" --connect-timeout 5 -m 30 -o "$target" "$u" 2>/dev/null
    fi
    if [[ -s "$target" ]]; then
      local sz=$(du -sk "$target" 2>/dev/null | awk '{print $1}')
      if [[ -n "$sz" && "$sz" -ge "$min_kb" ]]; then
        return 0
      fi
    fi
  done
  return 1
}

