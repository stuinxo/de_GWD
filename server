setupSocks5() {
    local curPort=$(getXrayInboundPort "inbound-socks5")
    clear 2>/dev/null || true
    echo -e "${GREEN}============ Configure SOCKS5 Inbound ============ ${cRES}"
    if [[ -n "$curPort" ]]; then
        echo -e "${GREEN}Current Status: ${YELLOW}Enabled on port $curPort${cRES}"
        echo
        echo -e " [1] View SOCKS5 Information & Link"
        echo -e " [2] Modify Configuration"
        echo -e " [3] Disable SOCKS5"
        echo -e " [0] Return"
        echo
        read -p "Select [0-3]: " act
        case "$act" in
            1) showSocks5Node "wait"; return ;;
            3)
                removeXrayInbound "inbound-socks5"
                echo -e "${GREEN}SOCKS5 disabled.${cRES}"
                sleep 1.5s
                return
                ;;
            2) ;;
            *) return ;;
        esac
    fi

    parseDomainAndPort "inbound-socks5" "10808" "$curPort" "false"
    local port="$target_port"
    local vpsdomain="$target_domain"

    local nicIp=$(ip -4 -o addr show dev "$(detect_primary_nic)" scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -n 1)
    local publicIp=""
    if [[ -n "$nicIp" && ! "$nicIp" =~ ^(10\.|172\.(1[6-9]|2[0-9]|3[01])\.|192\.168\.|100\.(6[4-9]|[7-9][0-9]|1[0-1][0-9]|12[0-7])\.) ]]; then
        publicIp="$nicIp"
    else
        publicIp=$(curl -4s --connect-timeout 3 ip.sb 2>/dev/null | tr -d '[:space:]')
        [[ "$publicIp" =~ ^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$ ]] || publicIp="$nicIp"
    fi

    if [[ -s "${socks5OutboundSettings:-/opt/de_GWD/socks5-outbound.json}" ]]; then
        local outAddr outPort
        while IFS=$'\t' read -r outAddr outPort; do
            [[ -n "$outAddr" && "$outPort" == "$port" ]] || continue
            local lowerOut=$(printf '%s' "$outAddr" | tr 'A-Z' 'a-z')
            lowerOut="${lowerOut#[}"
            lowerOut="${lowerOut%]}"
            if [[ "$lowerOut" == 127.* || "$lowerOut" == "::1" || "$lowerOut" == "localhost" || "$lowerOut" == localhost.* || "$lowerOut" == "0.0.0.0" || "$lowerOut" == "::" || "$lowerOut" == "$(printf '%s' "$vpsdomain" | tr 'A-Z' 'a-z')" ]]; then
                echo -e "${RED}Port $port conflicts with enabled SOCKS5 outbound ($outAddr:$outPort) and would create a routing loop!${cRES}"
                return 1
            fi
            local hostIp
            for hostIp in $publicIp $(hostname -I 2>/dev/null || true); do
                if [[ -n "$hostIp" && "$lowerOut" == "$(printf '%s' "$hostIp" | tr 'A-Z' 'a-z')" ]]; then
                    echo -e "${RED}Port $port conflicts with enabled SOCKS5 outbound ($outAddr:$outPort) and would create a routing loop!${cRES}"
                    return 1
                fi
            done
        done < <(jq -r 'if (.profiles | type) == "array" then .profiles[] | select(.enabled == true) else select(.enabled == true) end | "\(.server.address // "")\t\(.server.port // "")"' "${socks5OutboundSettings:-/opt/de_GWD/socks5-outbound.json}" 2>/dev/null)
    fi

    echo
    read -r -p "Enable Username & Password Authentication? [y/N]: " needAuth
    local inboundJson=""
    if [[ "$needAuth" =~ ^[yY] ]]; then
        read -r -p "Enter Username: " sUser
        [[ -z "$sUser" ]] && sUser="user$(openssl rand -hex 2)"
        read -r -p "Enter Password: " sPass
        [[ -z "$sPass" ]] && sPass="$(openssl rand -hex 6)"
        inboundJson=$(jq -nc \
          --argjson port "$port" \
          --arg user "$sUser" \
          --arg pass "$sPass" \
          --arg ip "$publicIp" '
          {
            tag: "inbound-socks5",
            listen: "0.0.0.0",
            port: $port,
            protocol: "socks",
            settings: (
              {
                auth: "password",
                accounts: [{user: $user, pass: $pass}],
                udp: true
              } + (if ($ip | length) > 0 then {ip: $ip} else {} end)
            )
          }')
    else
        inboundJson=$(jq -nc \
          --argjson port "$port" \
          --arg ip "$publicIp" '
          {
            tag: "inbound-socks5",
            listen: "0.0.0.0",
            port: $port,
            protocol: "socks",
            settings: (
              {
                auth: "noauth",
                udp: true
              } + (if ($ip | length) > 0 then {ip: $ip} else {} end)
            )
          }')
    fi

    if applyXrayInbound "$inboundJson" "inbound-socks5"; then
        echo -e "${GREEN}SOCKS5 Inbound successfully configured!${cRES}"
        echo
        showSocks5Node "wait"
    fi
}

setupDokodemo() {
    local curPort=$(getXrayInboundPort "inbound-dokodemo")
    clear 2>/dev/null || true
    echo -e "${GREEN}============ Configure Dokodemo-door (Port Forward) ============ ${cRES}"
    if [[ -n "$curPort" ]]; then
        echo -e "${GREEN}Current Status: ${YELLOW}Enabled on port $curPort${cRES}"
        echo
        echo -e " [1] View Dokodemo-door Information"
        echo -e " [2] Modify Configuration"
        echo -e " [3] Disable Dokodemo-door"
        echo -e " [0] Return"
        echo
        read -p "Select [0-3]: " act
        case "$act" in
            1) showDokodemoNode "wait"; return ;;
            3)
                removeXrayInbound "inbound-dokodemo"
                echo -e "${GREEN}Dokodemo-door disabled.${cRES}"
                sleep 1.5s
                return
                ;;
            2) ;;
            *) return ;;
        esac
    fi

    local recPort="10809"
    local port=""
    while true; do
        echo
        read -p "Enter Local Listening Port [Default: $recPort] (443 is reserved): " inputPort
        [[ -z "$inputPort" ]] && inputPort="$recPort"
        local chk=$(checkPortAvailable "$inputPort" "$curPort")
        if [[ "$chk" == "reserved_443" ]]; then
            echo -e "${RED}Port 443 is reserved for reverse proxy! Please choose another port.${cRES}"
        elif [[ "$chk" == "invalid" ]]; then
            echo -e "${RED}Invalid port number.${cRES}"
        elif [[ "$chk" == "in_use" ]]; then
            echo -e "${RED}Port $inputPort is already in use.${cRES}"
        else
            port="$inputPort"
            break
        fi
    done

    local tgtAddr=""
    echo
    while true; do
        read -r -p "Enter Target IP/Domain: " tgtAddr
        tgtAddr=$(echo "$tgtAddr" | tr -d '[:space:]')
        tgtAddr="${tgtAddr#[}"
        tgtAddr="${tgtAddr%]}"
        if socks5OutboundIsValidAddress "$tgtAddr"; then
            break
        fi
        echo -e "${RED}Invalid target IP/Domain: ${tgtAddr:-empty}.${cRES}"
    done

    local tgtPort=""
    echo
    while true; do
        read -r -p "Enter Target Port: " tgtPort
        tgtPort=$(echo "$tgtPort" | tr -d '[:space:]')
        if [[ "$tgtPort" =~ ^[0-9]+$ ]] && [ "$tgtPort" -ge 1 ] && [ "$tgtPort" -le 65535 ]; then
            break
        fi
        echo -e "${RED}Invalid port number.${cRES}"
    done

    local inboundJson=$(jq -nc \
      --argjson port "$port" \
      --arg addr "$tgtAddr" \
      --argjson tport "$tgtPort" '
      {
        tag: "inbound-dokodemo",
        listen: "0.0.0.0",
        port: $port,
        protocol: "dokodemo-door",
        settings: {
          address: $addr,
          port: $tport,
          network: "tcp,udp"
        }
      }')

    local outboundJson=$(jq -nc '
      {
        tag: "outbound-dokodemo",
        protocol: "freedom",
        settings: {
          finalRules: [{"action": "allow", "ip": ["0.0.0.0/0", "::/0"]}]
        }
      }')

    local ruleJson=$(jq -nc '
      {
        type: "field",
        inboundTag: ["inbound-dokodemo"],
        outboundTag: "outbound-dokodemo"
      }')

    if applyXrayInbound "$inboundJson" "inbound-dokodemo" "$outboundJson" "$ruleJson"; then
        echo -e "${GREEN}Dokodemo-door successfully configured!${cRES}"
        echo
        showDokodemoNode "wait"
    fi
}

disableAllExtraProtocols() {
    clear 2>/dev/null || true
    read -p "Are you sure you want to disable ALL extra protocols? (Default VLESS node will be kept) [y/N]: " confirm
    if [[ "$confirm" =~ ^[yY] ]]; then
        local cfg="/opt/de_GWD/vtrui/config.json"
        cp -f "$cfg" "${cfg}.bak" 2>/dev/null || true
        local tags=("inbound-vless-reality" "inbound-vless-xhttp" "inbound-vless-ws" "inbound-vmess-ws" "inbound-socks5" "inbound-dokodemo")
        for t in "${tags[@]}"; do
            if hasXrayInbound "$t"; then
                jq --arg tag "$t" 'del(.inbounds[] | select(.tag == $tag))' "$cfg" | sponge "$cfg"
            fi
            removeNginxWebProxy "$t"
        done
        jq 'del(.outbounds[]? | select(.tag == "outbound-dokodemo")) | if (.routing.rules | type) == "array" then .routing.rules |= map(select(.inboundTag != ["inbound-dokodemo"])) else . end' "$cfg" | sponge "$cfg"
        if chgrp www-data "$cfg" 2>/dev/null; then chmod 640 "$cfg"; else chmod 644 "$cfg"; fi
        rm -f /opt/de_GWD/vtrui/reality.info
        rm -f /opt/de_GWD/extra_domains.json /opt/de_GWD/extra_ports.json
        if /opt/de_GWD/vtrui/vtrui run -test -c "$cfg" >/dev/null 2>&1; then
            rm -f "${cfg}.bak"
            systemctl restart vtrui
            echo -e "${GREEN}All extra protocols disabled successfully.${cRES}"
        else
            mv -f "${cfg}.bak" "$cfg" 2>/dev/null || true
            if chgrp www-data "$cfg" 2>/dev/null; then chmod 640 "$cfg"; else chmod 644 "$cfg"; fi
            systemctl restart vtrui
            echo -e "${RED}Failed to disable extra protocols cleanly; restored previous Xray config.${cRES}"
        fi
        sleep 2s
    fi
}

