preInstall(){
sync; echo 3 >/proc/sys/vm/drop_caches >/dev/null 2>&1

rm -rf /etc/resolv.conf
cat << EOF >/etc/resolv.conf
nameserver 1.1.1.1
nameserver 8.8.8.8
EOF

if [[ $(systemctl is-active swap.target) != "active" ]]; then
systemctl unmask swap.target >/dev/null 2>&1
systemctl start swap.target >/dev/null 2>&1
fi

if [[ $(free -m | awk 'NR==3{print$2}') = "0" ]] && [[ $virt_type != "container" ]]; then
if [[ $(df -T / | awk '{print$2}' | tail -n 1) = "btrfs" ]]; then
btrfs subvolume create /swap 2>/dev/null
btrfs filesystem mkswapfile --size 1g /swap/swapfile 2>/dev/null || (mkswap /swap/swapfile 2>/dev/null || true)
swapon /swap/swapfile 2>/dev/null || true
sed -i "/swapfile/d" /etc/fstab
echo "/swap/swapfile none swap defaults 0 0" >>/etc/fstab
else
rm -f /swapfile 2>/dev/null
fallocate -l 1G /swapfile 2>/dev/null || dd if=/dev/zero of=/swapfile bs=1M count=1024 status=none 2>/dev/null
chmod 600 /swapfile
mkswap -U clear /swapfile >/dev/null 2>&1 || mkswap /swapfile >/dev/null 2>&1
swapon /swapfile 2>/dev/null || true
sed -i "/swapfile/d" /etc/fstab
echo "/swapfile none swap defaults 0 0" >>/etc/fstab
fi
mkdir -p /etc/initramfs-tools/conf.d
echo "RESUME=" >/etc/initramfs-tools/conf.d/resume
fi

mkdir -p /opt/de_GWD
mkdir -p /opt/de_GWD/.repo
cat << "EOF" >/opt/de_GWD/tcpTime
#!/bin/bash
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
if [[ $(timedatectl show -p NTPSynchronized --value 2>/dev/null) == "yes" ]]; then
  exit 0
