printNode(){
vpsdomain=$(awk '/server_name/ {print$2;exit}' /etc/nginx/conf.d/default.conf | sed 's/.$//')
port=$(awk '/ssl .* reuseport/ {print$2}' /etc/nginx/conf.d/default.conf)

if [[ $port = "443" ]]; then
vpsdomainP=$vpsdomain
else
vpsdomainP=$vpsdomain:$port
fi

path=$(jq -r '.inbounds[0].streamSettings.xhttpSettings.path // .inbounds[0].streamSettings.wsSettings.path' /opt/de_GWD/vtrui/config.json 2>/dev/null | grep -v '^null$')
uuids=$(jq -r '.inbounds[0].settings.clients[].id' /opt/de_GWD/vtrui/config.json 2>/dev/null | grep -v '^null$')

local haproxyRules=($(getHaproxyRules))
if [[ $(systemctl is-active 'haproxy' 2>/dev/null) == "active" && ${#haproxyRules[@]} -gt 0 ]]; then
echo -e "${BLUE}-------------------------------------------------- ${cRES}"
echo -e "${GREEN}HAProxy TCP Port Forward${cRES}"
echo
local idx=1
for r in "${haproxyRules[@]}"; do
    local p="${r%%|*}"
    local tgt="${r##*|}"
    local upD="${tgt%%:*}"
    echo -e "${BLUE}Rule ${idx}:${cRES}"
    echo -e "  ${BLUE}Address:       ${YELLOW}$vpsdomain:$p${cRES}"
    echo -e "  ${BLUE}Target:        ${YELLOW}$tgt${cRES}"
    echo -e "  ${BLUE}TLS SNI:       ${YELLOW}$upD${cRES}"
    echo
    ((idx++))
done
fi

echo -e "${BLUE}-------------------------------------------------- ${cRES}"
echo -e "${GREEN}Default Node Information (VLESS + XHTTP + TLS)${cRES}"
echo
echo -e "${BLUE}DoH:       ${YELLOW}$vpsdomainP/dq${cRES}"
echo -e "${BLUE}Address:   ${YELLOW}$vpsdomainP${cRES}"
echo -e "${BLUE}UUID:      ${YELLOW}$uuids${cRES}"
echo -e "${BLUE}Path:      ${YELLOW}$path${cRES}"
echo
echo -e "${BLUE}QR code: ${cRES}"
subAddr=$(echo -n "$(jq -r '.inbounds[0].settings.clients[0].id' /opt/de_GWD/vtrui/config.json 2>/dev/null | grep -v '^null$')@$vpsdomain:$port")
local encPath="%2F${path#/}"
subUrl="vless://${subAddr}?encryption=none&security=tls&sni=${vpsdomain}&type=xhttp&path=${encPath}&mode=packet-up#${vpsdomain}:${port}"
qrencode -t UTF8 -s 1 -m 3 "$subUrl"
echo
echo -e "${BLUE}Link:        ${YELLOW}${subUrl}${cRES}"
echo -e "${BLUE}-------------------------------------------------- ${cRES}"

# Print active extra protocols if any
showAllExtraNodes
}



saveCommand(){
mkdir -p /opt/de_GWD
if [[ -f "$0" && "$0" != *"bash"* && "$0" != *"/fd/"* && "$0" != *"/proc/"* && "$0" != *"/tmp/"* && "$0" != *"/opt/de_GWD/server" && "$0" != *"/bin/dex" && "$0" != *"/bin/de_GWD" ]]; then
  cp -f "$0" /opt/de_GWD/server
else
  wget --no-check-certificate -qO /tmp/server_new "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/server" 2>/dev/null || \
  curl -fsSL -o /tmp/server_new "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/server" 2>/dev/null
  if [[ -f /tmp/server_new && $(wc -l < /tmp/server_new) -gt 500 ]]; then
    mv -f /tmp/server_new /opt/de_GWD/server
  fi
  rm -rf /tmp/server_new
fi

if [[ -f /opt/de_GWD/server ]]; then
  chmod +x /opt/de_GWD/server
  grep -q 'start_menu' /opt/de_GWD/server || echo 'start_menu' >> /opt/de_GWD/server
  ln -sf /opt/de_GWD/server /usr/local/bin/dex 2>/dev/null
  ln -sf /opt/de_GWD/server /usr/bin/dex 2>/dev/null
  ln -sf /opt/de_GWD/server /usr/local/bin/de_GWD 2>/dev/null
  ln -sf /opt/de_GWD/server /usr/bin/de_GWD 2>/dev/null
fi
}



