interface_FT=$(find /sys/class/net ! -type d | xargs --max-args=1 realpath 2>/dev/null | grep 'device' | awk -F'/' '{print $NF}' | xargs -n1 | grep -vE '^(lo|ifb.*|wg.*|tun.*|tap.*|docker.*|br-.*|veth.*)$' || true)

interface_BF=()
while IFS= read -r line; do
    [[ -n "$line" ]] && interface_BF+=("$line")
done <<< "$interface_FT"

if [[ ${#interface_BF[@]} -gt 0 ]]; then
  cat << FT_EOF >/opt/de_GWD/nftables/flowtable.nft
table inet bypassflow {
    flowtable Acceleration {
        hook ingress priority filter; devices = { $(IFS=, ; echo "${interface_BF[*]}") };
    }

    chain bypasschain {
        type filter hook forward priority filter; policy accept;
        ct state established ip daddr 172.16.0.0/24 flow offload @Acceleration
        ct state established ip saddr 172.16.0.0/24 flow offload @Acceleration
        ct state established ip daddr 172.17.0.0/16 flow offload @Acceleration
        ct state established ip saddr 172.17.0.0/16 flow offload @Acceleration
    }
}
FT_EOF
else
  : >/opt/de_GWD/nftables/flowtable.nft
fi
EOF
