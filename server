socks5OutboundProfiles(){
local settings=$1
jq -c '
  if (.profiles | type) == "array" then
    [.profiles[] | {
      tag: (if .name == "default" then "socks5-exit" else "socks5-exit-" + .name end),
      profile: (. + {
        domains: (.domains // []),
        ips: (.ips // [])
      } + (if .name == "default" then {privateBypass: (if has("privateBypass") then .privateBypass else true end)} else {} end))
    }]
  elif ((.enabled // false) == true or (.server.address // "") != "" or ((.domains // []) | length) > 0 or ((.ips // []) | length) > 0) then
