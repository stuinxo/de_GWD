fi

candidate=$(mktemp /tmp/de_GWD-socks5-outbound.XXXXXX) || return 1
baseProfiles=$(jq -c '
  if (.profiles | type) == "array" then .profiles
  elif ((.enabled // false) == true or (.server.address // "") != "" or ((.domains // []) | length) > 0 or ((.ips // []) | length) > 0) then
    [{name:"default",enabled:(.enabled // false),server:(.server // {}),domains:(.domains // []),ips:(.ips // []),privateBypass:(if has("privateBypass") then .privateBypass else true end)}]
  else []
  end
' <<< "$base") || { rm -f "$candidate"; return 1; }

if ! jq -n --argjson profiles "$baseProfiles" --argjson profile "$profileJson" '
  {
