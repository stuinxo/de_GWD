setupReality() {
    local curPort=$(getXrayInboundPort "inbound-vless-reality")
    local vpsdomain=$(awk '/server_name/ {print$2;exit}' /etc/nginx/conf.d/default.conf 2>/dev/null | sed 's/.$//')
    [[ -z "$vpsdomain" ]] && vpsdomain=$(curl -4 -s --connect-timeout 3 ip.sb 2>/dev/null || hostname -I | awk '{print $1}')
    local nginxPort=$(awk '/ssl .* reuseport/ {print$2}' /etc/nginx/conf.d/default.conf 2>/dev/null | grep '^[[:digit:]]*$' | head -n1)
    [[ -z "$nginxPort" ]] && nginxPort="443"

    clear 2>/dev/null || true
    echo -e "${GREEN}============ Configure VLESS + TCP + Reality + Vision ============ ${cRES}"
    if [[ -n "$curPort" ]]; then
        echo -e "${GREEN}Current Status: ${YELLOW}Enabled on port $curPort${cRES}"
        echo
        echo -e " [1] View Node Link & QR Code"
        echo -e " [2] Modify Configuration"
        echo -e " [3] Disable This Protocol"
        echo -e " [0] Return"
        echo
        read -p "Select [0-3]: " act
        case "$act" in
            1) showRealityNode "wait"; return ;;
            3)
                removeXrayInbound "inbound-vless-reality"
                echo -e "${GREEN}VLESS Reality disabled.${cRES}"
                sleep 1.5s
                return
                ;;
            2) ;;
            *) return ;;
        esac
    fi

    parseDomainAndPort "inbound-vless-reality" "2096" "$curPort" "false"
    local port="$target_port"
    local vpsdomain="$target_domain"

    echo
    read -p "Enter SNI camouflage domain [Default: $vpsdomain]: " inputSni
    [[ -z "$inputSni" ]] && inputSni="$vpsdomain"

    local recDest="127.0.0.1:$nginxPort"
    if ss -tulpn 2>/dev/null | grep -qE "[: ]443[ \t]"; then
        recDest="127.0.0.1:443"
    fi
    echo
    read -p "Enter Fallback dest [Default: $recDest]: " inputDest
    [[ -z "$inputDest" ]] && inputDest="$recDest"

    local uuid=$(/opt/de_GWD/vtrui/vtrui uuid 2>/dev/null || cat /proc/sys/kernel/random/uuid)
    local keys=$(/opt/de_GWD/vtrui/vtrui x25519 2>/dev/null)
    local priKey=$(printf '%s\n' "$keys" | awk -F': ' '/^(Private key|PrivateKey):/ {print $2; exit}' | tr -d '\r\n ')
    local pubKey=$(printf '%s\n' "$keys" | awk -F': ' '/^(Public key|PublicKey|Password|Password \(PublicKey\)): / {print $2; exit}' | tr -d '\r\n ')
    [[ -z "$pubKey" ]] && pubKey=$(printf '%s\n' "$keys" | awk -F': ' '/^(Public key|PublicKey|Password|Password \(PublicKey\)):/ {print $2; exit}' | tr -d '\r\n ')
    local shortId=$(openssl rand -hex 8)

    local inboundJson=$(cat << EOF
{
  "tag": "inbound-vless-reality",
  "listen": "0.0.0.0",
  "port": $port,
  "protocol": "vless",
  "settings": {
    "clients": [
      {
        "id": "$uuid",
        "flow": "xtls-rprx-vision"
      }
    ],
    "decryption": "none"
  },
  "streamSettings": {
    "network": "tcp",
    "security": "reality",
    "realitySettings": {
      "show": false,
      "dest": "$inputDest",
      "xver": 0,
      "serverNames": ["$inputSni"],
      "privateKey": "$priKey",
      "shortIds": ["$shortId"],
      "publicKey": "$pubKey"
    },
    "sockopt": {
      "tcpFastOpen": true,
      "tcpNoDelay": true
    }
  },
  "sniffing": {
    "enabled": true,
    "destOverride": ["http", "tls", "quic"]
  }
}
EOF
)

    if applyXrayInbound "$inboundJson" "inbound-vless-reality"; then
        cat << EOF > /opt/de_GWD/vtrui/reality.info
PORT=$port
UUID=$uuid
SNI=$inputSni
DEST=$inputDest
PUBKEY=$pubKey
PRIKEY=$priKey
SHORTID=$shortId
EOF
        echo -e "${GREEN}VLESS + TCP + Reality + Vision successfully configured!${cRES}"
        echo
        showRealityNode "wait"
    fi
}

