socks5OutboundCheckSelfLoop(){
local address="${1:-}" port="${2:-}" inboundPort="" lowerAddr="" nginxDomain="" extraDomain="" hostIp=""
[[ -s $vtruiConfig ]] || return 0
inboundPort=$(jq -r '.inbounds[]? | select(.tag == "inbound-socks5") | .port // empty' "$vtruiConfig" 2>/dev/null | head -n 1)
[[ -n $inboundPort && $inboundPort =~ ^[1-9][0-9]{0,4}$ ]] || return 0
[[ -n $port && $port =~ ^[1-9][0-9]{0,4}$ ]] || return 0
(( 10#$inboundPort == 10#$port )) || return 0

lowerAddr=$(printf '%s' "$address" | tr 'A-Z' 'a-z')
lowerAddr="${lowerAddr#[}"
lowerAddr="${lowerAddr%]}"
case "$lowerAddr" in
  127.*|::1|0:0:0:0:0:0:0:1|localhost|localhost.*|0.0.0.0|::)
    echo -e "${WHITE}SOCKS5 outbound${RED} self-loop detected: ${address}:${port} points to local inbound-socks5${cRES}" >&2
    return 1
    ;;
esac

if [[ -r /etc/nginx/conf.d/default.conf ]]; then
  nginxDomain=$(awk '/server_name/ {print $2; exit}' /etc/nginx/conf.d/default.conf 2>/dev/null | sed 's/;$//' | tr 'A-Z' 'a-z')
  if [[ -n $nginxDomain && $lowerAddr == "$nginxDomain" ]]; then
    echo -e "${WHITE}SOCKS5 outbound${RED} self-loop detected: ${address}:${port} points to local inbound-socks5${cRES}" >&2
    return 1
  fi
fi

if [[ -r /opt/de_GWD/extra_domains.json ]]; then
  extraDomain=$(jq -r '.["inbound-socks5"] // empty' /opt/de_GWD/extra_domains.json 2>/dev/null | tr 'A-Z' 'a-z')
  if [[ -n $extraDomain && $lowerAddr == "$extraDomain" ]]; then
    echo -e "${WHITE}SOCKS5 outbound${RED} self-loop detected: ${address}:${port} points to local inbound-socks5${cRES}" >&2
    return 1
  fi
fi

if command -v hostname >/dev/null 2>&1; then
  for hostIp in $(hostname -I 2>/dev/null || true); do
    if [[ $(printf '%s' "$hostIp" | tr 'A-Z' 'a-z') == "$lowerAddr" ]]; then
      echo -e "${WHITE}SOCKS5 outbound${RED} self-loop detected: ${address}:${port} points to local inbound-socks5${cRES}" >&2
      return 1
    fi
  done
fi
return 0
}



socks5OutboundValidateProfile(){
local profile=$1 name enabled address port username password ipRule
jq -e 'type == "object" and ((.enabled // false) | type == "boolean") and ((.server // {}) | type == "object") and ((.domains // []) | type == "array") and ((.ips // []) | type == "array") and (if has("privateBypass") then (.privateBypass | type == "boolean") else true end)' <<< "$profile" >/dev/null 2>&1 || return 1
name=$(jq -r '.name // empty' <<< "$profile")
[[ -z $name || $name =~ ^[A-Za-z0-9][A-Za-z0-9_-]{0,31}$ ]] || return 1
enabled=$(jq -r '.enabled // false' <<< "$profile")
[[ $enabled = true || $enabled = false ]] || return 1
[[ $enabled = true ]] || return 0

address=$(jq -r '.server.address // empty' <<< "$profile")
port=$(jq -r 'if (.server.port | type) == "number" or (.server.port | type) == "string" then (.server.port | tostring) else "" end' <<< "$profile")
username=$(jq -r '.server.username // empty' <<< "$profile")
password=$(jq -r '.server.password // empty' <<< "$profile")

socks5OutboundIsValidAddress "$address" || {
  echo -e "${WHITE}SOCKS5 outbound${RED} invalid server address: ${address:-<empty>}${cRES}" >&2
  return 1
}
[[ $port =~ ^[1-9][0-9]{0,4}$ ]] && (( 10#$port <= 65535 )) || {
  echo -e "${WHITE}SOCKS5 outbound${RED} invalid server port: ${port:-<empty>}${cRES}" >&2
  return 1
}
socks5OutboundCheckSelfLoop "$address" "$port" || return 1

[[ -z $username && -z $password ]] || {
  [[ -n $username && -n $password ]] || {
    echo -e "${WHITE}SOCKS5 outbound${RED} username and password must be provided together${cRES}" >&2
    return 1
  }
  jq -e '((.server.username // "") | test("[[:cntrl:]]") | not) and ((.server.password // "") | test("[[:cntrl:]]") | not)' <<< "$profile" >/dev/null 2>&1 || {
    echo -e "${WHITE}SOCKS5 outbound${RED} credentials contain invalid control characters${cRES}" >&2
    return 1
  }
}

jq -e 'all((.domains // [])[]; type == "string" and length > 0 and (test("[[:space:][:cntrl:]]") | not))' <<< "$profile" >/dev/null 2>&1 || {
  echo -e "${WHITE}SOCKS5 outbound${RED} invalid domain rule entry${cRES}" >&2
  return 1
}
jq -e 'all((.ips // [])[]; type == "string" and length > 0 and (test("[[:space:][:cntrl:]]") | not))' <<< "$profile" >/dev/null 2>&1 || {
  echo -e "${WHITE}SOCKS5 outbound${RED} invalid IP/CIDR rule entry${cRES}" >&2
  return 1
}

while IFS= read -r ipRule; do
  [[ -n $ipRule ]] || continue
  socks5OutboundIsValidIpRule "$ipRule" || {
    echo -e "${WHITE}SOCKS5 outbound${RED} invalid IP/CIDR rule: $ipRule${cRES}" >&2
    return 1
  }
done < <(jq -r '(.ips // [])[]' <<< "$profile")

jq -e '((.name == "default") or (((.domains // []) | length) + ((.ips // []) | length) > 0))' <<< "$profile" >/dev/null 2>&1 || {
  echo -e "${WHITE}SOCKS5 outbound${RED} domain or IP rules are required for non-default exits${cRES}" >&2
  return 1
}
return 0
}



socks5OutboundValidate(){
local settings=$1 profile names dupDomain dupIp
[[ -s $settings ]] || return 1
jq -e . "$settings" >/dev/null 2>&1 || return 1
if jq -e 'type == "object" and (.profiles | type) == "array"' "$settings" >/dev/null 2>&1; then
  names=$(jq -r '[.profiles[].name] | length == (unique | length)' "$settings") || return 1
  [[ $names = true ]] || {
    echo -e "${WHITE}SOCKS5 outbound${RED} duplicate profile names found${cRES}" >&2
    return 1
  }
  while IFS= read -r profile; do
    socks5OutboundValidateProfile "$profile" || return 1
  done < <(jq -c '.profiles[]' "$settings")
  dupDomain=$(jq -r '[([.profiles[] | select(.enabled == true) | (.domains // [])[]] | group_by(.)[] | select(length > 1) | .[0])] | .[0] // empty' "$settings") || return 1
  if [[ -n $dupDomain ]]; then
    echo -e "${WHITE}SOCKS5 outbound${RED} duplicate domain rule across enabled profiles: $dupDomain${cRES}" >&2
    return 1
  fi
  dupIp=$(jq -r '[([.profiles[] | select(.enabled == true) | (.ips // [])[]] | group_by(.)[] | select(length > 1) | .[0])] | .[0] // empty' "$settings") || return 1
  if [[ -n $dupIp ]]; then
    echo -e "${WHITE}SOCKS5 outbound${RED} duplicate IP rule across enabled profiles: $dupIp${cRES}" >&2
    return 1
  fi
  return 0
fi

profile=$(jq -c '. + {name:"default"}' "$settings" 2>/dev/null) || return 1
socks5OutboundValidateProfile "$profile"
}



