enableAutoUpdate(){
{
  printf '%s\n' '#!/bin/bash'
  printf '%s\n' "PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'"
  printf 'branch=%q\n' "${branch:-v2}"
  cat << "EOF"
localVer=$(awk 'NR==1' /opt/de_GWD/version.php 2>/dev/null | tr -d '\r ')
remoteVer=$(curl -fsSL --connect-timeout 5 -m 10 "https://raw.githubusercontent.com/stuinxo/de_GWD/${branch}/version.php" | head -n 1 | tr -d '\r ')

if [[ -z "$remoteVer" ]] || [[ ! "$remoteVer" =~ ^v?[0-9]+\.[0-9]+ ]] || [[ "$remoteVer" == "$localVer" ]]; then
  exit 0
fi

VerCP=$(printf '%s\n%s\n' "$localVer" "$remoteVer" | sort -rV | uniq | awk 'NR==2')

if [[ "$VerCP" == "$localVer" ]]; then
  tmpAuto=$(mktemp /tmp/de_GWD-autoUpdate.XXXXXX) || exit 1
  tmpClean=$(mktemp /tmp/de_GWD-autoUpdate-clean.XXXXXX) || { rm -f "$tmpAuto"; exit 1; }
  trap 'rm -f "$tmpAuto" "$tmpClean"' EXIT

  if curl -fsSL --connect-timeout 10 -m 60 -o "$tmpAuto" "https://raw.githubusercontent.com/stuinxo/de_GWD/${branch}/server" &&
     [[ $(du -sk "$tmpAuto" 2>/dev/null | awk '{print $1}') -gt 70 ]] &&
     grep -q 'updateGWD()' "$tmpAuto"; then
    expectedSha=$(curl -fsSL --connect-timeout 5 -m 10 "https://raw.githubusercontent.com/stuinxo/de_GWD/${branch}/server.sha256sum" 2>/dev/null | awk 'NR==1 {print $1}' | tr -d '\r ' | tr 'A-F' 'a-f')
    if [[ "$expectedSha" =~ ^[0-9a-f]{64}$ ]]; then
      actualSha=$(sha256sum "$tmpAuto" 2>/dev/null | awk '{print $1}' | tr 'A-F' 'a-f')
      [[ "$actualSha" == "$expectedSha" ]] || exit 1
    fi
    awk '{lines[NR]=$0} END {n=NR; while(n>0 && lines[n]=="") n--; if(n>0 && lines[n]=="start_menu") n--; for(i=1;i<=n;i++) print lines[i]}' "$tmpAuto" >"$tmpClean"
    printf '%s\n' 'updateGWD' >>"$tmpClean"
    if bash -n "$tmpClean" 2>/dev/null; then
      chmod 700 "$tmpClean"
      "$tmpClean"
    fi
  fi
fi
EOF
} >/opt/de_GWD/autoUpdate
chmod +x /opt/de_GWD/autoUpdate

local tmpCron
tmpCron=$(mktemp /tmp/de_GWD-cron.XXXXXX) || return 1
crontab -l 2>/dev/null >"$tmpCron" || true
sed -i '/autoUpdate/d' "$tmpCron"
echo '30 4 * * *  /opt/de_GWD/autoUpdate' >>"$tmpCron"
crontab "$tmpCron"
rm -f "$tmpCron"
}



