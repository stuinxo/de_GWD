        fi
        mv -f /tmp/nginx /usr/sbin/nginx && chmod +x /usr/sbin/nginx
    else
        echo -e "${RED}Download Failed${cRES}" && exit 1
    fi
fi

if [[ -f "./de_GWD_$architecture.zip" ]]; then
    cp -f ./de_GWD_$architecture.zip /opt/de_GWD/.repo/de_GWD.zip
elif [[ -f "./resource/de_GWD_$architecture.zip" ]]; then
    cp -f ./resource/de_GWD_$architecture.zip /opt/de_GWD/.repo/de_GWD.zip
elif [[ -z "$sha256sum_de_GWD" ]] || [[ $(checkSum /opt/de_GWD/.repo/de_GWD.zip $sha256sum_de_GWD) = "false" ]]; then
    rm -rf /tmp/de_GWD.zip
    if gh_download /tmp/de_GWD.zip "https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/de_GWD_${architecture}.zip" 10000; then
