setupDokodemo() {
    local curPort=$(getXrayInboundPort "inbound-dokodemo")
    clear 2>/dev/null || true
    echo -e "${GREEN}============ Configure Dokodemo-door (Port Forward) ============ ${cRES}"
    if [[ -n "$curPort" ]]; then
        echo -e "${GREEN}Current Status: ${YELLOW}Enabled on port $curPort${cRES}"
        echo
        echo -e " [1] View Dokodemo-door Information"
        echo -e " [2] Modify Configuration"
        echo -e " [3] Disable Dokodemo-door"
        echo -e " [0] Return"
        echo
        read -p "Select [0-3]: " act
        case "$act" in
            1) showDokodemoNode "wait"; return ;;
            3)
                removeXrayInbound "inbound-dokodemo"
                echo -e "${GREEN}Dokodemo-door disabled.${cRES}"
                sleep 1.5s
                return
                ;;
            2) ;;
            *) return ;;
        esac
    fi

    local recPort="10809"
    local port=""
    while true; do
        echo
        read -p "Enter Local Listening Port [Default: $recPort] (443 is reserved): " inputPort
        [[ -z "$inputPort" ]] && inputPort="$recPort"
        local chk=$(checkPortAvailable "$inputPort" "$curPort")
        if [[ "$chk" == "reserved_443" ]]; then
            echo -e "${RED}Port 443 is reserved for reverse proxy! Please choose another port.${cRES}"
        elif [[ "$chk" == "invalid" ]]; then
            echo -e "${RED}Invalid port number.${cRES}"
        elif [[ "$chk" == "in_use" ]]; then
            echo -e "${RED}Port $inputPort is already in use.${cRES}"
        else
            port="$inputPort"
            break
        fi
    done

    local tgtAddr=""
    echo
    while true; do
        read -p "Enter Target IP/Domain: " tgtAddr
        tgtAddr=$(echo "$tgtAddr" | tr -d ' ')
        [[ -n "$tgtAddr" ]] && break
        echo -e "${RED}Target IP/Domain cannot be empty.${cRES}"
    done

    local tgtPort=""
    echo
    while true; do
        read -p "Enter Target Port: " tgtPort
        tgtPort=$(echo "$tgtPort" | tr -d ' ')
        if [[ "$tgtPort" =~ ^[0-9]+$ ]] && [ "$tgtPort" -ge 1 ] && [ "$tgtPort" -le 65535 ]; then
            break
        fi
        echo -e "${RED}Invalid port number.${cRES}"
    done

    local inboundJson=$(cat << EOF
{
  "tag": "inbound-dokodemo",
  "listen": "0.0.0.0",
  "port": $port,
  "protocol": "dokodemo-door",
  "settings": {
    "address": "$tgtAddr",
    "port": $tgtPort,
    "network": "tcp,udp"
  }
}
EOF
)

    if applyXrayInbound "$inboundJson" "inbound-dokodemo"; then
        echo -e "${GREEN}Dokodemo-door successfully configured!${cRES}"
        echo
        showDokodemoNode "wait"
    fi
}

disableAllExtraProtocols() {
    clear 2>/dev/null || true
    read -p "Are you sure you want to disable ALL extra protocols? (Default VMess node will be kept) [y/N]: " confirm
    if [[ "$confirm" =~ ^[yY] ]]; then
        local tags=("inbound-vless-reality" "inbound-vless-xhttp" "inbound-vless-ws" "inbound-vmess-ws" "inbound-socks5" "inbound-dokodemo")
        for t in "${tags[@]}"; do
            if hasXrayInbound "$t"; then
                jq --arg tag "$t" 'del(.inbounds[] | select(.tag == $tag))' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json
            fi
            removeNginxWebProxy "$t"
        done
        rm -f /opt/de_GWD/vtrui/reality.info
        rm -f /opt/de_GWD/extra_domains.json /opt/de_GWD/extra_ports.json
        if /opt/de_GWD/vtrui/vtrui run -test -c /opt/de_GWD/vtrui/config.json >/dev/null 2>&1; then
            systemctl restart vtrui
            echo -e "${GREEN}All extra protocols disabled successfully.${cRES}"
        fi
        sleep 2s
    fi
}

