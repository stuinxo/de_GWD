      tag: "socks5-exit",
      profile: (. + {
        name: "default",
        domains: (.domains // []),
        ips: (.ips // []),
        privateBypass: (if has("privateBypass") then .privateBypass else true end)
      })
    }]
  else
    []
  end
' "$settings"
}



