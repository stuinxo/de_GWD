makeSSL_D(){
local tmpCron
tmpCron=$(mktemp /tmp/de_GWD-cron.XXXXXX)
if [[ -n "$tmpCron" ]]; then
  crontab -l 2>/dev/null >"$tmpCron" || true
  sed -i '/acme.sh/d' "$tmpCron"
  crontab "$tmpCron"
  rm -f "$tmpCron"
fi

export CF_Token="$CFtoken"
unset CF_Key CF_Email

local mainDomain="$domain"
local domainArgs=("-d" "$domain" "-d" "*.$domain")
if [[ "$domain" =~ \.(co|org|gov|ac|net|me|plc|ltd)\.uk$ || "$domain" =~ \.(com|net|org|gov|edu|ac)\.cn$ || "$domain" =~ \.(com|net|org|edu|gov)\.(hk|tw|au)$ || "$domain" =~ \.(co|or|ne|ac|go)\.jp$ || "$domain" =~ \.(co|or|ne)\.kr$ || "$domain" =~ \.com\.(sg|br|mx|tr)$ || "$domain" =~ \.co\.(za|in|nz)$ || "$domain" =~ \.eu\.org$ ]]; then
  if [[ "$domain" == *.*.*.* ]]; then
    local parentDomain=$(echo "$domain" | cut -d. -f2-)
    mainDomain="$parentDomain"
    domainArgs=("-d" "$parentDomain" "-d" "*.$parentDomain" "-d" "*.$domain")
  fi
elif [[ "$domain" == *.*.* ]]; then
  local parentDomain=$(echo "$domain" | cut -d. -f2-)
  mainDomain="$parentDomain"
  domainArgs=("-d" "$parentDomain" "-d" "*.$parentDomain" "-d" "*.$domain")
fi

if [[ $(systemctl is-active 'nginx') != "active" ]]; then
  systemctl restart nginx
  if [[ $? -ne 0 ]]; then
  sed -i '/Nice=/d' /etc/systemd/system/nginx.service
  systemctl daemon-reload >/dev/null
  systemctl restart nginx
  fi
else
systemctl force-reload nginx
fi

find /var/www/ssl/*.pem 2>/dev/null | grep -v "dhparam.pem" | xargs -I {} rm -rf {} 2>/dev/null || true
if [[ ! -f /var/www/ssl/de_GWD.cer || ! -f /var/www/ssl/de_GWD.key ]]; then
  mkdir -p /var/www/ssl
  local selfStage
  selfStage=$(mktemp -d /tmp/de_GWD-ssl-init.XXXXXX)
  if [[ -n "$selfStage" ]] && openssl req -x509 -nodes -days 365 \
    -subj "/C=CA/ST=QC/O=Company, Inc./CN=$domain" \
    -newkey rsa:2048 \
    -keyout "$selfStage/de_GWD.key" \
    -out "$selfStage/de_GWD.cer" >/dev/null 2>&1; then
    chmod 640 "$selfStage/de_GWD.key" 2>/dev/null || true
    chmod 644 "$selfStage/de_GWD.cer" 2>/dev/null || true
    mv -f "$selfStage/de_GWD.key" /var/www/ssl/de_GWD.key
    mv -f "$selfStage/de_GWD.cer" /var/www/ssl/de_GWD.cer
  fi
  rm -rf "$selfStage"
  chown root:www-data /var/www/ssl/de_GWD.key 2>/dev/null || true
  chmod 640 /var/www/ssl/de_GWD.key 2>/dev/null || true
  chmod 644 /var/www/ssl/de_GWD.cer 2>/dev/null || true
fi

if [[ ! -x "/root/.acme.sh/acme.sh" ]]; then
  curl -fsSL https://get.acme.sh | sh
fi
sed -i '/CF_Key/d;/CF_Email/d;/ACCOUNT_EMAIL.*example\.com/d' /root/.acme.sh/account.conf 2>/dev/null || true
"/root/.acme.sh"/acme.sh --set-default-ca  --server letsencrypt

local sslStage sslOk=0 acmeSrc stagedCertPub stagedKeyPub instCertPub instKeyPub
sslStage=$(mktemp -d /tmp/de_GWD-ssl.XXXXXX)
[[ -f /var/www/ssl/de_GWD.cer ]] && cp -p /var/www/ssl/de_GWD.cer "$sslStage/de_GWD.cer.bak"
[[ -f /var/www/ssl/de_GWD.key ]] && cp -p /var/www/ssl/de_GWD.key "$sslStage/de_GWD.key.bak"

if "/root/.acme.sh"/acme.sh --issue --dns dns_cf --dnssleep 45 "${domainArgs[@]}" -k ec-256; then
  acmeSrc="/root/.acme.sh/${mainDomain}_ecc"
  if [[ -f "$acmeSrc/fullchain.cer" && -f "$acmeSrc/${mainDomain}.key" ]]; then
    cp -f "$acmeSrc/fullchain.cer" "$sslStage/de_GWD.cer"
    cp -f "$acmeSrc/${mainDomain}.key" "$sslStage/de_GWD.key"
    chmod 640 "$sslStage/de_GWD.key" 2>/dev/null || true
    stagedCertPub=$(openssl x509 -in "$sslStage/de_GWD.cer" -noout -pubkey 2>/dev/null)
    stagedKeyPub=$(openssl pkey -in "$sslStage/de_GWD.key" -pubout 2>/dev/null)
    if [[ -n "$stagedCertPub" && "$stagedCertPub" == "$stagedKeyPub" ]]; then
      if "/root/.acme.sh"/acme.sh --installcert -d "$mainDomain" \
                     --key-file       /var/www/ssl/de_GWD.key  \
                     --fullchain-file /var/www/ssl/de_GWD.cer \
                     --reloadcmd     "chown root:www-data /var/www/ssl/*.key 2>/dev/null || true; chmod 640 /var/www/ssl/*.key 2>/dev/null || true; systemctl force-reload nginx; if systemctl is-active --quiet RproxyS; then systemctl restart RproxyS; fi" \
                     --ecc; then
        chown root:www-data /var/www/ssl/*.key 2>/dev/null || true
        chmod 640 /var/www/ssl/*.key 2>/dev/null || true
        chmod 644 /var/www/ssl/de_GWD.cer 2>/dev/null || true
        instCertPub=$(openssl x509 -in /var/www/ssl/de_GWD.cer -noout -pubkey 2>/dev/null)
        instKeyPub=$(openssl pkey -in /var/www/ssl/de_GWD.key -pubout 2>/dev/null)
        [[ -n "$instCertPub" && "$instCertPub" == "$instKeyPub" ]] && sslOk=1
      fi
    fi
  fi
fi

if [[ "$sslOk" -ne 1 ]]; then
  [[ -f "$sslStage/de_GWD.cer.bak" ]] && mv -f "$sslStage/de_GWD.cer.bak" /var/www/ssl/de_GWD.cer
  [[ -f "$sslStage/de_GWD.key.bak" ]] && mv -f "$sslStage/de_GWD.key.bak" /var/www/ssl/de_GWD.key
  chown root:www-data /var/www/ssl/*.key 2>/dev/null || true
  chmod 640 /var/www/ssl/*.key 2>/dev/null || true
  chmod 644 /var/www/ssl/de_GWD.cer 2>/dev/null || true
  rm -rf "$sslStage"
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}TLS Certificate generation/verification failed (kept previous cert)${cRES}"
  return 1
fi
rm -rf "$sslStage"
}



