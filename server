        echo "$vpsdomain"
    fi
}

parseDomainAndPort() {
    local in_tag="$1"
    local rec_port="$2"
    local cur_port="$3"
    local allow_443="$4"

    local default_domain=$(awk '/server_name/ {print$2;exit}' /etc/nginx/conf.d/default.conf 2>/dev/null | sed 's/.$//')
    [[ -z "$default_domain" ]] && default_domain=$(curl -4 -s --connect-timeout 3 ip.sb 2>/dev/null || hostname -I | awk '{print $1}')

    local saved_domain=""
    if [[ -f /opt/de_GWD/extra_domains.json ]]; then
        saved_domain=$(jq -r --arg tag "$in_tag" '.[$tag]' /opt/de_GWD/extra_domains.json 2>/dev/null | grep -v '^null$')
    fi
    local use_domain="${saved_domain:-$default_domain}"

    target_domain=""
    target_port=""

    while true; do
        echo
        if [[ "$allow_443" == "true" ]]; then
            echo -e "${CYAN}Tip: You can enter [Domain:Port] (e.g. sub.domain.com:443 or sub.domain.com:$rec_port) or just [Port].${cRES}"
            read -r -p "Enter Domain:Port [Default: ${use_domain}:${rec_port}] (Port 443 supported with subdomains): " user_input
        else
            echo -e "${CYAN}Tip: You can enter [Domain:Port] (e.g. sub.domain.com:$rec_port) or just [Port].${cRES}"
            read -r -p "Enter Domain:Port [Default: ${use_domain}:${rec_port}] (443 reserved): " user_input
        fi
        user_input=$(echo "$user_input" | sed -E 's#^https?://##; s#/.*$##' | tr -d '[:space:]')

        local parsed_d=""
        local parsed_p=""

        if [[ -z "$user_input" ]]; then
            parsed_d="$use_domain"
            parsed_p="$rec_port"
        elif [[ "$user_input" == *":"* ]]; then
            parsed_d="${user_input%:*}"
            parsed_p="${user_input##*:}"
        else
            parsed_d="$use_domain"
            parsed_p="$user_input"
        fi
        parsed_d="${parsed_d#[}"
        parsed_d="${parsed_d%]}"

        local chk=$(checkPortAvailable "$parsed_p" "$cur_port" "$allow_443")
        local collision443=0
        if [[ "$allow_443" == "true" && "$parsed_p" == "443" ]]; then
            if [[ "$parsed_d" == "$default_domain" ]]; then
                collision443=1
            else
                local ownConf="$(getNginxConfName "$in_tag").conf"
                local cf
                for cf in /etc/nginx/conf.d/*.conf; do
                    [[ -f "$cf" && "$(basename "$cf")" != "$ownConf" ]] || continue
                    if grep -qE 'listen[[:space:]]+(\[::\]:)?443\b' "$cf" 2>/dev/null && grep -qE "server_name[[:space:]]+${parsed_d//./\\.}(;|\s)" "$cf" 2>/dev/null; then
                        collision443=1
                        break
                    fi
                done
            fi
        fi
        if [[ "$chk" == "reserved_443" ]]; then
            echo -e "${RED}Port 443 is reserved for reverse proxy/web services! Please choose another port.${cRES}"
        elif [[ "$chk" == "invalid" ]]; then
            echo -e "${RED}Invalid port number: '$parsed_p'. Must be between 1 and 65535.${cRES}"
        elif [[ "$chk" == "in_use" ]]; then
            echo -e "${RED}Port $parsed_p is already in use by another process. Please choose another port.${cRES}"
        elif ! socks5OutboundIsValidAddress "$parsed_d"; then
            echo -e "${RED}Invalid domain/host: '$parsed_d'.${cRES}"
        elif (( collision443 == 1 )); then
            echo -e "${RED}Domain '$parsed_d' already uses port 443 in Nginx. Use a distinct subdomain for port 443.${cRES}"
        else
            target_domain="$parsed_d"
            target_port="$parsed_p"
            break
        fi
    done

    mkdir -p /opt/de_GWD
    [[ ! -f /opt/de_GWD/extra_domains.json ]] && echo '{}' > /opt/de_GWD/extra_domains.json
    jq --arg tag "$in_tag" --arg dom "$target_domain" '.[$tag] = $dom' /opt/de_GWD/extra_domains.json | sponge /opt/de_GWD/extra_domains.json
    chmod 600 /opt/de_GWD/extra_domains.json 2>/dev/null || true
}

removeXrayInbound() {
    local tag="$1"
    local cfg="/opt/de_GWD/vtrui/config.json"
    cp -f "$cfg" "${cfg}.bak" 2>/dev/null || true
    if [[ "$tag" == "inbound-dokodemo" ]]; then
        jq --arg tag "$tag" 'del(.inbounds[] | select(.tag == $tag)) | del(.outbounds[]? | select(.tag == "outbound-dokodemo")) | if (.routing.rules | type) == "array" then .routing.rules |= map(select(.inboundTag != ["inbound-dokodemo"])) else . end' "$cfg" | sponge "$cfg"
    else
        jq --arg tag "$tag" 'del(.inbounds[] | select(.tag == $tag))' "$cfg" | sponge "$cfg"
    fi
    if chgrp www-data "$cfg" 2>/dev/null; then chmod 640 "$cfg"; else chmod 644 "$cfg"; fi
    if [[ "$tag" == "inbound-vless-reality" ]]; then
        rm -f /opt/de_GWD/vtrui/reality.info
    fi
    if [[ -f /opt/de_GWD/extra_domains.json ]]; then
        jq --arg tag "$tag" 'del(.[$tag])' /opt/de_GWD/extra_domains.json | sponge /opt/de_GWD/extra_domains.json 2>/dev/null || true
    fi
    if [[ -f /opt/de_GWD/extra_ports.json ]]; then
        jq --arg tag "$tag" 'del(.[$tag])' /opt/de_GWD/extra_ports.json | sponge /opt/de_GWD/extra_ports.json 2>/dev/null || true
    fi
    removeNginxWebProxy "$tag"
    if /opt/de_GWD/vtrui/vtrui run -test -c "$cfg" >/dev/null 2>&1; then
        systemctl restart vtrui
        rm -f "${cfg}.bak"
        return 0
    else
        mv -f "${cfg}.bak" "$cfg" 2>/dev/null || true
        if chgrp www-data "$cfg" 2>/dev/null; then chmod 640 "$cfg"; else chmod 644 "$cfg"; fi
        systemctl restart vtrui
        return 1
    fi
}

applyXrayInbound() {
    local newInboundJson="$1"
    local tag="$2"
    local extraOutboundJson="${3:-}"
    local extraRuleJson="${4:-}"
    local cfg="/opt/de_GWD/vtrui/config.json"
    local testLog
    cp -f "$cfg" "${cfg}.bak" 2>/dev/null || true
    if [[ -n "$extraOutboundJson" && -n "$extraRuleJson" ]]; then
        jq --arg tag "$tag" --argjson n "$newInboundJson" --argjson o "$extraOutboundJson" --argjson r "$extraRuleJson" '
          del(.inbounds[] | select(.tag == $tag))
          | .inbounds += [$n]
          | .outbounds = ((.outbounds // []) | map(select(.tag != $o.tag)) + [$o])
          | .routing = (.routing // {})
          | .routing.rules = ([$r] + ((.routing.rules // []) | map(select(.inboundTag != [$tag]))))
        ' "$cfg" | sponge "$cfg"
    else
        jq --arg tag "$tag" --argjson n "$newInboundJson" 'del(.inbounds[] | select(.tag == $tag)) | .inbounds += [$n]' "$cfg" | sponge "$cfg"
    fi
    if chgrp www-data "$cfg" 2>/dev/null; then chmod 640 "$cfg"; else chmod 644 "$cfg"; fi

    testLog=$(mktemp /tmp/de_GWD-vtrui-test.XXXXXX)
    if /opt/de_GWD/vtrui/vtrui run -test -c "$cfg" >"${testLog:-/dev/null}" 2>&1; then
        [[ -n "$testLog" ]] && rm -f "$testLog"
        systemctl restart vtrui
        rm -f "${cfg}.bak"
        return 0
    else
        echo -e "${RED}Xray configuration validation failed!${cRES}"
        [[ -n "$testLog" ]] && { cat "$testLog"; rm -f "$testLog"; }
        mv -f "${cfg}.bak" "$cfg" 2>/dev/null || true
        if chgrp www-data "$cfg" 2>/dev/null; then chmod 640 "$cfg"; else chmod 644 "$cfg"; fi
        systemctl restart vtrui
        return 1
    fi
}

