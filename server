  echo -e "${WHITE}SOCKS5 outbound${RED} domain or IP rules are required for non-default exits${cRES}"
  return 1
fi

if [[ $name == "default" ]]; then
  profileJson=$(jq -n --arg name "$name" --arg address "$address" --argjson port "$((10#$port))" \
    --arg username "$username" --arg password "$password" --argjson domains "$domainsJson" \
    --argjson ips "$ipsJson" --argjson privateBypass "$oldPrivateBypass" \
    '{name:$name,enabled:true,server:{address:$address,port:$port,username:$username,password:$password},domains:$domains,ips:$ips,privateBypass:$privateBypass}') || return 1
else
  profileJson=$(jq -n --arg name "$name" --arg address "$address" --argjson port "$((10#$port))" \
    --arg username "$username" --arg password "$password" --argjson domains "$domainsJson" \
    --argjson ips "$ipsJson" \
