count=$(jq -r 'length' <<< "$profiles")
(( count >= 2 )) || {
  echo -e "${WHITE}SOCKS5 outbound${YELLOW} Need at least 2 profiles to adjust priority${cRES}"
  return 0
}

while IFS=$'\t' read -r index name; do
  echo -e "${GREEN}$((index + 1)). $name${cRES}"
done < <(jq -r 'to_entries[] | [.key,.value.profile.name] | @tsv' <<< "$profiles")

read -r -p "Move profile number [1-$count] (0 cancel): " fromNum
fromNum=$(socks5Trim "$fromNum")
[[ -z $fromNum || $fromNum == "0" ]] && return 0
[[ $fromNum =~ ^[1-9][0-9]*$ ]] || { echo -e "${RED}Invalid number${cRES}"; return 1; }
fromIdx=$((10#$fromNum - 1))
(( fromIdx >= 0 && fromIdx < count )) || { echo -e "${RED}Out of range${cRES}"; return 1; }

read -r -p "Move to position [1-$count]: " toNum
toNum=$(socks5Trim "$toNum")
[[ $toNum =~ ^[1-9][0-9]*$ ]] || { echo -e "${RED}Invalid number${cRES}"; return 1; }
toIdx=$((10#$toNum - 1))
(( toIdx >= 0 && toIdx < count )) || { echo -e "${RED}Out of range${cRES}"; return 1; }
(( fromIdx == toIdx )) && return 0

baseProfiles=$(jq -c '[.[].profile]' <<< "$profiles") || return 1
candidate=$(mktemp /tmp/de_GWD-socks5-outbound.XXXXXX) || return 1
jq -n --argjson profiles "$baseProfiles" --argjson from "$fromIdx" --argjson to "$toIdx" '
  ($profiles[$from]) as $item |
  ([range(0; ($profiles | length)) | select(. != $from) | $profiles[.]]) as $rest |
  {profiles: ($rest[0:$to] + [$item] + $rest[$to:])}
' > "$candidate" || { rm -f "$candidate"; return 1; }

if ! socks5OutboundApply "$candidate"; then
  echo -e "${WHITE}SOCKS5 outbound${RED} reorder failed; previous configuration kept${cRES}"
  return 1
fi
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}] Routing priority ${GREEN}updated${cRES}"
}



socks5CurlEscape(){
local s="${1:-}"
s=${s//\\/\\\\}
s=${s//\"/\\\"}
printf '%s' "$s"
}



socks5OutboundTestProfile(){
local profileJson="$1"
local name address port username password endpoint proxyUrl curlCfg out rc=0 rawTime rttMs exitIp exitLoc="" testUrls=() url
name=$(jq -r '.name // "default"' <<< "$profileJson")
address=$(jq -r '.server.address // empty' <<< "$profileJson")
port=$(jq -r 'if (.server.port | type) == "number" or (.server.port | type) == "string" then (.server.port | tostring) else "" end' <<< "$profileJson")
username=$(jq -r '.server.username // empty' <<< "$profileJson")
password=$(jq -r '.server.password // empty' <<< "$profileJson")

if [[ -z $address || -z $port ]]; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}] ${WHITE}$name${cRES}: invalid endpoint"
  return 1
fi
endpoint=$(socks5FormatEndpoint "$address" "$port")
proxyUrl="socks5h://${endpoint}"

curlCfg="proxy = \"$(socks5CurlEscape "$proxyUrl")\""$'\n'
if [[ -n $username ]]; then
  curlCfg+="proxy-user = \"$(socks5CurlEscape "${username}:${password}")\""$'\n'
fi

if [[ -n ${SOCKS5_TEST_URL:-} ]]; then
  testUrls=("$SOCKS5_TEST_URL")
else
  testUrls=("https://www.cloudflare.com/cdn-cgi/trace" "https://api.ip.sb/ip")
fi

for url in "${testUrls[@]}"; do
  out=$(printf '%s' "$curlCfg" | curl -fsSL --connect-timeout 6 --max-time 12 -K - -w '\n__SOCKS5_TIME__:%{time_total}\n' "$url" 2>&1) && rc=0 || rc=$?
  if (( rc == 0 )); then
    rawTime=$(awk -F: '/^__SOCKS5_TIME__:/ {print $2; exit}' <<< "$out")
    rttMs=$(awk -v t="${rawTime:-0}" 'BEGIN {printf "%d", (t + 0) * 1000 + 0.5}')
    exitIp=$(awk -F= '/^ip=/ {print $2; exit}' <<< "$out" | tr -d '\r ')
    exitLoc=$(awk -F= '/^loc=/ {print $2; exit}' <<< "$out" | tr -d '\r ')
    if [[ -z $exitIp ]]; then
      exitIp=$(grep -v '^__SOCKS5_TIME__:' <<< "$out" | awk 'NF {print $1; exit}' | tr -d '\r ')
    fi
    if [[ -n $exitIp ]]; then
      if [[ -n $exitLoc ]]; then
        echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}] ${WHITE}$name${cRES} (${YELLOW}$endpoint${cRES}): IP=${GREEN}$exitIp${cRES} (${CYAN}$exitLoc${cRES}), RTT=${YELLOW}${rttMs}ms${cRES}"
      else
        echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}] ${WHITE}$name${cRES} (${YELLOW}$endpoint${cRES}): IP=${GREEN}$exitIp${cRES}, RTT=${YELLOW}${rttMs}ms${cRES}"
      fi
      return 0
    fi
  fi
done

echo -e "${WHITE}[ ${RED}✕ ${WHITE}] ${WHITE}$name${cRES} (${YELLOW}$endpoint${cRES}): ${RED}connection failed${cRES}"
return 1
}



