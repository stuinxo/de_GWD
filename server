      actualSha=$(sha256sum "$tmpServerNew" 2>/dev/null | awk '{print $1}' | tr 'A-F' 'a-f')
      if [[ "$actualSha" != "$expectedSha" ]]; then
        echo -e "${RED}server checksum verification failed!${cRES}" >&2
        rm -f "$tmpServerNew"
