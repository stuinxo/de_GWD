RproxySsetBase(){
local settings=/opt/de_GWD/RproxyS/settings.json
RproxySensureSettings || return 1
local curPort=$(jq -r '.port // 20000' "$settings")
local curUUID=$(jq -r '.uuid // empty' "$settings")
local newPort newUUID

echo -e "${GREEN}============================ ${cRES}"
echo -e "${GREEN}Modify RproxyS Base Tunnel Settings${cRES}"
echo -e "${GREEN}============================ ${cRES}"
read -r -p "RproxyS tunnel listen port [$curPort]: " newPort
newPort=${newPort:-$curPort}
newPort=${newPort//[[:space:]]/}
[[ $newPort =~ ^[1-9][0-9]{0,4}$ ]] && (( newPort <= 65535 )) || { echo -e "${RED}Invalid port${cRES}"; return 1; }

if jq -e --argjson port "$newPort" 'any(.mapping[]?; .port == $port)' "$settings" >/dev/null 2>&1; then
  echo -e "${RED}Tunnel port conflicts with an existing mapping port ($newPort)${cRES}"
  return 1
fi

read -r -p "RproxyS UUID [$curUUID]: " newUUID
newUUID=${newUUID:-$curUUID}
newUUID=${newUUID//[[:space:]]/}
[[ $newUUID =~ ^[0-9a-fA-F-]{36}$ ]] || { echo -e "${RED}Invalid UUID${cRES}"; return 1; }

local temp=/tmp/RproxyS.settings.$$.base
jq --argjson port "$newPort" --arg uuid "$newUUID" \
  '.port = $port | .uuid = $uuid' "$settings" >"$temp" || { rm -f "$temp"; return 1; }
mv -f "$temp" "$settings"
chmod 600 "$settings"
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Base settings ${GREEN}Updated${cRES}"
if [[ $(systemctl is-active RproxyS 2>/dev/null) = "active" ]]; then
  local applyChoice
  read -r -p "Apply changes to running RproxyS service now? [Y/n]: " applyChoice
  [[ -z "$applyChoice" || "$applyChoice" =~ ^[yY]$ ]] && RproxySapply
else
  echo -e "${YELLOW}Use 1 to apply when ready${cRES}"
fi
}


