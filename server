getHaproxyRules(){
    local rules=()
    if [[ -f "/etc/haproxy/haproxy.cfg" ]]; then
        local ports=($(grep '^# BEGIN_RULE_' /etc/haproxy/haproxy.cfg 2>/dev/null | cut -d_ -f3))
        for p in "${ports[@]}"; do
            local tgt
            tgt=$(awk -v p="$p" '$1=="backend" && $2=="bk_"p {getline; print $3}' /etc/haproxy/haproxy.cfg 2>/dev/null)
            if [[ -n "$tgt" ]]; then
                rules+=("${p}|${tgt}")
            fi
        done
    fi
    echo "${rules[@]}"
}

initHaproxyBase(){
    if [[ ! -f "/etc/haproxy/haproxy.cfg" ]] || ! grep -q 'resolvers local' /etc/haproxy/haproxy.cfg 2>/dev/null; then
        mkdir -p /etc/haproxy
        cat << "EOF" >/etc/haproxy/haproxy.cfg
global
  ulimit-n              500000
  maxconn               200000

defaults
  mode                  tcp
  option                dontlognull
  option                tcp-smart-accept
  option                tcp-smart-connect
  timeout connect       10s
  timeout client        1h
  timeout server        1h
  timeout check         10s

resolvers local
  nameserver            dns1 127.0.0.1:53
  nameserver            dns2 8.8.8.8:53
  nameserver            dns3 1.1.1.1:53
  resolve_retries       3
  timeout retry         3s
  hold valid            10s
  accepted_payload_size 8192

EOF
    fi
}

changeTCPPF(){
    clear 2>/dev/null || true
    echo -e "${GREEN}============ TCP Port Forward (HAProxy) ============ ${cRES}"
    local rules=($(getHaproxyRules))
    local rCount=${#rules[@]}
    if [[ $(systemctl is-active 'haproxy' 2>/dev/null) == "active" && $rCount -gt 0 ]]; then
        echo -e "${GREEN}Status: ${YELLOW}Running (Enabled)${cRES} [${rCount} Active Rules]"
        echo -e "${BLUE}---------------------------------------------------- ${cRES}"
        local idx=1
        for r in "${rules[@]}"; do
            local p="${r%%|*}"
            local tgt="${r##*|}"
            echo -e "  [${idx}] ${WHITE}Local Port: ${YELLOW}:${p}${cRES} -> ${WHITE}Target: ${YELLOW}${tgt}${cRES}"
            ((idx++))
        done
        echo -e "${BLUE}---------------------------------------------------- ${cRES}"
    else
        echo -e "${GREEN}Status: ${RED}Not Running / No Rules Configured${cRES}"
    fi
    echo -e "${GREEN}==================================================== ${cRES}"
    echo -e "${GREEN}[1]: Add / Update Rule${cRES}"
    echo -e "${GREEN}[2]: Delete Rule${cRES}"
    echo -e "${GREEN}[3]: Clear All & Stop${cRES}"
    echo -e "${YELLOW}[0]: Return${cRES}"
    echo -e "${GREEN}==================================================== ${cRES}"
    read -p "Select [0-3]: " tcpPFsw

if [[ "$tcpPFsw" == "1" ]]; then
    echo
    read -p "Enter Target Domain/IP & Port (e.g. 1.2.3.4:443 or hk.example.com:443): " upDomainP
    upDomainP=$(echo "$upDomainP" | tr -d ' ')
    if [[ -z "$upDomainP" ]]; then
        echo -e "${RED}Target address cannot be empty!${cRES}"
        sleep 2s
        return 1
    fi
    if [[ "$upDomainP" != *:* ]]; then
        echo -e "${YELLOW}No port specified, defaulting to 443.${cRES}"
        upDomainP="${upDomainP}:443"
    fi
    upDomain="${upDomainP%%:*}"
    upPort="${upDomainP##*:}"
    if [[ -z "$upDomain" || ! "$upPort" =~ ^[0-9]+$ ]] || [[ "$upPort" -lt 1 || "$upPort" -gt 65535 ]]; then
        echo -e "${RED}Invalid Target Address or Port: $upDomainP${cRES}"
        sleep 2s
        return 1
    fi

    echo
    read -p "Enter Local Listening Port (1-65535): " localP
    localP=$(echo "$localP" | tr -d ' ')
    if [[ ! "$localP" =~ ^[0-9]+$ ]] || [[ "$localP" -lt 1 || "$localP" -gt 65535 ]]; then
        echo -e "${RED}Invalid Local Port: $localP${cRES}"
        sleep 2s
        return 1
    fi

    # Check if this port is already in existing rules
    local existingTgt=""
    for r in "${rules[@]}"; do
        if [[ "${r%%|*}" == "$localP" ]]; then
            existingTgt="${r##*|}"
            break
        fi
    done

    if [[ -n "$existingTgt" ]]; then
        echo -e "${YELLOW}Notice: Local Port ${localP} is currently forwarding to ${existingTgt}.${cRES}"
        read -p "Overwrite with target ${upDomainP}? [y/N]: " confirmUpdate
        if [[ "$confirmUpdate" != [yY] && "$confirmUpdate" != [yY][eE][sS] ]]; then
            echo -e "${YELLOW}Cancelled.${cRES}"
            sleep 1.5s
            return 0
        fi
    else
        conflict=$(ss -tulpn 2>/dev/null | grep -E ":${localP}\s" | grep -v 'haproxy')
        if [[ -n "$conflict" ]]; then
            echo -e "${RED}Port ${localP} is already in use by another service!${cRES}"
            echo -e "$conflict"
            sleep 3s
            return 1
        fi
    fi

    echo -e "${WHITE}[...]\tChecking and installing HAProxy...${cRES}"
    if ! command -v haproxy >/dev/null 2>&1 && [[ ! -x "/usr/sbin/haproxy" ]]; then
        apt-get update -qq && apt-get install -y -q haproxy
    fi

    initHaproxyBase

    # Backup config before editing
    cp -f /etc/haproxy/haproxy.cfg /etc/haproxy/haproxy.cfg.bak 2>/dev/null || true

    # Remove existing rule for localP if any
    sed -i "/# BEGIN_RULE_${localP}/,/# END_RULE_${localP}/d" /etc/haproxy/haproxy.cfg

    # Append new rule
    cat << EOF >>/etc/haproxy/haproxy.cfg
# BEGIN_RULE_${localP}
frontend ft_${localP}
  bind                  :${localP}
  default_backend       bk_${localP}

backend bk_${localP}
  server endpoint ${upDomainP} check resolvers local init-addr none
# END_RULE_${localP}
EOF

    # Validate HAProxy configuration
    if ! /usr/sbin/haproxy -c -q -f /etc/haproxy/haproxy.cfg; then
        echo -e "${RED}HAProxy configuration validation failed! Rolling back...${cRES}"
        /usr/sbin/haproxy -c -f /etc/haproxy/haproxy.cfg
        cp -f /etc/haproxy/haproxy.cfg.bak /etc/haproxy/haproxy.cfg 2>/dev/null || true
        sleep 3s
        return 1
    fi
    rm -f /etc/haproxy/haproxy.cfg.bak 2>/dev/null || true

    # Systemd service drop-in limits override
    mkdir -p /etc/systemd/system/haproxy.service.d
    cat << "EOF" >/etc/systemd/system/haproxy.service.d/override.conf
[Service]
LimitNOFILE=500000
LimitNPROC=200000
EOF
    rm -f /etc/systemd/system/haproxy.service
    systemctl daemon-reload >/dev/null 2>&1
    systemctl enable haproxy >/dev/null 2>&1

    if [[ $(systemctl is-active 'haproxy' 2>/dev/null) == "active" ]]; then
        systemctl reload haproxy
    else
        systemctl restart haproxy
    fi
    sleep 1s

    if [[ $(systemctl is-active 'haproxy') != "active" ]]; then
        echo -e "${RED}HAProxy failed to start!${cRES}"
        systemctl status haproxy --no-pager
        sleep 3s
        return 1
    fi

    domain=$(awk '/server_name/ {print$2;exit}' /etc/nginx/conf.d/default.conf 2>/dev/null | sed 's/.$//')
    [[ -z "$domain" ]] && domain=$(curl -4 -s --connect-timeout 3 ip.sb 2>/dev/null || hostname -I | awk '{print $1}')

    echo
    echo -e "${BLUE}------------------------------------------------ ${cRES}"
    echo -e "${GREEN}TCP Port Forward Rule Saved Successfully!${cRES}"
    echo
    echo -e "${BLUE}Address:       ${YELLOW}$domain:$localP${cRES}"
    echo -e "${BLUE}Target:        ${YELLOW}$upDomainP${cRES}"
    echo -e "${BLUE}TLS SNI:       ${YELLOW}$upDomain${cRES}"
    echo -e "${BLUE}------------------------------------------------ ${cRES}"
    echo
    read -p "Press Enter to return to menu..."

elif [[ "$tcpPFsw" == "2" ]]; then
    if [[ $rCount -eq 0 ]]; then
        echo -e "${YELLOW}No port forward rules configured.${cRES}"
        sleep 1.5s
        return 0
    fi
    echo
    echo -e "${BLUE}Select the rule number [1-${rCount}] or enter Local Port to delete (0 to cancel):${cRES}"
    read -p "Choice: " delChoice
    delChoice=$(echo "$delChoice" | tr -d ' ')
    if [[ "$delChoice" == "0" || -z "$delChoice" ]]; then
        return 0
    fi

    local delPort=""
    if [[ "$delChoice" =~ ^[0-9]+$ ]] && [[ "$delChoice" -ge 1 && "$delChoice" -le "$rCount" ]]; then
        local targetRule="${rules[$((delChoice - 1))]}"
        delPort="${targetRule%%|*}"
    else
        for r in "${rules[@]}"; do
            if [[ "${r%%|*}" == "$delChoice" ]]; then
                delPort="$delChoice"
                break
            fi
        done
    fi

    if [[ -z "$delPort" ]]; then
        echo -e "${RED}Invalid rule choice or port: $delChoice${cRES}"
        sleep 2s
        return 1
    fi

    sed -i "/# BEGIN_RULE_${delPort}/,/# END_RULE_${delPort}/d" /etc/haproxy/haproxy.cfg

    local remRules=($(getHaproxyRules))
    if [[ ${#remRules[@]} -eq 0 ]]; then
        echo -e "${YELLOW}All rules deleted. Disabling HAProxy service...${cRES}"
        systemctl stop haproxy 2>/dev/null || true
        systemctl disable haproxy 2>/dev/null || true
        rm -f /etc/haproxy/haproxy.cfg
        rm -f /etc/systemd/system/haproxy.service.d/override.conf
        systemctl daemon-reload >/dev/null 2>&1
    else
        systemctl reload haproxy 2>/dev/null || systemctl restart haproxy
    fi
    echo
    echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\t${WHITE}Rule for port ${YELLOW}:${delPort}${WHITE} ${GREEN}Deleted${cRES}"
    sleep 1.5s

elif [[ "$tcpPFsw" == "3" ]]; then
    echo
    read -p "Are you sure you want to delete ALL rules and stop HAProxy? [y/N]: " confirmClear
    if [[ "$confirmClear" == [yY] || "$confirmClear" == [yY][eE][sS] ]]; then
        systemctl stop haproxy 2>/dev/null || true
        systemctl disable haproxy 2>/dev/null || true
        rm -f /etc/haproxy/haproxy.cfg
        rm -f /etc/systemd/system/haproxy.service.d/override.conf
        rm -f /etc/systemd/system/haproxy.service
        systemctl daemon-reload >/dev/null 2>&1
        echo
        echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\t${WHITE}All TCP Port Forward rules ${GREEN}Cleared & Stopped${cRES}"
        sleep 1.5s
    fi
fi
}



checkPortAvailable() {
    local targetPort="$1"
    local currentPort="$2"
    local allow443="$3"
    if [[ ! "$targetPort" =~ ^[0-9]+$ ]] || [ "$targetPort" -lt 1 ] || [ "$targetPort" -gt 65535 ]; then
        echo "invalid"
        return 1
    fi
    if [ "$targetPort" -eq 443 ]; then
        if [[ "$allow443" == "true" ]]; then
            echo "ok"
            return 0
        else
            echo "reserved_443"
            return 1
        fi
    fi
    if [[ -n "$currentPort" && "$targetPort" -eq "$currentPort" ]]; then
        echo "ok"
        return 0
    fi
    if ss -tulpn 2>/dev/null | grep -qE "[: ]${targetPort}[ \t]"; then
        echo "in_use"
        return 1
    fi
    echo "ok"
    return 0
}

getXrayInboundPort() {
    local tag="$1"
    jq -r --arg tag "$tag" '.inbounds[] | select(.tag == $tag) | .port' /opt/de_GWD/vtrui/config.json 2>/dev/null | grep -v '^null$' | head -n1
}

getInboundPort() {
    local in_tag="$1"
    local p=""
    if [[ -f /opt/de_GWD/extra_ports.json ]]; then
        p=$(jq -r --arg tag "$in_tag" '.[$tag] // empty' /opt/de_GWD/extra_ports.json 2>/dev/null)
    fi
    if [[ -z "$p" ]]; then
        p=$(getXrayInboundPort "$in_tag")
    fi
    echo "$p"
}

setInboundPort() {
    local in_tag="$1"
    local p="$2"
    mkdir -p /opt/de_GWD
    [[ ! -f /opt/de_GWD/extra_ports.json ]] && echo '{}' > /opt/de_GWD/extra_ports.json
    jq --arg tag "$in_tag" --argjson p "$p" '.[$tag] = $p' /opt/de_GWD/extra_ports.json | sponge /opt/de_GWD/extra_ports.json
    chmod 666 /opt/de_GWD/extra_ports.json 2>/dev/null || true
}

getInternalPort() {
    local pubPort="$1"
    local curTag="${2:-}"
    local intPort=$((pubPort + 10000))
    if [ "$intPort" -gt 65000 ]; then
        intPort=$((10000 + (pubPort % 10000)))
    fi
    while jq -e --arg tag "$curTag" --argjson p "$intPort" '.inbounds[]? | select(.tag != $tag and .port == $p)' /opt/de_GWD/vtrui/config.json >/dev/null 2>&1 || \
          ss -tln 2>/dev/null | grep -qE "127\.0\.0\.1:${intPort}[ \t]"; do
        intPort=$((intPort + 1))
        [[ "$intPort" -gt 65000 ]] && intPort=10001
    done
    echo "$intPort"
}

getNginxConfName() {
    local tag="$1"
    case "$tag" in
        "inbound-vmess-ws") echo "vmess-ws" ;;
        "inbound-vless-ws") echo "vless-ws" ;;
        "inbound-vless-xhttp") echo "vless-xhttp" ;;
        *) echo "${tag#inbound-}" ;;
    esac
}

setupNginxWebProxy() {
    local tag="$1"
    local pubPort="$2"
    local domain="$3"
    local intPort="$4"
    local path="$5"
    local confName=$(getNginxConfName "$tag")
    local connHeaders='        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";'
    if [[ "$tag" == "inbound-vless-xhttp" ]]; then
        connHeaders='        proxy_set_header Connection "";'
    fi

    cat << EOF > "/etc/nginx/conf.d/${confName}.conf"
server {
    listen ${pubPort} ssl;
    listen [::]:${pubPort} ssl;
    http2 on;
    server_name ${domain};
    root /var/www/html;
    index index.html index.htm;
    include /etc/nginx/conf.d/.ssl_certs;

    location /dq {
        proxy_redirect off;
        proxy_pass http://127.0.0.1:9853/dq;
        proxy_http_version 1.1;
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_buffering off;
        proxy_read_timeout 600s;
    }

    location ${path} {
        proxy_redirect off;
        proxy_pass http://127.0.0.1:${intPort};
        proxy_http_version 1.1;
${connHeaders}
        proxy_set_header Host \$host;
        proxy_set_header X-Real-IP \$remote_addr;
        proxy_set_header X-Forwarded-For \$proxy_add_x_forwarded_for;
        proxy_connect_timeout 600s;
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;
        proxy_buffering off;
        proxy_request_buffering off;
        client_max_body_size 0;
        chunked_transfer_encoding off;
    }
}
EOF
    rm -f "/etc/nginx/conf.d/v2_${tag}.conf" 2>/dev/null || true
    nginx -t >/dev/null 2>&1 && systemctl reload nginx
