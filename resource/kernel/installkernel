#!/bin/bash
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'
architecture=$(dpkg --print-architecture)
export DEBIAN_FRONTEND=noninteractive

if systemd-detect-virt --container >/dev/null 2>&1; then
  echo -e "${RED}Containers cannot install custom kernels.${cRES}"
  exit 1
fi
if [[ $architecture != "amd64" ]]; then
  echo -e "${RED}Custom kernel installation only works on amd64.${cRES}"
  exit 1
fi

wait_apt_lock() {
  local waited=0
  while (command -v fuser >/dev/null 2>&1 && fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock /var/cache/apt/archives/lock >/dev/null 2>&1) || pgrep -x 'apt|apt-get|dpkg' >/dev/null 2>&1; do
    if [[ $waited -ge 120 ]]; then
      echo "Timed out waiting for apt/dpkg lock" >&2
      return 1
    fi
    sleep 2
    waited=$((waited + 2))
  done
  dpkg --configure -a
}

prepareKernelEnv() {
cat << EOF >/etc/apt/apt.conf.d/01InstallLess
APT::Get::Assume-Yes "true";
APT::Install-Recommends "false";
APT::Install-Suggests "false";
EOF
cat << EOF >/etc/apt/apt.conf.d/71debconf
Dpkg::Options {
   "--force-confdef";
   "--force-confold";
};
EOF

apt-key del 2FB2CD80 >/dev/null 2>&1 || true
apt-key del 33F8024D >/dev/null 2>&1 || true
apt-key del E734E623 >/dev/null 2>&1 || true
rm -rf /etc/apt/trusted.gpg.d/liquorix-keyring.gpg
rm -rf /usr/share/keyrings/xanmod-kernel-archive-keyring.gpg
rm -rf /etc/apt/sources.list.d/liquorix.list
rm -rf /etc/apt/sources.list.d/xanmod-kernel.list

pkg_status=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 2>/dev/null)
grep -qE '^(ii|rc) +os-prober$' <<< "$pkg_status" && apt remove --purge -y os-prober

unset aptPKG
for pkg in ca-certificates gnupg2 curl python3; do
  grep -qE "^ii +${pkg}$" <<< "$pkg_status" || aptPKG+=("$pkg")
done
[[ -z $(which 'update-grub' 2>/dev/null) ]] && [[ -d "/sys/firmware/efi" ]] && aptPKG+=(grub-efi)
[[ -z $(which 'update-grub' 2>/dev/null) ]] && [[ ! -d "/sys/firmware/efi" ]] && aptPKG+=(grub2-common)

[[ ${#aptPKG[@]} -gt 0 ]] && wait_apt_lock && apt update && apt install -y "${aptPKG[@]}"
mkdir -p /boot/grub
wait_apt_lock

mkdir -p /opt/de_GWD
cat << "EOF" >/etc/rc_kernel.local
#!/bin/bash
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'

mkdir -p /etc/sysctl.d
cat << "SYSCTL_EOF" >/etc/sysctl.d/99-kernel-bbr.conf
net.ipv4.tcp_congestion_control = bbr
net.core.default_qdisc = cake
SYSCTL_EOF
sysctl --system >/dev/null 2>&1 || true

wait_apt_lock() {
  local waited=0
  while (command -v fuser >/dev/null 2>&1 && fuser /var/lib/dpkg/lock-frontend /var/lib/dpkg/lock /var/lib/apt/lists/lock /var/cache/apt/archives/lock >/dev/null 2>&1) || pgrep -x 'apt|apt-get|dpkg' >/dev/null 2>&1; do
    [[ $waited -ge 120 ]] && return 1
    sleep 2
    waited=$((waited + 2))
  done
  dpkg --configure -a
}
wait_apt_lock

curVer=$(uname -r)
fallbackPkg=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'linux-image-[0-9]*' 2>/dev/null | awk -v cur="$curVer" '$1 ~ /^ii/ && $2 ~ /^linux-image-[0-9]/ && index($2, cur) == 0 {print $2}' | sort -rV | head -n 1)
fallbackVer=${fallbackPkg#linux-image-}

dpkg --list | awk '/^ii/ && $2 ~ /^linux-image-[0-9]/ {print $2}' | while read -r line; do
  [[ -n "$curVer" && "$line" == *"$curVer"* ]] && continue
  [[ -n "$fallbackVer" && "$line" == *"$fallbackVer"* ]] && continue
  apt autoremove --purge -y "$line" </dev/null
done

dpkg --list | awk '/^ii/ && $2 ~ /^linux-headers-[0-9]/ {print $2}' | while read -r line; do
  [[ -n "$curVer" && "$line" == *"$curVer"* ]] && continue
  [[ -n "$fallbackVer" && "$line" == *"$fallbackVer"* ]] && continue
  apt autoremove --purge -y "$line" </dev/null
done

update-grub >/dev/null 2>&1 || true

tmpCron=$(mktemp /tmp/de_GWD-cron.XXXXXX)
if [[ -n "$tmpCron" ]]; then
  crontab -l 2>/dev/null >"$tmpCron" || true
  sed -i '/\/etc\/rc_kernel\.local/d' "$tmpCron"
  crontab "$tmpCron"
  rm -f "$tmpCron"
fi
EOF
chmod +x /etc/rc_kernel.local

tmpCron=$(mktemp /tmp/de_GWD-cron.XXXXXX) || exit 1
crontab -l 2>/dev/null >"$tmpCron" || true
sed -i '/\/opt\/de_GWD\/clearKernel/d' "$tmpCron"
sed -i '/\/etc\/rc_kernel.local/d' "$tmpCron"
echo '@reboot sleep 15 && /etc/rc_kernel.local' >>"$tmpCron"
crontab "$tmpCron"
rm -f "$tmpCron"
}




cleanOldKernels() {
  local kernel_type=$1
  
if [[ $kernel_type == "zabbly" ]]; then
  rm -rf /etc/apt/sources.list.d/xanmod-kernel.list
  rm -rf /etc/apt/keyrings/xanmod.gpg
  rm -rf /etc/apt/sources.list.d/liquorix-kernel.list
  rm -rf /etc/apt/keyrings/liquorix.gpg
elif [[ $kernel_type == "xanmod" ]]; then
  rm -rf /etc/apt/sources.list.d/zabbly-kernel.list
  rm -rf /etc/apt/keyrings/zabbly.asc
  rm -rf /etc/apt/sources.list.d/liquorix-kernel.list
  rm -rf /etc/apt/keyrings/liquorix.gpg
elif [[ $kernel_type == "liquorix" ]]; then
  rm -rf /etc/apt/sources.list.d/zabbly-kernel.list
  rm -rf /etc/apt/keyrings/zabbly.asc
  rm -rf /etc/apt/sources.list.d/xanmod-kernel.list
  rm -rf /etc/apt/keyrings/xanmod.gpg
fi
  
  local curVer fallbackPkg fallbackVer
  curVer=$(uname -r)
  fallbackPkg=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'linux-image-[0-9]*' 2>/dev/null | awk -v cur="$curVer" -v kt="$kernel_type" '$1 ~ /^ii/ && $2 ~ /^linux-image-[0-9]/ && index($2, cur) == 0 && index($2, kt) == 0 {print $2}' | sort -rV | head -n 1)
  fallbackVer=${fallbackPkg#linux-image-}

  dpkg --list | awk '/^ii/ && $2 ~ /^linux-image-[0-9]/ {print $2}' | grep -Fv "$kernel_type" | while read -r line; do
    [[ -n "$curVer" && "$line" == *"$curVer"* ]] && continue
    [[ -n "$fallbackVer" && "$line" == *"$fallbackVer"* ]] && continue
    apt autoremove --purge -y "$line" </dev/null
  done

  dpkg --list | awk '/^ii/ && $2 ~ /^linux-headers-[0-9]/ {print $2}' | grep -Fv "$kernel_type" | while read -r line; do
    [[ -n "$curVer" && "$line" == *"$curVer"* ]] && continue
    [[ -n "$fallbackVer" && "$line" == *"$fallbackVer"* ]] && continue
    apt autoremove --purge -y "$line" </dev/null
  done
  
  apt autoremove --purge -y && apt clean -y && apt autoclean -y
  
  update-initramfs -u -k all
  update-grub
}



