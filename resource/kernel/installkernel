installLiquorix(){
echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Liquorix kernel${cRES}\r\c"
if [[ $architecture != "amd64" ]]; then
  echo -e "${RED}only work on x86_64${cRES}"
elif [[ $architecture == "amd64" ]]; then
prepareKernelEnv
mkdir -p /etc/apt/keyrings
liquorixKeyTmp=$(mktemp /tmp/liquorix.gpg.key.XXXXXX) || return 1
if ! curl -fsSLo "$liquorixKeyTmp" https://liquorix.net/liquorix-keyring.gpg || [[ ! -s "$liquorixKeyTmp" ]]; then
  rm -f "$liquorixKeyTmp"
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Liquorix keyring download failed${cRES}"
  exit 1
fi
gpg --dearmor --yes -o /etc/apt/keyrings/liquorix.gpg "$liquorixKeyTmp"
rm -f "$liquorixKeyTmp"
echo "deb [signed-by=/etc/apt/keyrings/liquorix.gpg] https://liquorix.net/debian $(. /etc/os-release && echo "${VERSION_CODENAME:-trixie}") main" >/etc/apt/sources.list.d/liquorix-kernel.list

if wait_apt_lock && apt update && apt install -y linux-image-liquorix-amd64 linux-headers-liquorix-amd64 && [[ -n $(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 'linux-image-*' 2>/dev/null | awk '/^ii / && /liquorix/') ]]; then
  cleanOldKernels "liquorix"

  echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Liquorix kernel${cRES}"
  reboot
  exit
else
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}Liquorix kernel ${RED}Install Failed${cRES}"

  dpkg --list | awk '{print $2}' | grep liquorix | while read -r line; do
    apt autoremove --purge -y "$line" </dev/null
  done

  rm -rf /etc/apt/sources.list.d/liquorix-kernel.list
  rm -rf /etc/apt/keyrings/liquorix.gpg
  echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${YELLOW}Clear up & Exit${cRES}"
  exit 1
fi
fi
}



echo -e "${GREEN}======================================== ${cRES}"
