get_cpu_arch_level() {
    local flags_line r
    flags_line=$(awk -F: '/^flags/{print $2; exit}' /proc/cpuinfo)

    has_all_flags() {
        for r in "$@"; do
            [[ " $flags_line " == *" $r "* ]] || return 1
        done
    }

    CPU_LEVEL="v1"
    if has_all_flags cx16 lahf_lm popcnt sse4_1 sse4_2 ssse3; then
        CPU_LEVEL="v2"
        if has_all_flags avx avx2 bmi1 bmi2 f16c fma abm movbe xsave; then
            CPU_LEVEL="v3"
        fi
    fi
}



