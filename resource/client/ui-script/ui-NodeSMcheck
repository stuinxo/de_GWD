#!/bin/bash
# ui-NodeSMcheck: Check current node assignment for Predefined Services in JSON format

jq -nc --slurpfile conf /opt/de_GWD/0conf --slurpfile xray /opt/de_GWD/vtrui/config.json '
  ($conf[0] // {}) as $c |
  ($xray[0] // {}) as $x |
  ($c.v2node // []) as $nodes |
  def find_outbound($tag):
    [$x.outbounds[]? | select(.tag == $tag)][0];
  def node_addr($ob):
    if ($ob == null) then ""
    else
      ($ob.settings.vnext[0].address // "") as $d |
      ($ob.settings.vnext[0].port // 443 | tostring) as $p |
      if $d == "" then ""
      elif ($p == "443" or $p == "") then $d
      else "\($d):\($p)"
      end
    end;
  def match_node($ob; $default_name):
    node_addr($ob) as $addr |
    if $addr == "" then {num: 0, name: $default_name}
    else
      ($ob.settings.vnext[0].users[0].id // "") as $uuid |
      ([ $nodes | to_entries[]? | select(.value.domain == $addr and ($uuid == "" or .value.uuid == $uuid)) ][0]
       // [ $nodes | to_entries[]? | select(.value.domain == $addr) ][0]) as $m |
      if $m == null then {num: 0, name: $default_name}
      else {num: ($m.key + 1), name: (if ($m.value.name // "") != "" then $m.value.name else $addr end)}
      end
    end;
  (["openai","claude","gemini","grok","youtube","netflix","hdh","bahamut","tvb","telegram","twitter","discord","reddit","github","wikipedia"]
   | map({ (.): match_node(find_outbound("nodeSM" + .); "-none-") })
   | add)
  + {
    apple: match_node(find_outbound("nodeSMapple"); "直连"),
    steam: (if ($c.v2nodeDIV.nodeSM.steam // "") == "proxy" then {num: 1, name: "默认代理"} else {num: 0, name: "直连"} end)
  }
' 2>/dev/null || echo '{"openai":{"num":0,"name":"-none-"},"claude":{"num":0,"name":"-none-"},"gemini":{"num":0,"name":"-none-"},"grok":{"num":0,"name":"-none-"},"youtube":{"num":0,"name":"-none-"},"netflix":{"num":0,"name":"-none-"},"hdh":{"num":0,"name":"-none-"},"bahamut":{"num":0,"name":"-none-"},"tvb":{"num":0,"name":"-none-"},"telegram":{"num":0,"name":"-none-"},"twitter":{"num":0,"name":"-none-"},"discord":{"num":0,"name":"-none-"},"reddit":{"num":0,"name":"-none-"},"github":{"num":0,"name":"-none-"},"wikipedia":{"num":0,"name":"-none-"},"apple":{"num":0,"name":"直连"},"steam":{"num":0,"name":"直连"}}'
