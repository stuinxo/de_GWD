#!/bin/bash
domain=$(jq -r '.update.v2node.domain' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
tls=$(jq -r '.update.v2node.tls' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
port=$(jq -r '.update.v2node.port' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
uuid=$(jq -r '.update.v2node.uuid' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
path=$(jq -r '.update.v2node.path' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')

[[ -z "$port" ]] && port="443"
[[ -z "$tls" ]] && tls="$domain"

uuid_to_path() {
    local u="$1"
    local first="${u%%-*}"
    printf '/%s' "$first"
}

if [[ -z "$path" ]]; then
    path=$(uuid_to_path "$uuid")
fi
[[ "${path:0:1}" != "/" ]] && path="/$path"

build_vless_xhttp_outbound() {
    local o_tag="$1"
    local o_domain="$2"
    local o_port="$3"
    local o_uuid="$4"
    local o_tls="$5"
    local o_path="$6"
    local o_mark="${7:-255}"

    cat << EOF
{
  "tag": "$o_tag",
  "protocol": "vless",
  "settings": {
    "vnext": [
      {
        "address": "$o_domain",
        "port": $o_port,
        "users": [
          {
            "id": "$o_uuid",
            "encryption": "none"
          }
        ]
      }
    ]
  },
  "streamSettings": {
    "network": "xhttp",
    "security": "tls",
    "tlsSettings": {
      "serverName": "$o_tls",
      "alpn": ["h2"],
      "allowInsecure": false
    },
    "xhttpSettings": {
      "path": "$o_path",
      "mode": "packet-up"
    },
    "sockopt": {
      "mark": $o_mark,
      "tcpFastOpen": true,
      "tcpNoDelay": true
    }
  }
}
EOF
}

OBdefault=$(build_vless_xhttp_outbound "default" "$domain" "$port" "$uuid" "$tls" "$path" 255)

jq --argjson OBdefault "$OBdefault" '.outbounds[0]=$OBdefault' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json

if [[ "$domain" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]; then
    nodeIP="$domain"
else
    nodeIP=$(dig @127.0.0.1 "$domain" -4p 5332 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | tail -n 1)
    [[ -z "$nodeIP" ]] && nodeIP=$(dig @223.5.5.5 "$domain" +tcp +time=2 +tries=1 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | tail -n 1)
    [[ -z "$nodeIP" ]] && nodeIP=$(dig @127.0.0.1 "$domain" -4p 5331 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | tail -n 1)
    [[ -z "$nodeIP" ]] && nodeIP=$(getent ahostsv4 "$domain" 2>/dev/null | awk '{print $1}' | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | head -n 1)
fi
[[ -n "$nodeIP" ]] && nft add element ip de_GWD V2NODE { "$nodeIP" } 2>/dev/null || true

systemctl restart vtrui
