#!/bin/bash
source /opt/de_GWD/xray-common
source /opt/de_GWD/ui-confCommon

conf_jq 'if (.v2nodeDIV.ss | type) == "object" then .v2nodeDIV.ss.status="off" else . end'

domain=$(jq -r '.update.v2node.domain' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
tls=$(jq -r '.update.v2node.tls' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
port=$(jq -r '.update.v2node.port' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
uuid=$(jq -r '.update.v2node.uuid' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
path=$(jq -r '.update.v2node.path' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')

[[ -z "$domain" || -z "$uuid" ]] && exit 0

[[ -z "$port" ]] && port="443"
[[ -z "$tls" ]] && tls="$domain"
if [[ -z "$path" ]]; then
    path=$(uuid_to_path "$uuid")
fi
[[ "${path:0:1}" != "/" ]] && path="/$path"

OBdefault=$(build_vless_xhttp_outbound "default" "$domain" "$port" "$uuid" "$tls" "$path" 255) || exit 1

xray_cfg_jq --argjson OBdefault "$OBdefault" '.outbounds[0]=$OBdefault' || exit 1

/opt/de_GWD/ui-NodeSave >/dev/null 2>&1 || true

systemctl restart vtrui
