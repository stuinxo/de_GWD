#!/bin/bash
clear
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'
dockerComposeVer_reserved="v2.32.4"



installDocker(){
mkdir -p /usr/share/keyrings
rm -f /usr/share/keyrings/docker-ce-archive-keyring.gpg
curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor --yes -o /usr/share/keyrings/docker-archive-keyring.gpg
[[ ! -s /usr/share/keyrings/docker-archive-keyring.gpg ]] && curl -fsSL https://mirrors.ustc.edu.cn/docker-ce/linux/debian/gpg | gpg --dearmor --yes -o /usr/share/keyrings/docker-archive-keyring.gpg
echo "deb [arch=$(dpkg --print-architecture) signed-by=/usr/share/keyrings/docker-archive-keyring.gpg] https://download.docker.com/linux/debian $(. /etc/os-release && echo "${VERSION_CODENAME:-trixie}") stable" >/etc/apt/sources.list.d/docker.list

pkg_status=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 2>/dev/null)
unset aptPKG
for pkg in docker-ce docker-ce-cli containerd.io docker-compose-plugin; do
  grep -qE "^ii +${pkg}$" <<< "$pkg_status" || aptPKG+=("$pkg")
done
[[ ${#aptPKG[@]} -gt 0 ]] && apt update && apt install -y "${aptPKG[@]}"

pkg_status=$(dpkg-query -W -f='${db:Status-Abbrev} ${Package}\n' 2>/dev/null)
if grep -qE '^ii +docker-ce$' <<< "$pkg_status" && grep -qE '^ii +containerd\.io$' <<< "$pkg_status"; then
mkdir -p /etc/docker/
systemctl stop docker containerd
if [[ -s /etc/docker/daemon.json ]] && jq empty /etc/docker/daemon.json >/dev/null 2>&1; then
  jq '.iptables = false' /etc/docker/daemon.json | sponge /etc/docker/daemon.json
else
  cat << EOF >/etc/docker/daemon.json
{
  "iptables": false
}
EOF
fi
systemctl restart docker
fi

if [[ ! -x /usr/local/bin/docker-compose ]] && command -v docker >/dev/null 2>&1 && docker compose version >/dev/null 2>&1; then
  printf '%s\n' '#!/bin/sh' 'exec docker compose "$@"' >/usr/local/bin/docker-compose
  chmod +x /usr/local/bin/docker-compose
elif [[ ! -x /usr/local/bin/docker-compose ]]; then
  dockerComposeVer=$(curl -fsSL --connect-timeout 5 -m 10 "https://api.github.com/repos/docker/compose/releases/latest" 2>/dev/null | jq -r .tag_name | grep -v '^null$')
  [[ -z "$dockerComposeVer" ]] && dockerComposeVer="$dockerComposeVer_reserved"
  dcAsset="docker-compose-$(uname -s)-$(uname -m)"
  dcUrl="https://github.com/docker/compose/releases/download/$dockerComposeVer/$dcAsset"
  dcSha=$(curl -fsSL --connect-timeout 5 -m 10 "${dcUrl}.sha256" 2>/dev/null | awk '{print $1}' | tr 'A-F' 'a-f')
  tmpDc=$(mktemp /tmp/de_GWD-dc.XXXXXX)
  if [[ -n "$tmpDc" ]] && curl -fsSL "$dcUrl" -o "$tmpDc"; then
    if [[ "$dcSha" =~ ^[0-9a-f]{64}$ ]]; then
      actualDcSha=$(sha256sum "$tmpDc" 2>/dev/null | awk '{print $1}' | tr 'A-F' 'a-f')
      if [[ "$actualDcSha" != "$dcSha" ]]; then
        rm -f "$tmpDc"
        echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}docker-compose checksum mismatch${cRES}"
        return 1
      fi
    fi
    mv -f "$tmpDc" /usr/local/bin/docker-compose
    chmod +x /usr/local/bin/docker-compose
  else
    rm -f "$tmpDc"
  fi
fi

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Install Docker${cRES}"
}



uninstallDocker(){
rm -rf /etc/apt/sources.list.d/docker.list
apt remove --purge docker-ce docker-ce-cli containerd.io
rm -rf /usr/local/bin/docker-compose

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Uninstall Docker${cRES}"
}



start_menu(){
    echo -e "${GREEN}=============================== ${cRES}"
    echo -e "${GREEN}         Docker${cRES}"
    echo -e "${GREEN}=============================== ${cRES}"
    echo -e "${GREEN}1. Install Docker${cRES}"
   echo -e "${YELLOW}2. Uninstall Docker${cRES}"
    echo ""
    read -p "Select:" num
    case "$num" in
    1)
    installDocker
    start_menu
    ;;
    2)
    uninstallDocker
    start_menu
    ;;
    *)
    clear
    echo -e "${RED}Wrong number${cRES}"
    sleep 1s
    start_menu
    ;;
    esac
}

start_menu
