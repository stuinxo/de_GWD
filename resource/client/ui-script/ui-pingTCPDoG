#!/bin/bash
pingTCPDoG=$(jq -r '.dns.dog // empty' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
pingTCPDoG="${pingTCPDoG#*//}"
pingTCPDoG=$(printf '%s' "$pingTCPDoG" | cut -d/ -f1 | tr -d '[:space:]')
[[ -n "$pingTCPDoG" ]] || exit 0
echo "$(curl -o /dev/null -m 5 -kIsw '%{time_connect}\n' "https://$pingTCPDoG") * 1000" | bc | awk '{printf ("%.0f\n",$1)}'
