#!/bin/bash
source /opt/de_GWD/xray-common

FWD1port=$(jq -r '.FORWARD.FWD1.port' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
FWD1uuid=$(jq -r '.FORWARD.FWD1.uuid[].FWD1uuid' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
FWD1upstream=$(jq -r '.FORWARD.FWD1.upstream' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
FWD1path=$(jq -r '.FORWARD.FWD1.path' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')

rm -rf /opt/de_GWD/vtrui1
mkdir -p /opt/de_GWD/vtrui1
cp -f /opt/de_GWD/vtrui/vtrui /opt/de_GWD/vtrui1/vtrui1
chmod +x /opt/de_GWD/vtrui1/vtrui1

# If FWD1path is not set, initialize it from the first UUID's prefix and persist
if [[ -z "$FWD1path" ]]; then
    first_uuid=$(echo "$FWD1uuid" | head -n1)
    if [[ -n "$first_uuid" ]]; then
        FWD1path=$(uuid_to_path "$first_uuid")
        jq --arg path "$FWD1path" '.FORWARD.FWD1.path=$path' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
        chown root:www-data /opt/de_GWD/0conf 2>/dev/null || true
        chmod 660 /opt/de_GWD/0conf
    else
        FWD1path="/fwd1"
    fi
fi
[[ "${FWD1path:0:1}" != "/" ]] && FWD1path="/$FWD1path"

v2nodeID=$(jq -r --arg FWD1upstream "$FWD1upstream" '.v2node | to_entries[] | select(.value.domain == $FWD1upstream) | .key' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$' | head -n1)

if [[ -n "$v2nodeID" ]]; then
    address=$(jq -r --argjson v2nodeID "$v2nodeID" '.v2node[$v2nodeID].domain' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
    tls=$(jq -r --argjson v2nodeID "$v2nodeID" '.v2node[$v2nodeID].tls' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
    uuid=$(jq -r --argjson v2nodeID "$v2nodeID" '.v2node[$v2nodeID].uuid' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
    upstream_path=$(jq -r --argjson v2nodeID "$v2nodeID" '.v2node[$v2nodeID].path' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
fi
domain=$(echo "$address" | cut -d: -f1)
port=$(echo "$address" | cut -d: -f2 | grep '^[[:digit:]]*$')
[[ -z "$port" ]] && port="443"
[[ -z "$tls" ]] && tls="$domain"

if [[ -z "$upstream_path" ]]; then
    upstream_path=$(uuid_to_path "$uuid")
fi
[[ "${upstream_path:0:1}" != "/" ]] && upstream_path="/$upstream_path"

# Build inbound clients JSON
clients_json="[]"
for u in $FWD1uuid; do
    clients_json=$(jq --arg id "$u" '. += [{"id": $id}]' <<< "$clients_json")
done

FWD1in=$(build_vless_xhttp_inbound_direct_tls "$FWD1port" "$clients_json" "$FWD1path" "/var/www/ssl/de_GWD.cer" "/var/www/ssl/de_GWD.key" "forward1")

cat << EOF >/opt/de_GWD/vtrui1/config.json
{
  "log": {
    "access": "none",
    "error": "none",
    "loglevel": "none"
  },
  "dns": {
    "tag": "dnsflow",
    "queryStrategy": "UseIP",
    "disableCache": true,
    "servers": ["tcp+local://127.0.0.1:53"]
  },
  "routing": {
    "rules": []
  },
  "inbounds": [
    $FWD1in
  ]
}
EOF

OBfwd=$(build_vless_xhttp_outbound "fwd1-outbound" "$domain" "$port" "$uuid" "$tls" "$upstream_path" 255)

OBdir=$(cat << EOF
{
  "tag": "direct",
  "protocol": "freedom",
  "streamSettings": {
    "sockopt": {
      "mark": 255,
      "tcpFastOpen": true
    }
  }
}
EOF
)

jq '.outbounds=[]' /opt/de_GWD/vtrui1/config.json |\
jq --argjson OBfwd "$OBfwd" '.outbounds += [$OBfwd]' |\
jq --argjson OBdir "$OBdir" '.outbounds += [$OBdir]' | sponge /opt/de_GWD/vtrui1/config.json

chown root:www-data /opt/de_GWD/vtrui1/config.json 2>/dev/null || true
chmod 640 /opt/de_GWD/vtrui1/config.json 2>/dev/null || true
chmod 644 /var/www/ssl/*.key 2>/dev/null || true

rm -rf /lib/systemd/system/vtrui1.service
cat << "EOF" >/etc/systemd/system/vtrui1.service
[Unit]
Description=vtrui1
After=network.target nss-lookup.target

[Service]
User=root
Type=simple
ExecStart=/opt/de_GWD/vtrui1/vtrui1 run -config /opt/de_GWD/vtrui1/config.json
Restart=always
RestartSec=2
TimeoutStopSec=5

Nice=-9
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_NET_BIND_SERVICE
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
EOF

systemctl daemon-reload >/dev/null
systemctl restart vtrui1
if [[ $? -ne 0 ]]; then
    sed -i '/Nice=/d' /etc/systemd/system/vtrui1.service
    systemctl daemon-reload >/dev/null
    systemctl restart vtrui1
fi
systemctl enable vtrui1 >/dev/null 2>&1
