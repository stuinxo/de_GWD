#!/bin/bash
source "$(dirname "$0")/ui-confCommon" 2>/dev/null || source /opt/de_GWD/ui-confCommon

sprivatekey=$(wg genkey) || exit 1
spublickey=$(printf '%s\n' "$sprivatekey" | wg pubkey) || exit 1
[[ -n "$sprivatekey" && -n "$spublickey" ]] || exit 1

conf_jq --arg sprivatekey "$sprivatekey" --arg spublickey "$spublickey" \
  '.wireguard.server.sprivatekey=$sprivatekey | .wireguard.server.spublickey=$spublickey'
