#!/bin/bash
PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
source "$(dirname "$0")/ui-confCommon" 2>/dev/null || source /opt/de_GWD/ui-confCommon

ethernetnum=$(ip -4 route show default 2>/dev/null | awk '{for(i=1;i<=NF;i++) if($i=="dev"){print $(i+1); exit}}' | grep -vE '^(lo|docker|veth|br-|wg|ifb|tun|tap)')
if [[ -z "$ethernetnum" && -d /sys/class/net ]]; then
  for iface in /sys/class/net/*; do
    [[ -e "$iface" ]] || continue
    iface=${iface##*/}
    case "$iface" in
      lo|docker*|veth*|br-*|wg*|ifb*|tun*|tap*) continue ;;
    esac
    ethernetnum="$iface"
    break
  done
fi
ethernetnum="${ethernetnum%%:*}"
ethernetnum="${ethernetnum%%@*}"

gatewayaddr=$(jq -r '.address.upstreamIP // empty' "$GWD_CONF_FILE" | grep -Eo '([0-9]{1,3}\.){3}[0-9]{1,3}' | head -n 1)
localAddrCIDR=$(jq -r '.address.localIP // empty' "$GWD_CONF_FILE" 2>/dev/null | grep -v '^null$' | tr -d '[:space:]')
localAddr=$(echo "$localAddrCIDR" | cut -d/ -f1 | grep -Eo '^([0-9]{1,3}\.){3}[0-9]{1,3}$')
netmask=$(echo "$localAddrCIDR" | sed -E 's#^([0-9]{1,3}\.){3}[0-9]{1,3}##')

[[ ! "$netmask" =~ ^/([0-9]|[12][0-9]|3[0-2])$ ]] && netmask="/24"
localAddrCIDR="${localAddr}${netmask}"

if [[ -n "$ethernetnum" && -n "$localAddr" && -n "$gatewayaddr" ]]; then
cat << EOF >/etc/network/interfaces
source /etc/network/interfaces.d/*

auto lo
iface lo inet loopback

auto $ethernetnum
iface $ethernetnum inet static
    address $localAddrCIDR
    gateway $gatewayaddr
EOF
conf_jq --arg localAddrCIDR "$localAddrCIDR" '.address.localIP=$localAddrCIDR'
fi

sleep 1
systemctl reboot 2>/dev/null || reboot
