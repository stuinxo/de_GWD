#!/bin/bash
tag="custom"

jq 'del(.outbounds[] | select(.tag == "custom"))' /opt/de_GWD/vtrui/config.json |\
jq 'del(.routing.rules[] | select(.outboundTag == "custom"))' | sponge /opt/de_GWD/vtrui/config.json

if [[ -n $2 ]]; then
address=$(jq -r --argjson nodecheck "$2" '.v2node | to_entries[] | select(.key == $nodecheck) | .value.domain // empty' /opt/de_GWD/0conf)
tls=$(jq -r --argjson nodecheck "$2" '.v2node | to_entries[] | select(.key == $nodecheck) | .value.tls // empty' /opt/de_GWD/0conf)
uuid=$(jq -r --argjson nodecheck "$2" '.v2node | to_entries[] | select(.key == $nodecheck) | .value.uuid // empty' /opt/de_GWD/0conf)
path=$(jq -r --argjson nodecheck "$2" '.v2node | to_entries[] | select(.key == $nodecheck) | .value.path // empty' /opt/de_GWD/0conf)
/opt/de_GWD/ui-V2outbound "$tag" "$address" "$tls" "$uuid" "$path"

source "$(dirname "$0")/ui-confCommon" 2>/dev/null || source /opt/de_GWD/ui-confCommon
conf_jq --arg address "$address" '.v2nodeDIV.nodeCU.address=$address'
else
address=$(jq -r '.v2nodeDIV.nodeCU.address' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
	if [[ -n $address ]]; then
		tls=$(jq -r --arg nodecheck "$address" '.v2node | to_entries[] | select(.value.domain == $nodecheck) | .value.tls // empty' /opt/de_GWD/0conf)
		uuid=$(jq -r --arg nodecheck "$address" '.v2node | to_entries[] | select(.value.domain == $nodecheck) | .value.uuid // empty' /opt/de_GWD/0conf)
		path=$(jq -r --arg nodecheck "$address" '.v2node | to_entries[] | select(.value.domain == $nodecheck) | .value.path // empty' /opt/de_GWD/0conf)
		/opt/de_GWD/ui-V2outbound "$tag" "$address" "$tls" "$uuid" "$path"
	fi
fi

tmpRoutingDomain=$(mktemp /tmp/routingDomain.XXXXXX) || exit 1
tmpRoutingIP=$(mktemp /tmp/routingIP.XXXXXX) || exit 1
trap 'rm -f "$tmpRoutingDomain" "$tmpRoutingIP"' EXIT

jq -r '.v2nodeDIV.nodeCU.rulesDomain[]' "$GWD_CONF_FILE" 2>/dev/null | grep -v '^null$' >"$tmpRoutingDomain"
jq -r '.v2nodeDIV.nodeCU.rulesIP[]' "$GWD_CONF_FILE" 2>/dev/null | grep -v '^null$' >"$tmpRoutingIP"
routingDomain=$(jq -R -s -c 'split("\n")[:-1]' < "$tmpRoutingDomain")
routingIP=$(jq -R -s -c 'split("\n")[:-1]' < "$tmpRoutingIP")

[[ -n $(cat "$tmpRoutingDomain") ]] && /opt/de_GWD/ui-V2routingDomain "$tag" "$routingDomain"
[[ -n $(cat "$tmpRoutingIP") ]] && /opt/de_GWD/ui-V2routingIP "$tag" "$routingIP"

conf_jq '.v2nodeDIV.nodeCU.status="on"'

[[ $1 = "r" ]] && systemctl restart vtrui >/dev/null
rm -f "$tmpRoutingDomain" "$tmpRoutingIP"
