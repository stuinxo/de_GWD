#!/bin/bash
i=$1
[[ "$i" =~ ^[0-9]+$ ]] || exit 1
source "$(dirname "$0")/ui-confCommon" 2>/dev/null || source /opt/de_GWD/ui-confCommon

cprivatekey=$(wg genkey) || exit 1
cpublickey=$(printf '%s\n' "$cprivatekey" | wg pubkey) || exit 1
[[ -n "$cprivatekey" && -n "$cpublickey" ]] || exit 1

conf_jq --argjson i "$i" --arg cprivatekey "$cprivatekey" --arg cpublickey "$cpublickey" \
  '.wireguard.clients[$i].cprivatekey=$cprivatekey | .wireguard.clients[$i].cpublickey=$cpublickey'

printf '%s\n' "$cprivatekey"
printf '%s\n' "$cpublickey"
