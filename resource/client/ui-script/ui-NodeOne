#!/bin/bash
tag="default"
domain=$(jq -r '.update.v2node.domain' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
port=$(jq -r '.update.v2node.port' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
tls=$(jq -r '.update.v2node.tls' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
uuid=$(jq -r '.update.v2node.uuid' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
path=$(jq -r '.update.v2node.path' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')

address="$domain:$port"

cat << EOF >/opt/de_GWD/vtrui/config.json
{
"log": {
  "access":"none",
  "error":"none",
  "loglevel":"none"
},
"dns":{
  "tag":"dnsflow",
  "queryStrategy":"UseIP",
  "disableCache":true,
  "servers":["tcp+local://127.0.0.1:53"]
},
"routing":{
  "domainMatcher": "hybrid",
  "domainStrategy": "AsIs",
  "rules":[
      {
        "type": "field",
        "ip": [
          "geoip:private"
        ],
        "network": "tcp,udp",
        "outboundTag": "direct"
      }
  ]
},
"inbounds":[
  {
    "port":9896,
    "listen":"127.0.0.1",
    "protocol":"dokodemo-door",
    "settings":{"network":"tcp,udp","followRedirect":true},
    "streamSettings":{"sockopt":{"tproxy":"tproxy","mark":255,"tcpFastOpen":false,"tcpMptcp":true}},
    "sniffing":{"enabled":true,"destOverride":["http","tls","quic"],"routeOnly":true,"metadataOnly":false}
  }
]
}
EOF

/opt/de_GWD/ui-V2outbound "$tag" "$address" "$tls" "$uuid" "$path"

source "$(dirname "$0")/xray-common" 2>/dev/null || source /opt/de_GWD/xray-common
OBdirect=$(build_freedom_direct_outbound "direct" 255) || exit 1
xray_cfg_jq --argjson OBdirect "$OBdirect" '.outbounds+=[$OBdirect]'

if [[ $(jq -r '.FORWARD.FWD0.status' /opt/de_GWD/0conf 2>/dev/null) = "on" ]];then
  /opt/de_GWD/ui-FWD0save >/dev/null 2>&1
fi

if [[ -s /opt/de_GWD/extra_inbounds.json ]]; then
  xray_cfg_jq --slurpfile extra /opt/de_GWD/extra_inbounds.json '
    ($extra[0] // []) as $list |
    reduce $list[] as $inb (.; del(.inbounds[] | select(.tag == $inb.tag)) | .inbounds += [$inb])
  '
  if jq -e 'any(.inbounds[]?; .tag == "inbound-dokodemo")' /opt/de_GWD/vtrui/config.json >/dev/null 2>&1; then
    OBdokodemo=$(build_freedom_direct_outbound "outbound-dokodemo" 255) || exit 1
    xray_cfg_jq --argjson od "$OBdokodemo" 'del(.outbounds[]? | select(.tag == "outbound-dokodemo")) | .outbounds += [$od] | del(.routing.rules[]? | select(.inboundTag == ["inbound-dokodemo"])) | .routing.rules = [{"type":"field","inboundTag":["inbound-dokodemo"],"outboundTag":"outbound-dokodemo"}] + (.routing.rules // [])'
  fi
fi

if [[ -d /opt/de_GWD/nftables ]]; then
  >/opt/de_GWD/nftables/IP_listBlan
  >/opt/de_GWD/nftables/IP_listWlan
  nft flush set ip de_GWD listBlan 2>/dev/null || true
  nft flush set ip de_GWD listWlan 2>/dev/null || true
  cat << 'EOF' >/opt/de_GWD/nftables/SET_listBlan.nft
#!/usr/sbin/nft -f
table ip de_GWD {
        set listBlan {
                type ipv4_addr
                flags interval
                auto-merge
        }
}
EOF
  cat << 'EOF' >/opt/de_GWD/nftables/SET_listWlan.nft
#!/usr/sbin/nft -f
table ip de_GWD {
        set listWlan {
                type ipv4_addr
                flags interval
                auto-merge
        }
}
EOF
  chmod +x /opt/de_GWD/nftables/SET_listBlan.nft /opt/de_GWD/nftables/SET_listWlan.nft 2>/dev/null || true
fi


if [[ $1 = "f" ]]; then
  source "$(dirname "$0")/ui-confCommon" 2>/dev/null || source /opt/de_GWD/ui-confCommon
  conf_jq '.v2nodeDIV.nodeCU.status="off" | .v2nodeDIV.nodeDT.status="off" | if (.v2nodeDIV.ss | type) == "object" then .v2nodeDIV.ss.status="off" else . end'
fi

if [[ $2 = "r" ]]; then
  systemctl restart vtrui
fi
