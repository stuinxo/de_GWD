#!/bin/bash
ssAddress=$(jq -r '.v2nodeDIV.ss.ssAddress' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
ssPort=$(jq -r '.v2nodeDIV.ss.ssPort' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
ssUUID=$(jq -r '.v2nodeDIV.ss.ssUUID' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
ssSNI=$(jq -r '.v2nodeDIV.ss.ssSNI' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
ssPBK=$(jq -r '.v2nodeDIV.ss.ssPBK' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
ssSID=$(jq -r '.v2nodeDIV.ss.ssSID' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')

[[ -z "$ssAddress" || -z "$ssUUID" || -z "$ssPBK" ]] && exit 0

[[ -z "$ssPort" ]] && ssPort="443"
[[ -z "$ssSNI" ]] && ssSNI="$ssAddress"

OBss=$(cat << EOF
{
  "tag": "default",
  "protocol": "vless",
  "settings": {
    "vnext": [
      {
        "address": "$ssAddress",
        "port": $ssPort,
        "users": [
          {
            "id": "$ssUUID",
            "flow": "xtls-rprx-vision",
            "encryption": "none"
          }
        ]
      }
    ]
  },
  "streamSettings": {
    "network": "tcp",
    "security": "reality",
    "realitySettings": {
      "show": false,
      "fingerprint": "chrome",
      "serverName": "$ssSNI",
      "publicKey": "$ssPBK",
      "shortId": "$ssSID",
      "spiderX": ""
    },
    "sockopt": {
      "mark": 255,
      "tcpFastOpen": true,
      "tcpNoDelay": true
    }
  }
}
EOF
)

jq --argjson OBss "$OBss" '.outbounds[0]=$OBss' /opt/de_GWD/vtrui/config.json | sponge /opt/de_GWD/vtrui/config.json

is_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

resolve_ipv4() {
    local target="$1"
    local res=""

    if is_ipv4 "$target"; then
        printf '%s\n' "$target"
        return 0
    fi

    # 1. SmartDNS global group (port 5332)
    res=$(dig @127.0.0.1 "$target" -4p 5332 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | tail -n 1)
    if [[ -n "$res" ]]; then
        printf '%s\n' "$res"
        return 0
    fi

    # 2. Public DNS over TCP (223.5.5.5)
    res=$(dig @223.5.5.5 "$target" +tcp +time=2 +tries=1 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | tail -n 1)
    if [[ -n "$res" ]]; then
        printf '%s\n' "$res"
        return 0
    fi

    # 3. SmartDNS default group (port 5331)
    res=$(dig @127.0.0.1 "$target" -4p 5331 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | tail -n 1)
    if [[ -n "$res" ]]; then
        printf '%s\n' "$res"
        return 0
    fi

    # 4. System getent / etc/hosts
    res=$(getent ahostsv4 "$target" 2>/dev/null | awk '{print $1}' | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | head -n 1)
    if [[ -n "$res" ]]; then
        printf '%s\n' "$res"
        return 0
    fi

    return 1
}

ssIP=$(resolve_ipv4 "$ssAddress")
if [[ -n "$ssIP" ]]; then
    nft add element ip de_GWD V2NODE { "$ssIP" } 2>/dev/null || true
fi

[[ "$1" = "r" ]] && systemctl restart vtrui >/dev/null 2>&1
