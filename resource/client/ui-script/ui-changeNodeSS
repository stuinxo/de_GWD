#!/bin/bash
source /opt/de_GWD/ui-confCommon
ssAddress=$(jq -r 'if (.v2nodeDIV.ss | type) == "object" then (.v2nodeDIV.ss.ssAddress // empty) else empty end' /opt/de_GWD/0conf 2>/dev/null)
ssPort=$(jq -r 'if (.v2nodeDIV.ss | type) == "object" then (.v2nodeDIV.ss.ssPort // empty) else empty end' /opt/de_GWD/0conf 2>/dev/null)
ssUUID=$(jq -r 'if (.v2nodeDIV.ss | type) == "object" then (.v2nodeDIV.ss.ssUUID // empty) else empty end' /opt/de_GWD/0conf 2>/dev/null)
ssSNI=$(jq -r 'if (.v2nodeDIV.ss | type) == "object" then (.v2nodeDIV.ss.ssSNI // empty) else empty end' /opt/de_GWD/0conf 2>/dev/null)
ssPBK=$(jq -r 'if (.v2nodeDIV.ss | type) == "object" then (.v2nodeDIV.ss.ssPBK // empty) else empty end' /opt/de_GWD/0conf 2>/dev/null)
ssSID=$(jq -r 'if (.v2nodeDIV.ss | type) == "object" then (.v2nodeDIV.ss.ssSID // empty) else empty end' /opt/de_GWD/0conf 2>/dev/null)

if [[ "$ssAddress" =~ ^([^:]+):([0-9]+)$ ]]; then
    [[ -z "$ssPort" ]] && ssPort="${BASH_REMATCH[2]}"
    ssAddress="${BASH_REMATCH[1]}"
fi

[[ -z "$ssAddress" || -z "$ssUUID" || -z "$ssPBK" ]] && exit 0

if [[ ! "$ssPort" =~ ^[0-9]+$ ]] || (( ssPort < 1 || ssPort > 65535 )); then
    ssPort="443"
fi
[[ -z "$ssSNI" ]] && ssSNI="$ssAddress"

OBss=$(jq -nc \
  --arg addr "$ssAddress" \
  --argjson port "$ssPort" \
  --arg uuid "$ssUUID" \
  --arg sni "$ssSNI" \
  --arg pbk "$ssPBK" \
  --arg sid "$ssSID" \
  '{
    tag: "default",
    protocol: "vless",
    settings: {
      vnext: [
        {
          address: $addr,
          port: $port,
          users: [
            {
              id: $uuid,
              flow: "xtls-rprx-vision",
              encryption: "none"
            }
          ]
        }
      ]
    },
    streamSettings: {
      network: "tcp",
      security: "reality",
      realitySettings: {
        show: false,
        fingerprint: "chrome",
        serverName: $sni,
        publicKey: $pbk,
        shortId: $sid,
        spiderX: ""
      },
      sockopt: {
        mark: 255,
        tcpFastOpen: true,
        tcpNoDelay: true
      }
    }
  }') || exit 1

source "$(dirname "$0")/xray-common" 2>/dev/null || source /opt/de_GWD/xray-common
xray_cfg_jq --argjson OBss "$OBss" '.outbounds[0]=$OBss' || exit 1

conf_jq 'if (.v2nodeDIV.ss | type) == "object" then .v2nodeDIV.ss.status="on" else . end'

is_ipv4() {
    [[ "$1" =~ ^([0-9]{1,3}\.){3}[0-9]{1,3}$ ]]
}

if ! is_ipv4 "$ssAddress" && [[ -d /opt/de_GWD/mosdns ]]; then
    touch /opt/de_GWD/mosdns/domains_nodes
    if ! grep -Fxq "$ssAddress" /opt/de_GWD/mosdns/domains_nodes 2>/dev/null; then
        printf '%s\n' "$ssAddress" >> /opt/de_GWD/mosdns/domains_nodes
    fi
fi

resolve_ipv4() {
    local target="$1"
    local res=""

    if is_ipv4 "$target"; then
        printf '%s\n' "$target"
        return 0
    fi

    # 1. SmartDNS global group (port 5332)
    res=$(dig @127.0.0.1 "$target" -4p 5332 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | grep -v '^127\.0\.0\.1$' | tail -n 1)
    if [[ -n "$res" ]]; then
        printf '%s\n' "$res"
        return 0
    fi

    # 2. Public DNS over TCP (223.5.5.5)
    res=$(dig @223.5.5.5 "$target" +tcp +time=2 +tries=1 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | grep -v '^127\.0\.0\.1$' | tail -n 1)
    if [[ -n "$res" ]]; then
        printf '%s\n' "$res"
        return 0
    fi

    # 3. SmartDNS default group (port 5331)
    res=$(dig @127.0.0.1 "$target" -4p 5331 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | grep -v '^127\.0\.0\.1$' | tail -n 1)
    if [[ -n "$res" ]]; then
        printf '%s\n' "$res"
        return 0
    fi

    # 4. System getent / etc/hosts
    res=$(getent ahostsv4 "$target" 2>/dev/null | awk '{print $1}' | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | grep -v '^127\.0\.0\.1$' | head -n 1)
    if [[ -n "$res" ]]; then
        printf '%s\n' "$res"
        return 0
    fi

    return 1
}

ssIP=$(resolve_ipv4 "$ssAddress")
if [[ -n "$ssIP" && "$ssIP" != "127.0.0.1" ]]; then
    nft add element ip de_GWD V2NODE { "$ssIP" } 2>/dev/null || true
fi

[[ "$1" = "r" ]] && systemctl restart vtrui >/dev/null 2>&1
