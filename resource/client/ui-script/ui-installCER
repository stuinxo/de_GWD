#!/bin/bash
clear
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'



installCER(){
CFtoken=$(jq -r '.FORWARD.token // .FORWARD.APIkey // empty' /opt/de_GWD/0conf 2>/dev/null | tr -d '[:space:]')
domain=$(jq -r '.FORWARD.domain // empty' /opt/de_GWD/0conf 2>/dev/null | sed -E 's#^https?://##; s#/.*$##' | tr -d '[:space:]')

if [[ -z "$domain" || ! "$domain" =~ ^([A-Za-z0-9]([A-Za-z0-9-]*[A-Za-z0-9])?\.)+[A-Za-z]{2,}$ ]]; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}Invalid domain in 0conf${cRES}"
  return 1
fi
if [[ -z "$CFtoken" || "$CFtoken" == *[[:cntrl:]]* ]]; then
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}Missing Cloudflare API Token${cRES}"
  return 1
fi

export CF_Token="$CFtoken"
unset CF_Key CF_Email

local mainDomain="$domain"
local domainArgs=("-d" "$domain" "-d" "*.$domain")
if [[ "$domain" =~ \.(co|org|gov|ac|net|me|plc|ltd)\.uk$ || "$domain" =~ \.(com|net|org|gov|edu|ac)\.cn$ || "$domain" =~ \.(com|net|org|edu|gov)\.(hk|tw|au)$ || "$domain" =~ \.(co|or|ne|ac|go)\.jp$ || "$domain" =~ \.(co|or|ne)\.kr$ || "$domain" =~ \.com\.(sg|br|mx|tr)$ || "$domain" =~ \.co\.(za|in|nz)$ || "$domain" =~ \.eu\.org$ ]]; then
  if [[ "$domain" == *.*.*.* ]]; then
    local parentDomain=$(echo "$domain" | cut -d. -f2-)
    mainDomain="$parentDomain"
    domainArgs=("-d" "$parentDomain" "-d" "*.$parentDomain" "-d" "*.$domain")
  fi
elif [[ "$domain" == *.*.* ]]; then
    local parentDomain=$(echo "$domain" | cut -d. -f2-)
    mainDomain="$parentDomain"
    domainArgs=("-d" "$parentDomain" "-d" "*.$parentDomain" "-d" "*.$domain")
fi

[[ -f "/etc/nginx/conf.d/80.conf" ]] && sed -i "/server_name/c\server_name $domain;" /etc/nginx/conf.d/80.conf
sed -i "/server_name/c\server_name $domain;" /etc/nginx/conf.d/default.conf
source "$(dirname "$0")/ui-confCommon" 2>/dev/null || source /opt/de_GWD/ui-confCommon
conf_jq --arg serverName "$domain" '.address.serverName = $serverName'

if [[ ! -x "/root/.acme.sh/acme.sh" ]]; then
    curl -fsSL https://get.acme.sh | sh
fi
sed -i '/CF_Key/d;/CF_Email/d;/ACCOUNT_EMAIL.*example\.com/d' /root/.acme.sh/account.conf 2>/dev/null || true
"/root/.acme.sh"/acme.sh --force --upgrade  --auto-upgrade
"/root/.acme.sh"/acme.sh --force --set-default-ca  --server letsencrypt

sslStage=$(mktemp -d /tmp/de_GWD-ssl.XXXXXX)
[[ -f /var/www/ssl/de_GWD.cer ]] && cp -p /var/www/ssl/de_GWD.cer "$sslStage/de_GWD.cer.bak"
[[ -f /var/www/ssl/de_GWD.key ]] && cp -p /var/www/ssl/de_GWD.key "$sslStage/de_GWD.key.bak"

sslOk=0
if "/root/.acme.sh"/acme.sh --force --issue --dns dns_cf "${domainArgs[@]}" -k ec-256 --dnssleep 45; then
  acmeSrc="/root/.acme.sh/${mainDomain}_ecc"
  if [[ -f "$acmeSrc/fullchain.cer" && -f "$acmeSrc/${mainDomain}.key" ]]; then
    cp -f "$acmeSrc/fullchain.cer" "$sslStage/de_GWD.cer"
    cp -f "$acmeSrc/${mainDomain}.key" "$sslStage/de_GWD.key"
    chmod 640 "$sslStage/de_GWD.key" 2>/dev/null || true
    stagedCertPub=$(openssl x509 -in "$sslStage/de_GWD.cer" -noout -pubkey 2>/dev/null)
    stagedKeyPub=$(openssl pkey -in "$sslStage/de_GWD.key" -pubout 2>/dev/null)
    if [[ -n "$stagedCertPub" && "$stagedCertPub" == "$stagedKeyPub" ]]; then
      if "/root/.acme.sh"/acme.sh --force --installcert -d "$mainDomain" \
                     --key-file       /var/www/ssl/de_GWD.key  \
                     --fullchain-file /var/www/ssl/de_GWD.cer \
                     --reloadcmd     "chown root:www-data /var/www/ssl/*.key 2>/dev/null || true; chmod 640 /var/www/ssl/*.key 2>/dev/null || true; systemctl force-reload nginx" \
                     --ecc; then
        chown root:www-data /var/www/ssl/*.key 2>/dev/null || true
        chmod 640 /var/www/ssl/*.key 2>/dev/null || true
        chmod 644 /var/www/ssl/de_GWD.cer 2>/dev/null || true
        instCertPub=$(openssl x509 -in /var/www/ssl/de_GWD.cer -noout -pubkey 2>/dev/null)
        instKeyPub=$(openssl pkey -in /var/www/ssl/de_GWD.key -pubout 2>/dev/null)
        [[ -n "$instCertPub" && "$instCertPub" == "$instKeyPub" ]] && sslOk=1
      fi
    fi
  fi
fi

if [[ "$sslOk" -ne 1 ]]; then
  [[ -f "$sslStage/de_GWD.cer.bak" ]] && mv -f "$sslStage/de_GWD.cer.bak" /var/www/ssl/de_GWD.cer
  [[ -f "$sslStage/de_GWD.key.bak" ]] && mv -f "$sslStage/de_GWD.key.bak" /var/www/ssl/de_GWD.key
  chown root:www-data /var/www/ssl/*.key 2>/dev/null || true
  chmod 640 /var/www/ssl/*.key 2>/dev/null || true
  chmod 644 /var/www/ssl/de_GWD.cer 2>/dev/null || true
  rm -rf "$sslStage"
  echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${RED}TLS Certificate generation/verification failed (kept previous cert)${cRES}"
  return 1
fi
rm -rf "$sslStage"

[[ -d "/opt/de_GWD/vtrui" ]] && systemctl is-active --quiet vtrui && systemctl restart vtrui
[[ -d "/opt/de_GWD/vtrui1" ]] && systemctl is-active --quiet vtrui1 && systemctl restart vtrui1
if systemctl is-active --quiet coredns && grep -q '[^[:space:]]' /opt/de_GWD/coredns/corefile 2>/dev/null; then
  systemctl restart coredns
fi
[[ -d "/opt/de_GWD/RproxyS" ]] && systemctl is-active --quiet RproxyS && systemctl restart RproxyS

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Generate & Deploy TLS Certificate${cRES}"
}



resetCER(){
mkdir -p /var/www/ssl && cd /var/www/ssl

rm -f /var/www/ssl/ocsp.resp
if [[ ! -f /var/www/ssl/dhparam.pem ]]; then
  openssl dhparam -dsaparam -out /var/www/ssl/dhparam.pem 2048 2>/dev/null || openssl dhparam -out /var/www/ssl/dhparam.pem 2048
fi

sslStage=$(mktemp -d /tmp/de_GWD-ssl.XXXXXX) || return 1
if openssl req -x509 -nodes -days 3650 \
  -subj "/C=CA/ST=QC/O=Company, Inc./CN=localhost.com" \
  -config <(cat /etc/ssl/openssl.cnf \
    <(printf '[SAN]\nsubjectAltName=DNS:localhost')) \
  -newkey rsa:2048 \
  -keyout "$sslStage/de_GWD.key" \
  -out "$sslStage/de_GWD.cer"; then
  chmod 640 "$sslStage/de_GWD.key" 2>/dev/null || true
  chmod 644 "$sslStage/de_GWD.cer" 2>/dev/null || true
  mv -f "$sslStage/de_GWD.key" /var/www/ssl/de_GWD.key
  mv -f "$sslStage/de_GWD.cer" /var/www/ssl/de_GWD.cer
fi
rm -rf "$sslStage"

chown root:www-data /var/www/ssl/de_GWD.key 2>/dev/null || true
chmod 640 /var/www/ssl/de_GWD.key 2>/dev/null || true
chmod 644 /var/www/ssl/de_GWD.cer 2>/dev/null || true

tmpCron=$(mktemp /tmp/de_GWD-cron.XXXXXX) || return 1
crontab -l 2>/dev/null >"$tmpCron"
sed -i '/acme.sh/d' "$tmpCron"
crontab "$tmpCron"
rm -f "$tmpCron"
rm -rf "/root/.acme.sh"

sed -i '/ssl_trusted_certificate/d' /etc/nginx/conf.d/.ssl_certs
sed -i '/ssl_stapling/d' /etc/nginx/conf.d/.ssl_certs
sed -i '/ssl_stapling_verify/d' /etc/nginx/conf.d/.ssl_certs
sed -i '/ssl_stapling_file/d' /etc/nginx/conf.d/.ssl_certs

systemctl force-reload nginx
echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Remove TLS Certificate${cRES}"
}



start_menu(){
    echo -e "${GREEN}=============================== ${cRES}"
    echo -e "${GREEN}     Domain & Certificate${cRES}"
    echo -e "${GREEN}=============================== ${cRES}"
    echo -e "${GREEN}1. Generate TLS Certificate${cRES}"
   echo -e "${YELLOW}2. Reset TLS Certificate${cRES}"
    echo ""
    read -p "Select:" num
    case "$num" in
    1)
    installCER
    start_menu
    ;;
    2)
    resetCER
    start_menu
    ;;
    *)
    clear
    echo -e "${RED}Wrong number${cRES}"
    sleep 1s
    start_menu
    ;;
    esac
}

start_menu
