#!/bin/bash
rm -rf /opt/de_GWD/update

pkill -f "/usr/bin/ttyd -i lo -p 3000" >/dev/null 2>&1 || true

[[ -n $(cat /etc/resolv.conf 2>/dev/null | grep -v '127.0.0.1') ]] && resolvconf -u

ps -aux | grep 'ui-install' | sed '/grep/d' | awk '{print$2}' | while read -r line; do
  [[ -n "$line" ]] && kill "$line" >/dev/null 2>&1 || true
done
