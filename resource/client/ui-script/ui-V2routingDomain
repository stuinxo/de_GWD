#!/bin/bash
source "$(dirname "$0")/xray-common" 2>/dev/null || source /opt/de_GWD/xray-common
if [[ -n $1 ]] && [[ -n $2 ]]; then
tag=$1
domain=$2

RoutingADD=$(jq -nc --arg tag "$tag" --argjson domain "$domain" '{type:"field",domain:$domain,network:"tcp,udp",outboundTag:$tag}') || exit 1

xray_cfg_jq --argjson RoutingADD "$RoutingADD" '.routing.rules+=[$RoutingADD]'
fi
