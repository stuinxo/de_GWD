#!/bin/bash
if [[ $1 = "off" ]]; then
tmpCron=$(mktemp /tmp/de_GWD-cron.XXXXXX) || exit 1
trap 'rm -f "$tmpCron"' EXIT
crontab -l 2>/dev/null > "$tmpCron"
sed -i '/autoUpdate/d' "$tmpCron"
crontab "$tmpCron"
rm -rf /opt/de_GWD/autoUpdate
elif [[ "$1" =~ ^([0-9]|1[0-9]|2[0-3])$ ]]; then
cat << "EOF" >/opt/de_GWD/autoUpdate
#!/bin/bash
localVer=$(awk 'NR==1' /var/www/html/act/version.php)
remoteVer=$(curl -fsSL --connect-timeout 5 -m 10 https://raw.githubusercontent.com/stuinxo/de_GWD/v2/version.php | head -n 1 | tr -d '\r ')

if [[ -z "$remoteVer" ]] || [[ ! "$remoteVer" =~ ^v?[0-9]+\.[0-9]+ ]] || [[ "$remoteVer" == "$localVer" ]]; then
  exit 0
fi

VerCP=$(printf '%s\n%s\n' "$localVer" "$remoteVer" | sort -rV | uniq | awk 'NR==2')

if [[ "$VerCP" = "$localVer" ]]; then
  tmpAuto=$(mktemp /tmp/de_GWD-autoUpdate.XXXXXX) || exit 1
  tmpClean=$(mktemp /tmp/de_GWD-autoUpdate-clean.XXXXXX) || { rm -f "$tmpAuto"; exit 1; }
  trap 'rm -f "$tmpAuto" "$tmpClean"' EXIT

  if wget -t 5 -T 10 -cqO "$tmpAuto" https://raw.githubusercontent.com/stuinxo/de_GWD/v2/client &&
     [[ $(du -sk "$tmpAuto" 2>/dev/null | awk '{print $1}') -gt 70 ]] &&
     grep -q 'updateGWD()' "$tmpAuto"; then
    awk '{lines[NR]=$0} END {n=NR; while(n>0 && lines[n]=="") n--; if(n>0 && lines[n]=="start_menu") n--; for(i=1;i<=n;i++) print lines[i]}' "$tmpAuto" >"$tmpClean"
    printf '%s\n' 'updateGWD auto' >>"$tmpClean"
    if bash -n "$tmpClean" 2>/dev/null; then
      systemctl stop php-fpm 2>/dev/null
      chmod 700 "$tmpClean"
      "$tmpClean"
      systemctl restart php-fpm 2>/dev/null
    fi
  fi
fi
EOF
chmod +x /opt/de_GWD/autoUpdate

tmpCron=$(mktemp /tmp/de_GWD-cron.XXXXXX) || exit 1
trap 'rm -f "$tmpCron"' EXIT
crontab -l 2>/dev/null > "$tmpCron"
sed -i '/autoUpdate/d' "$tmpCron"
printf '%s\n' "0 $1 * * *  /opt/de_GWD/autoUpdate" >> "$tmpCron"
crontab "$tmpCron"
fi
