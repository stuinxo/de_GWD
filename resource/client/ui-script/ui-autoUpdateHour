#!/bin/bash
if [[ $1 = "off" ]]; then
crontab -l 2>/dev/null > /tmp/now.cron
sed -i '/autoUpdate/d' /tmp/now.cron
crontab /tmp/now.cron
rm -rf /tmp/now.cron
rm -rf /opt/de_GWD/autoUpdate
elif [[ "$1" =~ ^([0-9]|1[0-9]|2[0-3])$ ]]; then
cat << "EOF" >/opt/de_GWD/autoUpdate
#!/bin/bash
localVer=$(awk 'NR==1' /var/www/html/act/version.php)
remoteVer=$(curl -fsSL --connect-timeout 5 -m 10 https://raw.githubusercontent.com/stuinxo/de_GWD/v2/version.php | head -n 1 | tr -d '\r ')

if [[ -z "$remoteVer" ]] || [[ ! "$remoteVer" =~ ^v?[0-9]+\.[0-9]+ ]] || [[ "$remoteVer" == "$localVer" ]]; then
  exit 0
fi

echo "$localVer" >/tmp/de_GWD_Ver
echo "$remoteVer" >>/tmp/de_GWD_Ver

VerCP=$(sort -rV /tmp/de_GWD_Ver | uniq | awk 'NR==2')

if [[ $VerCP = $localVer ]]; then
systemctl stop php-fpm 2>/dev/null

rm -rf /tmp/autoUpdate
wget -t 5 -T 10 -cqO /tmp/autoUpdate https://raw.githubusercontent.com/stuinxo/de_GWD/v2/client

if [[ $(du -sk /tmp/autoUpdate 2>/dev/null | awk '{print$1}') -gt 70 ]]; then
awk '{lines[NR]=$0} END {n=NR; while(n>0 && lines[n]=="") n--; if(n>0 && lines[n]=="start_menu") n--; for(i=1;i<=n;i++) print lines[i]}' /tmp/autoUpdate >/tmp/autoUpdate.tmp && mv -f /tmp/autoUpdate.tmp /tmp/autoUpdate
echo "updateGWD auto" >>/tmp/autoUpdate
chmod +x /tmp/autoUpdate
/tmp/autoUpdate
rm -rf /tmp/autoUpdate
fi

systemctl restart php-fpm 2>/dev/null
fi

rm -rf /tmp/de_GWD_Ver
rm -rf /tmp/autoUpdate
EOF
chmod +x /opt/de_GWD/autoUpdate

crontab -l 2>/dev/null > /tmp/now.cron
sed -i '/autoUpdate/d' /tmp/now.cron
echo "0 $1 * * *  /opt/de_GWD/autoUpdate" >> /tmp/now.cron
crontab /tmp/now.cron
rm -rf /tmp/now.cron
fi
