#!/bin/bash
# ui-NodeSM: Manage Predefined Service Routing (NodeSM)

# 1. Clean up existing nodeSM outbounds and routing rules
jq 'del(.outbounds[] | select(.tag != null and (.tag | startswith("nodeSM"))))' /opt/de_GWD/vtrui/config.json |\
jq 'del(.routing.rules[] | select(.outboundTag != null and (type == "object") and (.outboundTag | (type == "string" and startswith("nodeSM")))))' |\
jq 'del(.routing.rules[] | select(.domain == ["geosite:apple","geosite:apple-dev","geosite:apple-update","geosite:icloud","geosite:apple@cn","geosite:apple-cn"]))' |\
jq 'del(.routing.rules[] | select(.domain == ["domain:steamserver.net","geosite:steam@cn","geosite:category-games@cn"]))' | sponge /opt/de_GWD/vtrui/config.json

# Standard service list: name -> domains
declare -A SERVICE_DOMAINS
SERVICE_DOMAINS=(
  ["openai"]='["geosite:openai"]'
  ["claude"]='["geosite:anthropic"]'
  ["gemini"]='["geosite:google-gemini"]'
  ["grok"]='["geosite:xai"]'
  ["youtube"]='["geosite:youtube"]'
  ["netflix"]='["geosite:netflix"]'
  ["hdh"]='["geosite:hbo","geosite:disney","geosite:hulu"]'
  ["bahamut"]='["geosite:bahamut"]'
  ["tvb"]='["geosite:tvb"]'
  ["telegram"]='["geosite:telegram"]'
  ["twitter"]='["geosite:twitter"]'
  ["discord"]='["geosite:discord"]'
  ["reddit"]='["geosite:reddit"]'
  ["github"]='["geosite:github"]'
  ["wikipedia"]='["geosite:wikimedia"]'
)

# Parse key=value arguments from CLI
declare -A PARAM_MAP
for arg in "$@"; do
  if [[ "$arg" =~ ^([a-zA-Z0-9_]+)=([0-9]+)$ ]]; then
    PARAM_MAP["${BASH_REMATCH[1]}"]="${BASH_REMATCH[2]}"
  fi
done

# If positional arguments are passed in old legacy order (e.g. ui-NodeSM r 1 2 3 4 5 6 7 8)
LEGACY_KEYS=("youtube" "netflix" "hdh" "tvb" "bahamut" "openai" "apple" "steam")
if [[ ${#PARAM_MAP[@]} -eq 0 && -n "$2" && "$2" =~ ^[0-9]+$ ]]; then
  idx=2
  for lk in "${LEGACY_KEYS[@]}"; do
    val="${!idx}"
    if [[ -n "$val" ]]; then
      PARAM_MAP["$lk"]="$val"
    fi
    ((idx++))
  done
fi

# Apply standard services
for svc in "${!SERVICE_DOMAINS[@]}"; do
  routingDomain="${SERVICE_DOMAINS[$svc]}"
  tag="nodeSM${svc}"

  if [[ -n "${PARAM_MAP[$svc]}" ]]; then
    val="${PARAM_MAP[$svc]}"
    if [[ "$val" != "0" ]]; then
      node_idx=$((val - 1))
      address=$(jq -r --argjson nodecheck "$node_idx" '.v2node[$nodecheck].domain // empty' /opt/de_GWD/0conf 2>/dev/null)
      tls=$(jq -r --argjson nodecheck "$node_idx" '.v2node[$nodecheck].tls // empty' /opt/de_GWD/0conf 2>/dev/null)
      uuid=$(jq -r --argjson nodecheck "$node_idx" '.v2node[$nodecheck].uuid // empty' /opt/de_GWD/0conf 2>/dev/null)
      path=$(jq -r --argjson nodecheck "$node_idx" '.v2node[$nodecheck].path // empty' /opt/de_GWD/0conf 2>/dev/null)

      if [[ -n "$address" && "$address" != "null" ]]; then
        jq --arg address "$address" ".v2nodeDIV.nodeSM.${svc}=\$address" /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
        /opt/de_GWD/ui-V2routingDomain "$tag" "$routingDomain"
        /opt/de_GWD/ui-V2outbound "$tag" "$address" "$tls" "$uuid" "$path"
      fi
    else
      jq "del(.v2nodeDIV.nodeSM.${svc})" /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
    fi
  else
    # Restore from 0conf if already configured
    address=$(jq -r ".v2nodeDIV.nodeSM.${svc} // empty" /opt/de_GWD/0conf 2>/dev/null)
    if [[ -n "$address" ]]; then
      tls=$(jq -r --arg nodecheck "$address" '[.v2node[]? | select(.domain == $nodecheck)][0].tls // empty' /opt/de_GWD/0conf 2>/dev/null)
      uuid=$(jq -r --arg nodecheck "$address" '[.v2node[]? | select(.domain == $nodecheck)][0].uuid // empty' /opt/de_GWD/0conf 2>/dev/null)
      path=$(jq -r --arg nodecheck "$address" '[.v2node[]? | select(.domain == $nodecheck)][0].path // empty' /opt/de_GWD/0conf 2>/dev/null)

      if [[ -n "$tls" && -n "$uuid" ]]; then
        /opt/de_GWD/ui-V2routingDomain "$tag" "$routingDomain"
        /opt/de_GWD/ui-V2outbound "$tag" "$address" "$tls" "$uuid" "$path"
      fi
    fi
  fi
done

# Apply Apple rules
apple_domains='["geosite:apple","geosite:apple-dev","geosite:apple-update","geosite:icloud","geosite:apple@cn","geosite:apple-cn"]'
if [[ -n "${PARAM_MAP[apple]}" ]]; then
  val="${PARAM_MAP[apple]}"
  if [[ "$val" != "0" ]]; then
    node_idx=$((val - 1))
    address=$(jq -r --argjson nodecheck "$node_idx" '.v2node[$nodecheck].domain // empty' /opt/de_GWD/0conf 2>/dev/null)
    tls=$(jq -r --argjson nodecheck "$node_idx" '.v2node[$nodecheck].tls // empty' /opt/de_GWD/0conf 2>/dev/null)
    uuid=$(jq -r --argjson nodecheck "$node_idx" '.v2node[$nodecheck].uuid // empty' /opt/de_GWD/0conf 2>/dev/null)
    path=$(jq -r --argjson nodecheck "$node_idx" '.v2node[$nodecheck].path // empty' /opt/de_GWD/0conf 2>/dev/null)

    if [[ -n "$address" && "$address" != "null" ]]; then
      jq --arg address "$address" '.v2nodeDIV.nodeSM.apple=$address' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
      /opt/de_GWD/ui-V2routingDomain "nodeSMapple" "$apple_domains"
      /opt/de_GWD/ui-V2outbound "nodeSMapple" "$address" "$tls" "$uuid" "$path"
    fi
  else
    jq 'del(.v2nodeDIV.nodeSM.apple)' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
    /opt/de_GWD/ui-V2routingDomain 'direct' "$apple_domains"
  fi
else
  address=$(jq -r '.v2nodeDIV.nodeSM.apple // empty' /opt/de_GWD/0conf 2>/dev/null)
  if [[ -n "$address" ]]; then
    tls=$(jq -r --arg nodecheck "$address" '[.v2node[]? | select(.domain == $nodecheck)][0].tls // empty' /opt/de_GWD/0conf 2>/dev/null)
    uuid=$(jq -r --arg nodecheck "$address" '[.v2node[]? | select(.domain == $nodecheck)][0].uuid // empty' /opt/de_GWD/0conf 2>/dev/null)
    path=$(jq -r --arg nodecheck "$address" '[.v2node[]? | select(.domain == $nodecheck)][0].path // empty' /opt/de_GWD/0conf 2>/dev/null)
    if [[ -n "$tls" && -n "$uuid" ]]; then
      /opt/de_GWD/ui-V2routingDomain "nodeSMapple" "$apple_domains"
      /opt/de_GWD/ui-V2outbound "nodeSMapple" "$address" "$tls" "$uuid" "$path"
    else
      /opt/de_GWD/ui-V2routingDomain 'direct' "$apple_domains"
    fi
  else
    /opt/de_GWD/ui-V2routingDomain 'direct' "$apple_domains"
  fi
fi

# Apply Steam rules
steam_domains='["domain:steamserver.net","geosite:steam@cn","geosite:category-games@cn"]'
if [[ -n "${PARAM_MAP[steam]}" ]]; then
  val="${PARAM_MAP[steam]}"
  if [[ "$val" != "0" ]]; then
    jq '.v2nodeDIV.nodeSM.steam="proxy"' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
  else
    jq 'del(.v2nodeDIV.nodeSM.steam)' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
    /opt/de_GWD/ui-V2routingDomain 'direct' "$steam_domains"
  fi
else
  steam_status=$(jq -r '.v2nodeDIV.nodeSM.steam' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$')
  if [[ "$steam_status" != "proxy" ]]; then
    /opt/de_GWD/ui-V2routingDomain 'direct' "$steam_domains"
  fi
fi

# Update DNS lists if script exists
if [[ -x /opt/de_GWD/ui-submitListBWsm ]]; then
  /opt/de_GWD/ui-submitListBWsm
fi

# Determine if any nodeSM rule is active
has_custom=$(jq '.v2nodeDIV.nodeSM | del(.status) | keys | length' /opt/de_GWD/0conf 2>/dev/null)
if [[ -z "$has_custom" || "$has_custom" -eq 0 ]]; then
  jq '.v2nodeDIV.nodeSM.status="off"' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
else
  jq '.v2nodeDIV.nodeSM.status="on"' /opt/de_GWD/0conf | sponge /opt/de_GWD/0conf
fi

chown root:www-data /opt/de_GWD/0conf 2>/dev/null || true
chmod 660 /opt/de_GWD/0conf 2>/dev/null || true

# Restart services if requested
if [[ "$1" == "r" ]]; then
  systemctl restart smartdns 2>/dev/null || true
  systemctl restart vtrui 2>/dev/null || true
fi
