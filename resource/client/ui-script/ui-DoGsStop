#!/bin/bash
[[ -f /opt/de_GWD/coredns/corefile ]] && sed -i '/DoGs_START/,/DoGs_END/d' /opt/de_GWD/coredns/corefile
if ! grep -q '[^[:space:]]' /opt/de_GWD/coredns/corefile 2>/dev/null; then
  : >/opt/de_GWD/coredns/corefile
  systemctl disable coredns >/dev/null 2>&1
  systemctl stop coredns
else
  systemctl restart coredns
fi
