#!/bin/bash
[[ $(jq -r '.outbounds[0].streamSettings.security' /opt/de_GWD/vtrui/config.json 2>/dev/null) = "reality" ]] && exit 0

domain=$(jq -r '.outbounds[0].settings.vnext[0].address' /opt/de_GWD/vtrui/config.json 2>/dev/null | grep -v '^null$')
port=$(jq -r '.outbounds[0].settings.vnext[0].port' /opt/de_GWD/vtrui/config.json 2>/dev/null | grep -v '^null$')

if [[ "$port" = "443" ]]; then
  jq -r --arg d "$domain" '.v2node | to_entries[] | select(.value.domain == $d or .value.domain == ($d + ":443")) | .key' /opt/de_GWD/0conf
else
  jq -r --arg nc "$domain:$port" '.v2node | to_entries[] | select(.value.domain == $nc) | .key' /opt/de_GWD/0conf
fi
