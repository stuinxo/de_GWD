#!/bin/bash
WGaddress=$(jq -r '.wireguard.server.WGaddress // empty' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$' | tr -d '[:space:]')
WGport=$(jq -r '.wireguard.server.WGport // empty' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$' | tr -d '[:space:]')
sprivatekey=$(jq -r '.wireguard.server.sprivatekey // empty' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$' | tr -d '[:space:]')
spublickey=$(jq -r '.wireguard.server.spublickey // empty' /opt/de_GWD/0conf 2>/dev/null | grep -v '^null$' | tr -d '[:space:]')

[[ -n "$WGaddress" && "$WGaddress" != *[[:cntrl:]]* && "$WGaddress" =~ ^[A-Za-z0-9.:-]+$ ]] || exit 1
[[ "$WGport" =~ ^[0-9]+$ ]] && (( WGport >= 1 && WGport <= 65535 )) || exit 1
[[ "$sprivatekey" =~ ^[A-Za-z0-9+/]{42,43}=$ ]] || exit 1
[[ "$spublickey" =~ ^[A-Za-z0-9+/]{42,43}=$ ]] || exit 1

clientsNUM=$(jq -r '.wireguard.clients | length' /opt/de_GWD/0conf 2>/dev/null)
[[ "$clientsNUM" =~ ^[0-9]+$ ]] || clientsNUM=0

mkdir -p /etc/wireguard
rm -rf /etc/wireguard/client*.conf

cat << EOF >/etc/wireguard/wg0.conf
[Interface]
PrivateKey = $sprivatekey
Address = 172.16.66.1/32
ListenPort = $WGport
DNS = 127.0.0.1
MTU = 1420
EOF

for ((i=0; i<clientsNUM; i++)); do
  cpriv=$(jq -r --argjson i "$i" '.wireguard.clients[$i].cprivatekey // empty' /opt/de_GWD/0conf 2>/dev/null | tr -d '[:space:]')
  cpub=$(jq -r --argjson i "$i" '.wireguard.clients[$i].cpublickey // empty' /opt/de_GWD/0conf 2>/dev/null | tr -d '[:space:]')
  if [[ ! "$cpriv" =~ ^[A-Za-z0-9+/]{42,43}=$ ]] || [[ ! "$cpub" =~ ^[A-Za-z0-9+/]{42,43}=$ ]] || [[ "$cpriv" =~ ^0+=?$ || "$cpub" =~ ^0+=?$ ]]; then
    continue
  fi

cat << EOF >>/etc/wireguard/wg0.conf

[Peer]
PublicKey = $cpub
AllowedIPs = 172.16.66.$((i+11))/32
EOF

cat << EOF >/etc/wireguard/client$((i+1)).conf
[Interface]
PrivateKey = $cpriv
Address = 172.16.66.$((i+11))/32
DNS = 172.16.66.1
MTU = 1400

[Peer]
PublicKey = $spublickey
Endpoint = $WGaddress:$WGport
AllowedIPs = 0.0.0.0/0
PersistentKeepalive = 15
EOF
done
chmod 600 /etc/wireguard/wg0.conf
chmod 600 /etc/wireguard/client*.conf 2>/dev/null || true

rm -rf /lib/systemd/system/wg-quick@.service
cat << "EOF" >/etc/systemd/system/wg-quick@.service
[Unit]
Description=WireGuard via wg-quick(8) for %I
After=network-online.target nss-lookup.target
Wants=network-online.target nss-lookup.target
PartOf=wg-quick.target

[Service]
User=root
Type=oneshot
ExecStart=/usr/bin/wg-quick up %i
ExecStartPost=-/etc/rc_online.local
ExecStop=/usr/bin/wg-quick down %i
ExecStopPost=-/etc/rc_online.local
ExecReload=/bin/bash -c 'exec /usr/bin/wg syncconf %i <(exec /usr/bin/wg-quick strip %i)'
Environment=WG_ENDPOINT_RESOLUTION_RETRIES=infinity
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload >/dev/null
systemctl enable wg-quick@wg0 >/dev/null 2>&1
systemctl restart wg-quick@wg0

mkdir -p /etc/sysctl.d
cat << "EOF" >/etc/sysctl.d/99-wireguard.conf
net.ipv4.ip_forward = 1
net.ipv4.conf.all.forwarding = 1
net.ipv4.conf.default.forwarding = 1
EOF
sysctl --system >/dev/null 2>&1 || sysctl -p /etc/sysctl.d/99-wireguard.conf >/dev/null 2>&1

rm -f /etc/dnsmasq.d/00-interface.conf
[[ $(docker inspect -f '{{.State.Running}}' pihole 2>/dev/null) = "true" ]] && (docker exec pihole pihole reloaddns >/dev/null 2>&1 || docker restart pihole >/dev/null 2>&1 || true)

if [[ -x /etc/rc_online.local ]] && ! systemd-detect-virt --container >/dev/null 2>&1; then
  /etc/rc_online.local
fi
