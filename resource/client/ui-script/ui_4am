#!/bin/bash
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'



/opt/de_GWD/tcpTime

if [[ "$1" != "i" && "$1" != "f" ]]; then
  serverConnect1=$(curl -Is -m 5 google.com | grep 'HTTP')
  serverConnect2=$(curl -Is -m 5 youtube.com | grep 'HTTP')
  [[ -z $serverConnect1 ]] && [[ -z $serverConnect2 ]] && exit
fi

[[ $1 = "u" ]] && service cron stop

echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Update CHN Domain & IP rules${cRES}\r\c"
checkSum(){
sha256sumL=$(sha256sum $1 2>/dev/null | awk '{print$1}')
if [[ $sha256sumL = $2 ]]; then 
  echo "true"
elif [[ $sha256sumL != $2 ]]; then
  echo "false"
fi
}

ui_dl() {
    local url="$1"
    local dest="$2"
    wget --no-check-certificate --timeout=15 --tries=2 --show-progress -cqO "$dest" "https://ghproxy.net/$url" 2>/dev/null || \
    wget --no-check-certificate --timeout=15 --tries=2 --show-progress -cqO "$dest" "https://ghp.ci/$url" 2>/dev/null || \
    wget --no-check-certificate --timeout=10 --tries=1 --show-progress -cqO "$dest" "$url" 2>/dev/null
}

get_sha256() {
    local url="$1"
    curl -fsSLo- --connect-timeout 4 -m 8 "https://ghproxy.net/$url" 2>/dev/null || \
    curl -fsSLo- --connect-timeout 4 -m 8 "https://ghp.ci/$url" 2>/dev/null || \
    curl -fsSLo- --connect-timeout 4 -m 8 "$url" 2>/dev/null
}

update_rule_file() {
    local file="$1"
    local url="$2"
    local sha_url="$3"

    local remote_sha=$(get_sha256 "$sha_url" | awk '{print$1}')
    local local_file="/opt/de_GWD/.repo/$file"

    if [[ ! -s "$local_file" ]] || { [[ -n "$remote_sha" ]] && [[ $(checkSum "$local_file" "$remote_sha") = "false" ]]; }; then
        rm -rf "/tmp/$file"
        ui_dl "$url" "/tmp/$file"
        if [[ -s "/tmp/$file" ]]; then
            if [[ -z "$remote_sha" ]] || [[ $(checkSum "/tmp/$file" "$remote_sha") = "true" ]]; then
                mv -f "/tmp/$file" "$local_file"
            fi
        fi
    fi
}

update_rule_file "geosite.dat" "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat" "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat.sha256sum"
update_rule_file "geoip.dat" "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/geoip.dat" "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/geoip.dat.sha256sum"
update_rule_file "IPchnroute" "https://raw.githubusercontent.com/jacyl4/chnroute/main/IPchnroute" "https://raw.githubusercontent.com/jacyl4/chnroute/main/IPchnroute.sha256sum"
update_rule_file "Domains.chn.txt" "https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.chn.txt" "https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.chn.txt.sha256sum"
update_rule_file "Domains.apple.txt" "https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.apple.txt" "https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.apple.txt.sha256sum"
update_rule_file "Domains.games.txt" "https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.games.txt" "https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/Domains.games.txt.sha256sum"
update_rule_file "99-bogus-nxdomain.china.conf" "https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/99-bogus-nxdomain.china.conf" "https://raw.githubusercontent.com/jacyl4/chnroute/main/mosdns_chnlist/99-bogus-nxdomain.china.conf.sha256sum"

mkdir -p /etc/dnsmasq.d
[[ -s "/opt/de_GWD/.repo/99-bogus-nxdomain.china.conf" ]] && cp -f "/opt/de_GWD/.repo/99-bogus-nxdomain.china.conf" /etc/dnsmasq.d/
[[ -s "/opt/de_GWD/.repo/geosite.dat" ]] && cp -f /opt/de_GWD/.repo/geosite.dat /opt/de_GWD/vtrui/geosite.dat && cp -f /opt/de_GWD/.repo/geosite.dat /opt/de_GWD/mosdns/geosite.dat
[[ -s "/opt/de_GWD/.repo/geoip.dat" ]] && cp -f /opt/de_GWD/.repo/geoip.dat /opt/de_GWD/vtrui/geoip.dat

if [[ -s "/opt/de_GWD/.repo/IPchnroute" ]]; then
cp -f /opt/de_GWD/.repo/IPchnroute /opt/de_GWD/nftables/IP_CHNROUTE
sed -i '/^\s*$/d' /opt/de_GWD/nftables/IP_CHNROUTE
sed -i 's/$/,/g' /opt/de_GWD/nftables/IP_CHNROUTE
nft flush set ip de_GWD CHNROUTE 2>/dev/null
cat << EOF >/opt/de_GWD/nftables/SET_CHNROUTE.nft
#!/usr/sbin/nft -f
table ip de_GWD {
        set CHNROUTE {
                type ipv4_addr
                flags interval
                auto-merge
                elements = { $(cat /opt/de_GWD/nftables/IP_CHNROUTE) }
        }
}
EOF
chmod +x /opt/de_GWD/nftables/SET_CHNROUTE.nft
/opt/de_GWD/nftables/SET_CHNROUTE.nft 2>/dev/null
fi

if [[ -n $(openssl x509 -enddate -noout -in /var/www/ssl/de_GWD.cer -checkend 259200 | grep "Certificate will expire") ]] && [[ -d "/root/.acme.sh" ]]; then
"/root/.acme.sh"/acme.sh --force --set-default-ca  --server letsencrypt
"/root/.acme.sh"/acme.sh --force --cron --home "/root/.acme.sh"

sslFolder=$(ls "/root/.acme.sh" | grep '_ecc')
cp -f "/root/.acme.sh"/$sslFolder/fullchain.cer /var/www/ssl/de_GWD.cer
cp -f "/root/.acme.sh"/$sslFolder/*.key /var/www/ssl/de_GWD.key
fi

[[ $1 = "u" ]] && service cron restart

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Update CHN Domain & IP rules${cRES}"