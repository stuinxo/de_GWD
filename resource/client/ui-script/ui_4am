#!/bin/bash
RED='\E[1;31m'
GREEN='\E[1;32m'
YELLOW='\E[1;33m'
BLUE='\E[1;34m'
PURPLE='\E[1;35m'
CYAN='\E[1;36m'
WHITE='\E[1;37m'
cRES='\E[0m'



/opt/de_GWD/tcpTime

serverConnect1=$(curl -Is -m 5 google.com | grep 'HTTP')
serverConnect2=$(curl -Is -m 5 youtube.com | grep 'HTTP')
[[ -s "/opt/de_GWD/.repo/Domains.chn.txt" ]] && [[ -z $serverConnect1 ]] && [[ -z $serverConnect2 ]] && exit

[[ $1 = "u" ]] && service cron stop

echo -e "${WHITE}[...]\c" && echo -e "\t${WHITE}Update CHN Domain & IP rules${cRES}\r\c"
checkSum(){
sha256sumL=$(sha256sum $1 2>/dev/null | awk '{print$1}')
if [[ -n $sha256sumL ]] && [[ -n $2 ]] && [[ $sha256sumL = $2 ]]; then 
  echo "true"
else
  echo "false"
fi
}

fetch_text(){
  local url="$1"
  local content=""
  local jsd_url=""
  if [[ "$url" =~ ^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/(.*)$ ]]; then
    jsd_url="https://fastly.jsdelivr.net/gh/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}@${BASH_REMATCH[3]}/${BASH_REMATCH[4]}"
  fi
  local urls=("$url")
  [[ -n "$jsd_url" ]] && urls=("$jsd_url" "$url")
  local proxies=("" "https://ghproxy.net/" "https://mirror.ghproxy.com/")
  for u in "${urls[@]}"; do
    for p in "${proxies[@]}"; do
      [[ "$u" =~ jsdelivr && -n "$p" ]] && continue
      content=$(curl -fsSL --connect-timeout 6 -m 12 "${p}${u}" 2>/dev/null)
      if [[ -n "$content" ]]; then
        echo "$content"
        return 0
      fi
    done
  done
  return 1
}

fetch_rule(){
  local target="$1"
  local url="$2"
  local expected_sha="$3"
  local min_kb="${4:-10}"
  local tmp="/tmp/dl_$(basename "$target")"
  local jsd_url=""
  if [[ "$url" =~ ^https://raw\.githubusercontent\.com/([^/]+)/([^/]+)/([^/]+)/(.*)$ ]]; then
    jsd_url="https://fastly.jsdelivr.net/gh/${BASH_REMATCH[1]}/${BASH_REMATCH[2]}@${BASH_REMATCH[3]}/${BASH_REMATCH[4]}"
  fi
  local urls=("$url")
  [[ -n "$jsd_url" ]] && urls=("$jsd_url" "$url")
  local proxies=("" "https://ghproxy.net/" "https://mirror.ghproxy.com/")

  for u in "${urls[@]}"; do
    for p in "${proxies[@]}"; do
      [[ "$u" =~ jsdelivr && -n "$p" ]] && continue
      rm -f "$tmp"
      curl -fsSL --connect-timeout 8 --speed-limit 50000 --speed-time 8 -m 60 --retry 1 -o "$tmp" "${p}${u}" 2>/dev/null
      if [[ -s "$tmp" ]]; then
        local sz=$(du -sk "$tmp" 2>/dev/null | awk '{print $1}')
        if [[ -n "$sz" && "$sz" -ge "$min_kb" ]]; then
          if [[ -n "$expected_sha" ]]; then
            local cur_sha=$(sha256sum "$tmp" 2>/dev/null | awk '{print $1}')
            if [[ "$cur_sha" = "$expected_sha" ]]; then
              mv -f "$tmp" "$target"
              return 0
            fi
          else
            mv -f "$tmp" "$target"
            return 0
          fi
        fi
      fi
    done
  done
  rm -f "$tmp"
  return 1
}

branch="${BRANCH:-v2}"

sync_chnroute_rule(){
  local target="$1"
  local rel_path="$2"
  local min_kb="$3"
  local label="$4"
  local primary_base="https://raw.githubusercontent.com/jacyl4/chnroute/main"
  local fallback_base="https://raw.githubusercontent.com/stuinxo/de_GWD/$branch/resource/chnroute"

  local primary_sha fallback_sha
  primary_sha=$(fetch_text "${primary_base}/${rel_path}.sha256sum" | awk '{print$1}')
  if [[ -n "$primary_sha" ]]; then
    [[ $(checkSum "$target" "$primary_sha") = "true" ]] && return 0
    fetch_rule "$target" "${primary_base}/${rel_path}" "$primary_sha" "$min_kb" && return 0
  fi

  if [[ -z "$primary_sha" || ! -s "$target" ]]; then
    fallback_sha=$(fetch_text "${fallback_base}/${rel_path}.sha256sum" | awk '{print$1}')
    if [[ -n "$fallback_sha" ]]; then
      [[ $(checkSum "$target" "$fallback_sha") = "true" ]] && return 0
      fetch_rule "$target" "${fallback_base}/${rel_path}" "$fallback_sha" "$min_kb" && return 0
    elif [[ ! -s "$target" ]]; then
      fetch_rule "$target" "${primary_base}/${rel_path}" "" "$min_kb" && return 0
      fetch_rule "$target" "${fallback_base}/${rel_path}" "" "$min_kb" && return 0
    fi
  fi

  if [[ -s "$target" ]]; then
    echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${WHITE}${label} retained existing${cRES}"
  else
    echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}${label}${RED} Download Failed${cRES}"
  fi
}

geosite_sha256sum=$(fetch_text "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat.sha256sum" | awk '{print$1}')
geoip_sha256sum=$(fetch_text "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/geoip.dat.sha256sum" | awk '{print$1}')

if [[ $(checkSum /opt/de_GWD/.repo/geosite.dat "$geosite_sha256sum") = "false" ]]; then
  if ! fetch_rule "/opt/de_GWD/.repo/geosite.dat" "https://raw.githubusercontent.com/Loyalsoldier/v2ray-rules-dat/release/geosite.dat" "$geosite_sha256sum" 3000; then
    if [[ -s "/opt/de_GWD/.repo/geosite.dat" ]]; then
      echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${WHITE}geosite.dat retained existing${cRES}"
    else
      echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}geosite.dat${RED} Download Failed${cRES}"
    fi
  fi
fi

if [[ $(checkSum /opt/de_GWD/.repo/geoip.dat "$geoip_sha256sum") = "false" ]]; then
  if ! fetch_rule "/opt/de_GWD/.repo/geoip.dat" "https://raw.githubusercontent.com/Loyalsoldier/geoip/release/geoip.dat" "$geoip_sha256sum" 4000; then
    if [[ -s "/opt/de_GWD/.repo/geoip.dat" ]]; then
      echo -e "${WHITE}[ ${YELLOW}! ${WHITE}]\c" && echo -e "\t${WHITE}geoip.dat retained existing${cRES}"
    else
      echo -e "${WHITE}[ ${RED}✕ ${WHITE}]\c" && echo -e "\t${WHITE}geoip.dat${RED} Download Failed${cRES}"
    fi
  fi
fi

sync_chnroute_rule "/opt/de_GWD/.repo/IPchnroute" "IPchnroute" 50 "IPchnroute"
sync_chnroute_rule "/opt/de_GWD/.repo/Domains.chn.txt" "mosdns_chnlist/Domains.chn.txt" 10 "Domains.chn.txt"
sync_chnroute_rule "/opt/de_GWD/.repo/Domains.apple.txt" "mosdns_chnlist/Domains.apple.txt" 5 "Domains.apple.txt"
sync_chnroute_rule "/opt/de_GWD/.repo/Domains.games.txt" "mosdns_chnlist/Domains.games.txt" 5 "Domains.games.txt"
sync_chnroute_rule "/opt/de_GWD/.repo/99-bogus-nxdomain.china.conf" "mosdns_chnlist/99-bogus-nxdomain.china.conf" 1 "bogus-nxdomain.china.conf"

if [[ -f "/opt/de_GWD/.repo/99-bogus-nxdomain.china.conf" ]]; then
  cp -f /opt/de_GWD/.repo/99-bogus-nxdomain.china.conf /etc/dnsmasq.d/
fi

if [[ -f "/opt/de_GWD/.repo/geosite.dat" ]]; then
  cp -f /opt/de_GWD/.repo/geosite.dat /opt/de_GWD/vtrui/geosite.dat
fi

if [[ -f "/opt/de_GWD/.repo/geoip.dat" ]]; then
  cp -f /opt/de_GWD/.repo/geoip.dat /opt/de_GWD/vtrui/geoip.dat
fi

if [[ -s "/opt/de_GWD/.repo/IPchnroute" ]]; then
cp -f /opt/de_GWD/.repo/IPchnroute /opt/de_GWD/nftables/IP_CHNROUTE
sed -i '/^\s*$/d' /opt/de_GWD/nftables/IP_CHNROUTE
if [[ -s "/opt/de_GWD/nftables/IP_CHNROUTE" ]]; then
sed -i 's/$/,/g' /opt/de_GWD/nftables/IP_CHNROUTE
nft flush set ip de_GWD CHNROUTE 2>/dev/null
cat << EOF >/opt/de_GWD/nftables/SET_CHNROUTE.nft
#!/usr/sbin/nft -f
table ip de_GWD {
        set CHNROUTE {
                type ipv4_addr
                flags interval
                auto-merge
                elements = { $(cat /opt/de_GWD/nftables/IP_CHNROUTE) }
        }
}
EOF
chmod +x /opt/de_GWD/nftables/SET_CHNROUTE.nft
/opt/de_GWD/nftables/SET_CHNROUTE.nft
fi
fi

if [[ -f /var/www/ssl/de_GWD.cer ]] && [[ -n $(openssl x509 -enddate -noout -in /var/www/ssl/de_GWD.cer -checkend 259200 2>/dev/null | grep "Certificate will expire") ]] && [[ -d "/root/.acme.sh" ]]; then
  "/root/.acme.sh"/acme.sh --force --set-default-ca --server letsencrypt
  "/root/.acme.sh"/acme.sh --force --cron --home "/root/.acme.sh"

  curDomain=$(jq -r '.FORWARD.domain // .address.serverName // empty' /opt/de_GWD/0conf 2>/dev/null)
  parentDomain=""
  [[ "$curDomain" == *.*.* ]] && parentDomain="${curDomain#*.}"
  sslDir=""
  if [[ -n "$curDomain" && -d "/root/.acme.sh/${curDomain}_ecc" ]]; then
    sslDir="/root/.acme.sh/${curDomain}_ecc"
  elif [[ -n "$parentDomain" && -d "/root/.acme.sh/${parentDomain}_ecc" ]]; then
    sslDir="/root/.acme.sh/${parentDomain}_ecc"
  else
    sslDir=$(ls -dt /root/.acme.sh/*_ecc 2>/dev/null | head -n 1)
  fi

  if [[ -n "$sslDir" && -f "$sslDir/fullchain.cer" ]]; then
    cp -f "$sslDir/fullchain.cer" /var/www/ssl/de_GWD.cer
    keyFile=$(ls "$sslDir"/*.key 2>/dev/null | head -n 1)
    [[ -n "$keyFile" ]] && cp -f "$keyFile" /var/www/ssl/de_GWD.key
    chmod 644 /var/www/ssl/*.key 2>/dev/null || true
    systemctl reload nginx 2>/dev/null || systemctl force-reload nginx 2>/dev/null || true
    systemctl is-active --quiet vtrui1 && systemctl restart vtrui1 2>/dev/null || true
    systemctl is-active --quiet RproxyS && systemctl restart RproxyS 2>/dev/null || true
  fi
fi

[[ $1 = "u" ]] && service cron restart

echo -e "${WHITE}[ ${GREEN}✓ ${WHITE}]\c" && echo -e "\t${WHITE}Update CHN Domain & IP rules${cRES}"
