#!/bin/bash
CFdomain=$(jq -r '.ddns.ddnsCF.cfDomain // empty' /opt/de_GWD/0conf 2>/dev/null)
CFtoken=$(jq -r '.ddns.ddnsCF.cfToken // .ddns.ddnsCF.cfAPIkey // empty' /opt/de_GWD/0conf 2>/dev/null)
[[ -z "$CFdomain" || -z "$CFtoken" ]] && exit 0

wanIP=$(/opt/de_GWD/ui-wanIP_cn)

CFdomainip=$(dig @127.0.0.1 "$CFdomain" -4p 5332 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | head -n 1)
[[ -z "$CFdomainip" ]] && CFdomainip=$(dig "$CFdomain" -4 +short 2>/dev/null | grep -E '^([0-9]{1,3}\.){3}[0-9]{1,3}$' | head -n 1)

if [[ -n "$wanIP" && "$wanIP" != "$CFdomainip" ]]; then
  authHeaders=(-H "Authorization: Bearer $CFtoken" -H "Content-Type: application/json")
  CFtopDomain=$(echo "$CFdomain" | rev | awk -F. '{print $1"."$2}' | rev)

  CFzoneID=$(curl -fsSL -X GET "https://api.cloudflare.com/client/v4/zones?name=$CFtopDomain" "${authHeaders[@]}" 2>/dev/null | jq -r '.result[0].id // empty')
  [[ -z "$CFzoneID" ]] && CFzoneID=$(curl -fsSL -X GET "https://api.cloudflare.com/client/v4/zones" "${authHeaders[@]}" 2>/dev/null | jq --arg d "$CFdomain" -r '.result[] | select($d == .name or ($d | endswith("." + .name))) | .id' | head -n 1)

  if [[ -n "$CFzoneID" ]]; then
    CFrecordID=$(curl -fsSL -X GET "https://api.cloudflare.com/client/v4/zones/$CFzoneID/dns_records?type=A&name=$CFdomain" "${authHeaders[@]}" 2>/dev/null | jq --arg CFdomain "$CFdomain" -r '.result[] | select(.name == $CFdomain).id' | head -n 1)
    payload=$(jq -nc --arg name "$CFdomain" --arg content "$wanIP" '{type:"A",name:$name,content:$content,ttl:1,proxied:false}')
    if [[ -n "$CFrecordID" ]]; then
      curl -fsSL -X PUT "https://api.cloudflare.com/client/v4/zones/$CFzoneID/dns_records/$CFrecordID" \
           "${authHeaders[@]}" --data "$payload" >/dev/null 2>&1
    else
      curl -fsSL -X POST "https://api.cloudflare.com/client/v4/zones/$CFzoneID/dns_records" \
           "${authHeaders[@]}" --data "$payload" >/dev/null 2>&1
    fi
  fi
fi
