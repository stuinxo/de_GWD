#!/bin/bash
set -e
cd "$(dirname "$0")"

calc_sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

targets=(
  "./de_GWD_amd64.zip"
  "./de_GWD_arm64.zip"
  "./resource/client/Archive.zip"
  "./resource/server/sample.zip"
  "./resource/doh/doh_s_amd64"
  "./resource/doh/doh_s_arm64"
  "./resource/nginx/nginx_amd64"
  "./resource/nginx/nginx_arm64"
  "./resource/nginx/nginxConf.zip"
  "./resource/geodata/geodata.zip"
  "./resource/chnroute/IPchnroute"
  "./resource/chnroute/mosdns_chnlist/99-bogus-nxdomain.china.conf"
  "./resource/chnroute/mosdns_chnlist/Domains.apple.txt"
  "./resource/chnroute/mosdns_chnlist/Domains.chn.txt"
  "./resource/chnroute/mosdns_chnlist/Domains.games.txt"
)

for f in "${targets[@]}"; do
  if [[ -f "$f" ]]; then
    calc_sha256 "$f" | tee "${f}.sha256sum"
  fi
done
